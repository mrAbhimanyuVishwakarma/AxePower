<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Backgrounds -->
    <Color x:Key="WindowBackgroundColor">#F1F5F9</Color>
    <Color x:Key="WindowSecondaryBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SidebarBackgroundColor">#FFFFFF</Color>
    <Color x:Key="TitleBarBackgroundColor">#F1F5F9</Color>
    
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowSecondaryBackgroundBrush" Color="{StaticResource WindowSecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource TitleBarBackgroundColor}" />
    
    <!-- Surfaces -->
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ElevatedCardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="HoverSurfaceColor">#E2E8F0</Color>

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="ElevatedCardBackgroundBrush" Color="{StaticResource ElevatedCardBackgroundColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="CtaButtonBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="CtaButtonForegroundBrush" Color="#FFFFFF" />
    
    <!-- Borders -->
    <Color x:Key="CardBorderColor">#E2E8F0</Color>
    <Color x:Key="DividerColor">#E2E8F0</Color>

    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <!-- Cards cast no shadow outside the Glass theme -->
    <x:Null x:Key="CardShadowEffect" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#666666" />

    <!-- Accents -->
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="FocusBrush" Color="#2563EB" />

    <!-- Semantic Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />

    <SolidColorBrush x:Key="EcoBrush" Color="#059669" />
    <SolidColorBrush x:Key="SmartBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="BeastBrush" Color="#EA580C" />

    <!-- Light Mode Taskbar Context Menu Theme -->
    <SolidColorBrush x:Key="TrayMenuBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TrayMenuBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="TrayMenuForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="TrayMenuHoverBackgroundBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="TrayMenuHoverForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="TrayMenuSeparatorBrush" Color="#E2E8F0" />

    <!-- App Logo Icon -->
    <BitmapImage x:Key="AppIconImage" UriSource="/Resources/AxePower_black.ico" />

    <!-- AxePower Music -->
    <SolidColorBrush x:Key="MusicAccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="MusicGlassSurfaceBrush" Color="#EBFFFFFF" />
    <SolidColorBrush x:Key="MusicTrackBrush" Color="#26000000" />
    <SolidColorBrush x:Key="MusicPlayGlyphBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="MusicPlaceholderArtBrush" StartPoint="1,0" EndPoint="0,1">
        <GradientStop Color="#3B82F6" Offset="0" />
        <GradientStop Color="#7C5CE6" Offset="0.55" />
        <GradientStop Color="#EC4899" Offset="1" />
    </LinearGradientBrush>

    <!-- Share Screen stage. A video surface stays dark in every theme: letterbox bars around a
         16:9 stream should recede, not glow, and the controls sit on top of moving picture. -->
    <SolidColorBrush x:Key="ShareStageBackgroundBrush" Color="#0A0B0D" />
    <SolidColorBrush x:Key="ShareTileBackgroundBrush" Color="#16181C" />
    <SolidColorBrush x:Key="ShareTileBorderBrush" Color="#2A2E37" />
    <SolidColorBrush x:Key="ShareControlBarBrush" Color="#F21E2129" />
    <SolidColorBrush x:Key="ShareControlButtonBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ShareControlButtonHoverBrush" Color="#52FFFFFF" />
    <SolidColorBrush x:Key="ShareControlForegroundBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="ShareControlMutedBrush" Color="#9BA3AF" />
    <SolidColorBrush x:Key="ShareNamePillBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="ShareDangerBrush" Color="#DA373C" />
    <SolidColorBrush x:Key="ShareDangerHoverBrush" Color="#B02B2F" />
    <SolidColorBrush x:Key="ShareLiveBrush" Color="#23A55A" />

</ResourceDictionary>
