<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\AxePower_white.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.7.0</Version>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
    <InformationalVersion>1.7.0</InformationalVersion>
    <Authors>Abhimanyu Vishwakarma</Authors>
    <Company>AxePower</Company>
    <Product>AxePower</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxePower.Core\AxePower.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AxePower_white.ico" />
    <Resource Include="Resources\logo.png" />
    <Resource Include="Resources\banner.png" />
    <Resource Include="Resources\icon_saver.png" />
    <Resource Include="Resources\icon_beast.png" />
    <Resource Include="Resources\icon_smart.png" />
    <Resource Include="Resources\Gamemode.png" />
    <Resource Include="Resources\Gamemode2.png" />
    <Resource Include="Resources\xbox-controller.png" />
    <Resource Include="Resources\ps5-controller.png" />
    <Resource Include="Resources\icons\*.png" />
    <Resource Include="Resources\Posters\*.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

</Project>
