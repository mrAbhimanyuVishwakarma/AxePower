    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\AxePower_white.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxePower.Core\AxePower.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AxePower_white.ico" />
    <Resource Include="Resources\logo.png" />
    <Resource Include="Resources\banner.png" />
    <Resource Include="Resources\icon_saver.png" />
    <Resource Include="Resources\icon_beast.png" />
    <Resource Include="Resources\icon_smart.png" />
    <Resource Include="Resources\Gamemode2.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

</Project>
