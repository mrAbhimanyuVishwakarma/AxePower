<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>


    <UseWPF>true</UseWPF>
    <!-- Ship as AxePower.exe; the project/namespace stay AxePower.App -->
    <AssemblyName>AxePower</AssemblyName>
    <RootNamespace>AxePower.App</RootNamespace>
    <ApplicationIcon>Resources\AxePower_white.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>


    <AssemblyTitle>AxePower</AssemblyTitle>
    <Description>AxePower</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxePower.Core\AxePower.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AxePower.Tests" />
  </ItemGroup>

  <!-- Third-party licenses must travel with every copy of the app, including portable builds
       and zips, not only the installer. The in-app Privacy Policy points users to this file. -->
  <ItemGroup>
    <None Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Skins that ship next to AxePower.exe (skins\<id>\skin.json). Only the ones listed here are
       packaged; other folders in the repo's skins\ stay out of the installer. A folder someone adds
       to the installed skins\ appears in Settings → Theme. -->
  <ItemGroup>
    <!-- One item per folder: LinkBase keeps only the part under "**", so each needs its own base -->
    <None Include="..\skins\README.md" LinkBase="skins" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\_template\**\*" LinkBase="skins\_template" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\dark\**\*" LinkBase="skins\dark" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\light\**\*" LinkBase="skins\light" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\glass\**\*" LinkBase="skins\glass" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\deep-obsidian-glass\**\*" LinkBase="skins\deep-obsidian-glass" CopyToOutputDirectory="PreserveNewest" />
    <!-- The 2.0.7 set -->
    <None Include="..\skins\midnight-sakura\**\*" LinkBase="skins\midnight-sakura" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\synthwave-sunset\**\*" LinkBase="skins\synthwave-sunset" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\molten-lava\**\*" LinkBase="skins\molten-lava" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\deep-ocean\**\*" LinkBase="skins\deep-ocean" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\matrix-terminal\**\*" LinkBase="skins\matrix-terminal" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\paper-and-ink\**\*" LinkBase="skins\paper-and-ink" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\mint-latte\**\*" LinkBase="skins\mint-latte" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\aurora-glass\**\*" LinkBase="skins\aurora-glass" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\frosted-rose-glass\**\*" LinkBase="skins\frosted-rose-glass" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\high-contrast\**\*" LinkBase="skins\high-contrast" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\vampire-night\**\*" LinkBase="skins\vampire-night" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\polar-night\**\*" LinkBase="skins\polar-night" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\mocha-pastel\**\*" LinkBase="skins\mocha-pastel" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\retro-groove\**\*" LinkBase="skins\retro-groove" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\neon-tokyo\**\*" LinkBase="skins\neon-tokyo" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\solar-cream\**\*" LinkBase="skins\solar-cream" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\one-midnight\**\*" LinkBase="skins\one-midnight" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\dusky-rose\**\*" LinkBase="skins\dusky-rose" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\spice-market\**\*" LinkBase="skins\spice-market" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\clean-slate\**\*" LinkBase="skins\clean-slate" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\stealth-ops\**\*" LinkBase="skins\stealth-ops" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\esports-red\**\*" LinkBase="skins\esports-red" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\neon-city\**\*" LinkBase="skins\neon-city" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\glacier-night\**\*" LinkBase="skins\glacier-night" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\toxic-green\**\*" LinkBase="skins\toxic-green" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\royal-gold\**\*" LinkBase="skins\royal-gold" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\blood-moon\**\*" LinkBase="skins\blood-moon" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\arcade\**\*" LinkBase="skins\arcade" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\carbon-fibre\**\*" LinkBase="skins\carbon-fibre" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\skins\plasma-glass\**\*" LinkBase="skins\plasma-glass" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AxePower_white.ico" />
    <Resource Include="Resources\AxePower_black.ico" />
    <Resource Include="Resources\logo.png" />
    <Resource Include="Resources\banner.png" />
    <Resource Include="Resources\icon_saver.png" />
    <Resource Include="Resources\icon_beast.png" />
    <Resource Include="Resources\icon_smart.png" />
    <Resource Include="Resources\Gamemode.png" />
    <Resource Include="Resources\Gamemode2.png" />
    <Resource Include="Resources\xbox-controller.png" />
    <Resource Include="Resources\ps5-controller.png" />
    <Resource Include="Resources\icons\*.png" />
    <Resource Include="Resources\Posters\*.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
  </ItemGroup>

</Project>
