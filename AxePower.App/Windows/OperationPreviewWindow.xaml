<Window x:Class="AxePower.App.Windows.OperationPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="600" Width="760" MinHeight="380" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStyle="ToolWindow" ResizeMode="CanResize">
    <!-- Nothing is changed until Approve. Every step shows its value now and the value it will get. -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Operations}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Action}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,12,0"/>
                                        <Border Grid.Column="1" Style="{StaticResource ReversibilityBadgeBorder}">
                                            <TextBlock Text="{Binding ReversibilityLabel}" Style="{StaticResource ReversibilityBadgeText}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="{Binding Source, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AdminText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ReversibilityExplanation}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                                            Visibility="{Binding Notice, Converter={StaticResource NotNullToVis}}">
                                        <TextBlock Text="{Binding Notice}" FontSize="12" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource OperationStepTemplate}" Focusable="False"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{DynamicResource SecondaryButtonStyle}" Content="Cancel" Click="Cancel_Click" Padding="22,8" Margin="0,0,12,0" IsCancel="True"/>
                <Button Style="{DynamicResource PrimaryButtonStyle}" Content="{Binding ApproveText}" Click="Approve_Click" Padding="22,8"
                        IsEnabled="{Binding HasChanges}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
