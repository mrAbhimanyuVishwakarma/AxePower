<Window x:Class="AxePower.App.Windows.CountdownConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AxePower" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        xmlns:a11y="clr-namespace:AxePower.App.Helpers"
        a11y:AccessibleNames.Enabled="True">
    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="24" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="38" Height="38" CornerRadius="10" Background="#1AF59E0B" Margin="0,0,14,0">
                    <TextBlock x:Name="IconGlyph" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#F59E0B"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12.5" LineHeight="19"
                       TextWrapping="Wrap" Margin="0,0,0,14"/>

            <TextBlock x:Name="CountdownText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" Margin="0,0,0,18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{DynamicResource SecondaryButtonStyle}" Padding="18,8" Margin="0,0,10,0"
                        Click="OnCancel" IsCancel="True"/>
                <Button x:Name="ConfirmButton" Style="{DynamicResource PrimaryButtonStyle}" Padding="18,8" Click="OnConfirm"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
