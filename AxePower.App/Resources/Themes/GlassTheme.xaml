<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Backgrounds: black glass. Windows 11 dark Acrylic is grey on its own, so a black tint
         sits over it; the blur still shows through. -->
    <Color x:Key="WindowBackgroundColor">#A6000000</Color>
    <Color x:Key="WindowSecondaryBackgroundColor">#33000000</Color>
    <Color x:Key="SidebarBackgroundColor">#40000000</Color>
    <Color x:Key="TitleBarBackgroundColor">#00000000</Color>
    
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowSecondaryBackgroundBrush" Color="{StaticResource WindowSecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource TitleBarBackgroundColor}" />
    
    <!-- Surfaces (Frosted Glass Translucent Panels) -->
    <Color x:Key="CardBackgroundColor">#59050506</Color>
    <Color x:Key="ElevatedCardBackgroundColor">#6B08090B</Color>
    <Color x:Key="HoverSurfaceColor">#7A15171C</Color>

    <!-- Glass: every card surface carries the music player's sheen, brightest at the top-left
         with a crisp diagonal edge, at half strength so black glass stays black -->
    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="0.9,0.65">
        <GradientStop Color="#66363637" Offset="0" />
        <GradientStop Color="#5E181819" Offset="0.44" />
        <GradientStop Color="#5A0B0B0C" Offset="0.45" />
        <GradientStop Color="#59050506" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ElevatedCardBackgroundBrush" StartPoint="0,0" EndPoint="0.9,0.65">
        <GradientStop Color="#77323234" Offset="0" />
        <GradientStop Color="#6F18191A" Offset="0.44" />
        <GradientStop Color="#6C0D0E10" Offset="0.45" />
        <GradientStop Color="#6B08090B" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="CtaButtonBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CtaButtonForegroundBrush" Color="#090A0D" />
    
    <!-- Borders (Subtle Specular Edge Highlights) -->
    <Color x:Key="CardBorderColor">#2CFFFFFF</Color>
    <Color x:Key="DividerColor">#1CFFFFFF</Color>

    <!-- Lit rim, brightest at the top-left, as on the music player -->
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#0FFFFFFF" Offset="0.6" />
        <GradientStop Color="#1AFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Soft drop shadow under cards that use CardStyle / CardElevatedStyle; the other themes have none -->
    <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#000000" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <!-- Text (High Contrast on Glass) -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#64748B" />

    <!-- Accents -->
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7DD3FC" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="FocusBrush" Color="#38BDF8" />

    <!-- Semantic Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />

    <SolidColorBrush x:Key="EcoBrush" Color="#34D399" />
    <SolidColorBrush x:Key="SmartBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="BeastBrush" Color="#FB923C" />

    <!-- Steam Taskbar Context Menu Theme -->
    <SolidColorBrush x:Key="TrayMenuBackgroundBrush" Color="#3D4450" />
    <SolidColorBrush x:Key="TrayMenuBorderBrush" Color="#282828" />
    <SolidColorBrush x:Key="TrayMenuForegroundBrush" Color="#DCDEDF" />
    <SolidColorBrush x:Key="TrayMenuHoverBackgroundBrush" Color="#DCDEDF" />
    <SolidColorBrush x:Key="TrayMenuHoverForegroundBrush" Color="#1E2228" />
    <SolidColorBrush x:Key="TrayMenuSeparatorBrush" Color="#5E6063" />

    <BitmapImage x:Key="AppIconImage" UriSource="/Resources/AxePower_white.ico" />

    <!-- AxePower Music -->
    <SolidColorBrush x:Key="MusicAccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="MusicGlassSurfaceBrush" Color="#8008090B" />
    <SolidColorBrush x:Key="MusicTrackBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="MusicPlayGlyphBrush" Color="#0B1220" />
    <LinearGradientBrush x:Key="MusicPlaceholderArtBrush" StartPoint="1,0" EndPoint="0,1">
        <GradientStop Color="#38BDF8" Offset="0" />
        <GradientStop Color="#7C5CE6" Offset="0.55" />
        <GradientStop Color="#EC4899" Offset="1" />
    </LinearGradientBrush>

    <!-- Share Screen stage. A video surface stays dark in every theme: letterbox bars around a
         16:9 stream should recede, not glow, and the controls sit on top of moving picture. -->
    <SolidColorBrush x:Key="ShareStageBackgroundBrush" Color="#0A0B0D" />
    <SolidColorBrush x:Key="ShareTileBackgroundBrush" Color="#16181C" />
    <SolidColorBrush x:Key="ShareTileBorderBrush" Color="#2A2E37" />
    <SolidColorBrush x:Key="ShareControlBarBrush" Color="#F21E2129" />
    <SolidColorBrush x:Key="ShareControlButtonBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ShareControlButtonHoverBrush" Color="#52FFFFFF" />
    <SolidColorBrush x:Key="ShareControlForegroundBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="ShareControlMutedBrush" Color="#9BA3AF" />
    <SolidColorBrush x:Key="ShareNamePillBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="ShareDangerBrush" Color="#DA373C" />
    <SolidColorBrush x:Key="ShareDangerHoverBrush" Color="#B02B2F" />
    <SolidColorBrush x:Key="ShareLiveBrush" Color="#23A55A" />

</ResourceDictionary>
