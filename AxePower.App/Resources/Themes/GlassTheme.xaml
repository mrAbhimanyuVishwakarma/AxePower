<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Backgrounds (Transparent for Native Windows Acrylic/Glass) -->
    <Color x:Key="WindowBackgroundColor">#00000000</Color>
    <Color x:Key="WindowSecondaryBackgroundColor">#200B1017</Color>
    <Color x:Key="SidebarBackgroundColor">#2A0B1017</Color>
    <Color x:Key="TitleBarBackgroundColor">#00000000</Color>
    
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowSecondaryBackgroundBrush" Color="{StaticResource WindowSecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource TitleBarBackgroundColor}" />
    
    <!-- Surfaces (Frosted Glass Translucent Panels) -->
    <Color x:Key="CardBackgroundColor">#2C111827</Color>
    <Color x:Key="ElevatedCardBackgroundColor">#3D162032</Color>
    <Color x:Key="HoverSurfaceColor">#551E2B42</Color>

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="ElevatedCardBackgroundBrush" Color="{StaticResource ElevatedCardBackgroundColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="CtaButtonBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CtaButtonForegroundBrush" Color="#090A0D" />
    
    <!-- Borders (Subtle Specular Edge Highlights) -->
    <Color x:Key="CardBorderColor">#2CFFFFFF</Color>
    <Color x:Key="DividerColor">#1CFFFFFF</Color>

    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <!-- Text (High Contrast on Glass) -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#64748B" />

    <!-- Accents -->
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7DD3FC" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="FocusBrush" Color="#38BDF8" />

    <!-- Semantic Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />

    <SolidColorBrush x:Key="EcoBrush" Color="#34D399" />
    <SolidColorBrush x:Key="SmartBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="BeastBrush" Color="#FB923C" />

    <!-- Steam Taskbar Context Menu Theme -->
    <SolidColorBrush x:Key="TrayMenuBackgroundBrush" Color="#3D4450" />
    <SolidColorBrush x:Key="TrayMenuBorderBrush" Color="#282828" />
    <SolidColorBrush x:Key="TrayMenuForegroundBrush" Color="#DCDEDF" />
    <SolidColorBrush x:Key="TrayMenuHoverBackgroundBrush" Color="#DCDEDF" />
    <SolidColorBrush x:Key="TrayMenuHoverForegroundBrush" Color="#1E2228" />
    <SolidColorBrush x:Key="TrayMenuSeparatorBrush" Color="#5E6063" />

    <BitmapImage x:Key="AppIconImage" UriSource="/Resources/AxePower_white.ico" />

    <!-- AxePower Music -->
    <SolidColorBrush x:Key="MusicAccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="MusicGlassSurfaceBrush" Color="#59162032" />
    <SolidColorBrush x:Key="MusicTrackBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="MusicPlayGlyphBrush" Color="#0B1220" />
    <LinearGradientBrush x:Key="MusicPlaceholderArtBrush" StartPoint="1,0" EndPoint="0,1">
        <GradientStop Color="#38BDF8" Offset="0" />
        <GradientStop Color="#7C5CE6" Offset="0.55" />
        <GradientStop Color="#EC4899" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
