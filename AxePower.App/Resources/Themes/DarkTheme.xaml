<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Backgrounds -->
    <Color x:Key="WindowBackgroundColor">#090A0D</Color>
    <Color x:Key="WindowSecondaryBackgroundColor">#0E1015</Color>
    <Color x:Key="SidebarBackgroundColor">#0F1117</Color>
    <Color x:Key="TitleBarBackgroundColor">#090A0D</Color>
    
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowSecondaryBackgroundBrush" Color="{StaticResource WindowSecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource TitleBarBackgroundColor}" />
    
    <!-- Surfaces -->
    <Color x:Key="CardBackgroundColor">#14161C</Color>
    <Color x:Key="ElevatedCardBackgroundColor">#1A1C23</Color>
    <Color x:Key="HoverSurfaceColor">#20232B</Color>

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="ElevatedCardBackgroundBrush" Color="{StaticResource ElevatedCardBackgroundColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource HoverSurfaceColor}" />
    
    <!-- Borders -->
    <Color x:Key="CardBorderColor">#2A2D35</Color>
    <Color x:Key="DividerColor">#21232B</Color>

    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#4B5563" />

    <!-- Accents -->
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="FocusBrush" Color="#3B82F6" />

    <!-- Semantic Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444" />

    <SolidColorBrush x:Key="EcoBrush" Color="#10B981" />
    <SolidColorBrush x:Key="SmartBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="BeastBrush" Color="#F97316" />

</ResourceDictionary>
