<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Backgrounds (Fully Transparent) -->
    <Color x:Key="WindowBackgroundColor">#00000000</Color>
    <Color x:Key="WindowSecondaryBackgroundColor">#05FFFFFF</Color>
    <Color x:Key="SidebarBackgroundColor">#10FFFFFF</Color>
    <Color x:Key="TitleBarBackgroundColor">#00000000</Color>
    
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowSecondaryBackgroundBrush" Color="{StaticResource WindowSecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource TitleBarBackgroundColor}" />
    
    <!-- Surfaces -->
    <Color x:Key="CardBackgroundColor">#10FFFFFF</Color>
    <Color x:Key="ElevatedCardBackgroundColor">#15FFFFFF</Color>
    <Color x:Key="HoverSurfaceColor">#20FFFFFF</Color>

    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="ElevatedCardBackgroundBrush" Color="{StaticResource ElevatedCardBackgroundColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource HoverSurfaceColor}" />
    
    <!-- Borders -->
    <Color x:Key="CardBorderColor">#15FFFFFF</Color>
    <Color x:Key="DividerColor">#10FFFFFF</Color>

    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6B7280" />

    <!-- Accents -->
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="FocusBrush" Color="#60A5FA" />

    <!-- Semantic Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />

    <SolidColorBrush x:Key="EcoBrush" Color="#34D399" />
    <SolidColorBrush x:Key="SmartBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="BeastBrush" Color="#FB923C" />

</ResourceDictionary>
