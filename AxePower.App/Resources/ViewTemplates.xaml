<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewmodels="clr-namespace:AxePower.App.ViewModels"
                    xmlns:views="clr-namespace:AxePower.App.Views"
                    xmlns:musicvm="clr-namespace:AxePower.App.ViewModels.Music"
                    xmlns:musicviews="clr-namespace:AxePower.App.Views.Music"
                    xmlns:sharevm="clr-namespace:AxePower.App.ViewModels.ShareScreen"
                    xmlns:shareviews="clr-namespace:AxePower.App.Views.ShareScreen"
                    xmlns:helpers="clr-namespace:AxePower.App.Helpers">
    <!-- Which view shows each page view model in MainWindow's content area. Moved out of
         MainWindow.xaml unchanged (Prompt 20). -->
    <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>
    <!-- Built once and reused: rebuilding Game Mode took 134 ms on every visit (Prompt 29) -->
    <DataTemplate DataType="{x:Type viewmodels:GameModeViewModel}">
        <helpers:CachedView ViewType="{x:Type views:GameModeView}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:BatteryViewModel}">
        <views:BatteryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:TrustViewModel}">
        <views:TrustView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:LogsViewModel}">
        <views:LogsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:AboutViewModel}">
        <views:AboutView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:UninstallerViewModel}">
        <views:UninstallerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:SystemOptimizerViewModel}">
        <views:SystemOptimizerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:SystemDoctorViewModel}">
        <views:SystemDoctorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:SystemCareViewModel}">
        <views:SystemCareView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:TerminalViewModel}">
        <views:TerminalView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:ToolsViewModel}">
        <views:ToolsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:RoutinesViewModel}">
        <views:RoutinesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:SoftwareHubViewModel}">
        <views:SoftwareHubView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:DebloatViewModel}">
        <views:DebloatView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:PhoneHubViewModel}">
        <views:PhoneHubView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:LanDropViewModel}">
        <views:LanDropView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type musicvm:MusicViewModel}">
        <musicviews:MusicView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sharevm:ShareScreenViewModel}">
        <shareviews:ShareScreenView />
    </DataTemplate>
</ResourceDictionary>
