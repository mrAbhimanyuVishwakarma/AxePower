
<Window x:Class="AxePower.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:AxePower.App.ViewModels"
        xmlns:views="clr-namespace:AxePower.App.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:converters="clr-namespace:AxePower.App.Converters"
        xmlns:musicvm="clr-namespace:AxePower.App.ViewModels.Music"
        xmlns:musicviews="clr-namespace:AxePower.App.Views.Music"
        xmlns:sharevm="clr-namespace:AxePower.App.ViewModels.ShareScreen"
        xmlns:shareviews="clr-namespace:AxePower.App.Views.ShareScreen"
        mc:Ignorable="d"
        Title="AxePower" Height="840" Width="1280" MinWidth="1024" MinHeight="760"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="{DynamicResource AppIconImage}"
        Topmost="{Binding DashboardVm.IsWindowTopmost}">
        
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="112" GlassFrameThickness="0" CornerRadius="8" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:GameModeViewModel}">
            <views:GameModeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BatteryViewModel}">
            <views:BatteryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:UninstallerViewModel}">
            <views:UninstallerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SystemOptimizerViewModel}">
            <views:SystemOptimizerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SystemDoctorViewModel}">
            <views:SystemDoctorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TerminalViewModel}">
            <views:TerminalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SoftwareHubViewModel}">
            <views:SoftwareHubView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PhoneHubViewModel}">
            <views:PhoneHubView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LanDropViewModel}">
            <views:LanDropView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type musicvm:MusicViewModel}">
            <musicviews:MusicView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sharevm:ShareScreenViewModel}">
            <shareviews:ShareScreenView />
        </DataTemplate>
        
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Subtle Glow Effects -->
        <Ellipse Width="800" Height="800" Margin="-200,-300,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.1" IsHitTestVisible="False"
                 Visibility="{Binding DashboardVm.IsShrunk, Converter={StaticResource InverseBoolToVis}}">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1A4A8A" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Visibility="{Binding DashboardVm.IsShrunk, Converter={StaticResource InverseBoolToVis}}"
                    Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <!-- 240 px, or a 72 px icon rail (MainViewModel.IsSidebarCollapsed) -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="240"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="72"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Branding -->
                    <Grid Grid.Row="0" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Top">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="28,20,10,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="Margin" Value="15,20,15,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Collapsed, the logo is the way back out; expanded it is only the logo -->
                        <Button Grid.Column="0" Command="{Binding ToggleSidebarCommand}" IsEnabled="{Binding IsSidebarCollapsed}"
                                AutomationProperties.Name="Expand the sidebar">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Cursor" Value="Arrow"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="ToolTip" Value="Expand the sidebar"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="{DynamicResource AppIconImage}" Width="42" Height="42" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="AxePower" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" Margin="12,0,0,0"
                                   Style="{StaticResource SidebarLabelStyle}"/>
                        <Button Grid.Column="2" Style="{StaticResource MusicIconButtonStyle}" Width="28" Height="28" FontSize="11"
                                Content="&#xE892;" Command="{Binding ToggleSidebarCommand}" VerticalAlignment="Center"
                                ToolTip="Collapse the sidebar to icons" AutomationProperties.Name="Collapse the sidebar"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                    
                    <!-- Navigation groups. No scroll viewer: every item is sized to fit the sidebar outright, and the
                         window's MinHeight is set so the list can never be squeezed shorter than it needs. -->
                    <StackPanel Grid.Row="1" Margin="0,2,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <!-- 1. CONTROL GROUP -->
                            <TextBlock Text="CONTROL" Style="{StaticResource SidebarGroupHeaderTextStyle}" />
                            <Border Style="{StaticResource SidebarRailDividerStyle}"/>

                            <!-- Dashboard -->
                            <Button Style="{Binding DashboardActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" ToolTip="Dashboard: choose your power mode" AutomationProperties.Name="Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="18" Height="18" Margin="0,0,14,0" VerticalAlignment="Center"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="/Resources/icons/Dashboards.png" Stretch="Uniform"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="Dashboard" Style="{StaticResource SidebarLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- Game Mode -->
                            <Button Style="{Binding GameModeActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="GameMode" ToolTip="Game Mode: your games and Game Mode" AutomationProperties.Name="Game Mode">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="18" Height="18" Margin="0,0,14,0" VerticalAlignment="Center"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="/Resources/icons/controller.png" Stretch="Uniform"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="Game Mode" Style="{StaticResource SidebarLabelStyle}"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Battery -->
                            <Button Style="{Binding BatteryActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Battery" ToolTip="Battery: health, history and charging" AutomationProperties.Name="Battery">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="18" Height="18" Margin="0,0,14,0" VerticalAlignment="Center"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="/Resources/icons/battery.png" Stretch="Uniform"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="Battery" Style="{StaticResource SidebarLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- Music -->
                            <Button Style="{Binding MusicActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Music"
                                    ToolTip="Music: play your music files" AutomationProperties.Name="Music">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Music" Style="{StaticResource SidebarLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. CONNECTION GROUP -->
                            <TextBlock Text="CONNECTION" Style="{StaticResource SidebarGroupHeaderTextStyle}" Margin="20,10,20,3"/>
                            <Border Style="{StaticResource SidebarRailDividerStyle}"/>

                            <!-- Share Screen -->
                            <Button Style="{Binding ShareScreenActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="ShareScreen" ToolTip="Share Screen: stream a display to friends in their browser, like Discord" AutomationProperties.Name="Share Screen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Share Screen" Style="{StaticResource SidebarLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- Phone Control -->
                            <Button Style="{Binding PhoneHubActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="PhoneHub" ToolTip="Phone Control: Screen mirroring, Wi-Fi LAN drop &amp; remote tools">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Phone Control" Style="{StaticResource SidebarLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- Second Monitor -->
                            <Button Style="{Binding SecondMonitorActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="SecondMonitor" ToolTip="Second Monitor: SpaceDesk wireless display for phone, tablet &amp; laptop">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Second Monitor" Style="{StaticResource SidebarLabelStyle}"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. MAINTENANCE GROUP (Collapsible) -->
                            <Border Style="{StaticResource SidebarRailDividerStyle}"/>
                            <Button Style="{StaticResource SidebarExpanderHeaderButtonStyle}" Command="{Binding ToggleMaintenanceGroupCommand}" Margin="10,8,10,2">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MAINTENANCE" FontFamily="{StaticResource PrimaryFontFamily}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MaintenanceChevronGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Maintenance Sub-items -->
                            <StackPanel Visibility="{Binding ShowMaintenanceItems, Converter={StaticResource BoolToVis}}">
                                <!-- Optimizer -->
                                <Button Style="{Binding OptimizerActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Optimizer" ToolTip="Optimizer: safe Windows debloat, telemetry removal and gamer optimizations">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Optimizer" Style="{StaticResource SidebarLabelStyle}"/>
                                    </StackPanel>
                                </Button>

                                <!-- Doctor -->
                                <Button Style="{Binding DoctorActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Doctor" ToolTip="Doctor: Windows health repair (SFC/DISM), shader cache cleaner and DNS benchmark">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Doctor" Style="{StaticResource SidebarLabelStyle}"/>
                                    </StackPanel>
                                </Button>

                                <!-- Terminal -->
                                <Button Style="{Binding TerminalActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Terminal" ToolTip="Terminal: built-in CMD / PowerShell, where AxePower's commands report">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Terminal" Style="{StaticResource SidebarLabelStyle}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 4. UTILITIES GROUP (Collapsible) -->
                            <Border Style="{StaticResource SidebarRailDividerStyle}"/>
                            <Button Style="{StaticResource SidebarExpanderHeaderButtonStyle}" Command="{Binding ToggleUtilitiesGroupCommand}" Margin="10,8,10,2">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="UTILITIES" FontFamily="{StaticResource PrimaryFontFamily}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding UtilitiesChevronGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Utilities Sub-items -->
                            <StackPanel Visibility="{Binding ShowUtilitiesItems, Converter={StaticResource BoolToVis}}">
                                <!-- MSI Afterburner -->
                                <Button Style="{StaticResource SidebarSubItemButtonStyle}" Command="{Binding OpenMsiAfterburnerCommand}" ToolTip="MSI Afterburner: open it with hardware monitoring">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="/Resources/icons/MSI Afterburner.png" Stretch="Uniform"/>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock Text="MSI Afterburner" Style="{StaticResource SidebarLabelStyle}"/>
                                    </StackPanel>
                                </Button>

                                <!-- Uninstaller Pro -->
                                <Button Style="{Binding UninstallerActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Uninstaller" ToolTip="Uninstaller Pro: remove applications and clean verified leftovers">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Uninstaller Pro" Style="{StaticResource SidebarLabelStyle}"/>
                                    </StackPanel>
                                </Button>

                                <!-- Update PC -->
                                <Button Style="{Binding UpdatePcActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="UpdatePc" ToolTip="Update PC: drivers, WinGet batch upgrade and Windows Update">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Update PC" Style="{StaticResource SidebarLabelStyle}"/>
                                    </StackPanel>
                                </Button>

                                <!-- Debloat -->
                                <Button Style="{StaticResource SidebarSubItemButtonStyle}" Command="{Binding DebloatCommand}" ToolTip="Debloat: launch Win11Debloat by Raphire">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Debloat" Style="{StaticResource SidebarLabelStyle}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                    </StackPanel>

                    <!-- Bottom Fixed Navigation (Settings & About) -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,10" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Divider -->
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="20,0,20,6" Opacity="0.4"/>

                        <!-- Settings (Above About) -->
                        <Button Style="{Binding SettingsActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings" ToolTip="Settings" AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <!-- About (Bottom of the list) -->
                        <Button Style="{Binding AboutActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="About" ToolTip="About AxePower and updates" AutomationProperties.Name="About">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Text="About" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Title Bar Region -->
            <!-- Tall only while the battery pill shows; MainWindow.xaml.cs keeps CaptionHeight in step -->
            <Grid x:Name="TitleBar" Grid.Row="0" Grid.Column="1"
                  Visibility="{Binding DashboardVm.IsShrunk, Converter={StaticResource InverseBoolToVis}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Height" Value="44"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowBatteryPill}" Value="True">
                                <Setter Property="Height" Value="112"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- Battery Status Pill (3x Large Prominent Size: Live outline battery + percentage + power status) -->
                <Border x:Name="BatteryPill" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,0" Padding="24,14" CornerRadius="16" DataContext="{Binding BatteryVm}" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="{Binding DataContext.ShowBatteryPill, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Battery Icon with Live Level Fill (3x Size) -->
                        <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                            <!-- Outer Battery Body -->
                            <Border Width="68" Height="32" CornerRadius="7" BorderBrush="{Binding HeaderAccentBrush}" BorderThickness="3.5" Background="Transparent" Padding="3">
                                <!-- Inner Charge Bar -->
                                <Border HorizontalAlignment="Left" Width="{Binding BatteryFillWidth}" CornerRadius="3" Background="{Binding HeaderAccentBrush}"/>
                            </Border>
                            <!-- Battery Positive Tip -->
                            <Border Width="5" Height="14" CornerRadius="0,3.5,3.5,0" Background="{Binding HeaderAccentBrush}" HorizontalAlignment="Right" Margin="0,0,-6,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Status Label: e.g. "75% | AC POWER" or "50% | ON BATTERY" -->
                        <TextBlock Text="{Binding HeaderDisplayText}" FontSize="20" FontWeight="Bold" Foreground="{Binding HeaderAccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Window Controls -->
                <StackPanel x:Name="WindowControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Relaunch with Admin (Left of Help) — hidden once already elevated -->
                    <Button Command="{Binding RelaunchAsAdminCommand}" ToolTip="Restart AxePower with administrator rights for full system access"
                            Background="Transparent" BorderThickness="0" Height="36" Padding="14,0" Margin="0,0,6,0" Cursor="Hand"
                            Visibility="{Binding ShowRelaunchAdmin, Converter={StaticResource BoolToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="adminBtnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Relaunch with Admin" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="adminBtnBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Music ▾ — opens and collapses the title-bar player -->
                    <ToggleButton Style="{StaticResource MusicHeaderToggleStyle}" Margin="0,0,6,0"
                                  DataContext="{Binding NowPlaying}"
                                  Visibility="{Binding Converter={StaticResource NotNullToVis}}"
                                  IsChecked="{Binding IsHeaderPlayerOpen, Mode=TwoWay}"
                                  ToolTip="Show or hide the music player" AutomationProperties.Name="Music player">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Music" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HeaderToggleGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="8,2,0,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- ? Help Button (Left of Minimize) -->
                    <Button Command="{Binding OpenToolHelpCommand}" ToolTip="Help &amp; Documentation"
                            Background="Transparent" BorderThickness="0" Height="36" Padding="14,0" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="helpBtnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="?" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Help" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="helpBtnBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Minimize Window Button -->
                    <Button Content="—" FontFamily="Segoe UI" ToolTip="Minimize" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="14" Click="MinimizeButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximize Window Button -->
                    <Button Content="◻" FontFamily="Segoe UI" ToolTip="Maximize" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="16" Click="MaximizeButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Close (Minimizes to System Tray) Button -->
                    <Button Content="✕" FontFamily="Segoe UI" ToolTip="Minimize to System Tray" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="14" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#E81123"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Title-bar music player: sits beside the window controls (inside the tall Dashboard
                 header) and drops over the page elsewhere. In-window on purpose — a WPF Popup would
                 float above other apps. MainWindow.xaml.cs keeps it left of the controls. -->
            <musicviews:HeaderPlayer x:Name="HeaderPlayerHost" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,300,0"
                                     DataContext="{Binding NowPlaying}"
                                     WindowChrome.IsHitTestVisibleInChrome="True"
                                     Visibility="{Binding DataContext.ShowHeaderPlayer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />

            <!-- Notification Snackbar -->
            <Border Grid.Row="1" Grid.Column="1" 
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20,12" Margin="0,0,0,32"
                    Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding NotificationMessage}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
            </Border>

            <!-- Tool Instructions & Help Modal Overlay -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                  Visibility="{Binding IsToolHelpModalOpen, Converter={StaticResource BoolToVis}}"
                  WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Backdrop dismiss on click -->
                <Border Background="#CC0A0D14">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding CloseToolHelpCommand}"/>
                    </Border.InputBindings>
                </Border>

                <!-- Centered Modal Card -->
                <Border Width="760" MaxHeight="640" Margin="24"
                        Background="{DynamicResource ElevatedCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.7" Direction="270" ShadowDepth="12"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Tool Selector Tabs -->
                            <RowDefinition Height="Auto"/>
                            <!-- Body (Scrollable instructions) -->
                            <RowDefinition Height="*"/>
                            <!-- Footer actions -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Padding="24,20,20,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon Badge -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#1A2563EB" BorderBrush="#332563EB" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding SelectedToolHelp.IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedToolHelp.ImageIconSource, Converter={StaticResource NullToVis}}"/>
                                        <Image Source="{Binding SelectedToolHelp.ImageIconSource, TargetNullValue={x:Null}}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding SelectedToolHelp.ImageIconSource, Converter={StaticResource NotNullToVis}}"/>
                                    </Grid>
                                </Border>

                                <!-- Title & Subtitle & Credit -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                        <TextBlock Text="{Binding SelectedToolHelp.Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedToolHelp.Credit}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource EcoBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedToolHelp.Subtitle}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>

                                <!-- Close Button ✕ -->
                                <Button Grid.Column="2" Command="{Binding CloseToolHelpCommand}"
                                        Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                            <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Tool Selector Tabs (Horizontal Scrolling) -->
                        <Border Grid.Row="1" Background="{DynamicResource WindowSecondaryBackgroundBrush}" Padding="12,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" HorizontalAlignment="Stretch" Focusable="False">
                                <ItemsControl ItemsSource="{Binding AllToolGuides}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenToolHelpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}"
                                                    Margin="0,0,8,0" Padding="12,6" Cursor="Hand" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                                       Visibility="{Binding ImageIconSource, Converter={StaticResource NullToVis}}"/>
                                                                            <Image Source="{Binding ImageIconSource, TargetNullValue={x:Null}}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                                                                   Visibility="{Binding ImageIconSource, Converter={StaticResource NotNullToVis}}"/>
                                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Scrollable Guide Content -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18">
                            <StackPanel>
                                <!-- Overview Card -->
                                <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Overview" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedToolHelp.Overview}" FontSize="12" LineHeight="18" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Step-by-Step Instructions -->
                                <TextBlock Text="How To Use (Step-by-Step Instructions)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding SelectedToolHelp.Steps}" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Step check icon -->
                                                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#1A2563EB" BorderBrush="#332563EB" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Top">
                                                        <TextBlock Text="✓" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" LineHeight="17" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Pro Tips & Shortcuts -->
                                <TextBlock Text="Pro Tips &amp; Shortcuts" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding SelectedToolHelp.Tips}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="💡" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="11.5" LineHeight="16" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer Bar -->
                        <Border Grid.Row="3" Padding="24,14" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Links: Learn More (AxePower Help Center) & Tool Repo -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenReadmeHelpCommand}" Height="34" Padding="12,0" Margin="0,0,8,0" ToolTip="Open AxePower Help Center &amp; Documentation">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Learn More" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenSelectedToolCreditCommand}" Height="34" Padding="12,0" ToolTip="Open official project website or repository">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tool Website / Source" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Right Buttons: Close & Launch -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseToolHelpCommand}" Content="Close" Height="34" Padding="16,0" Margin="0,0,8,0"/>
                                    <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding LaunchSelectedToolCommand}" Content="{Binding SelectedToolHelp.LaunchButtonText}" Height="34" Padding="16,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ─── Steam-Style Client Update Banner (Image 2 & 3) ─────────────── -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom"
                    Background="#0080FF" Height="40" Panel.ZIndex="998"
                    Visibility="{Binding AboutVm.IsSteamUpdateBannerOpen, Converter={StaticResource BoolToVis}}">
                <Grid Margin="24,0">
                    <!-- Left message & link & Restart button -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AboutVm.SteamUpdateBannerMessage}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Command="{Binding AboutVm.OpenPatchNotesModalCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="View patch notes" Foreground="#FFFFFF" FontSize="13" TextDecorations="Underline" FontWeight="Medium"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Visibility="{Binding AboutVm.IsUpdateDownloaded, Converter={StaticResource BoolToVis}}"
                                Command="{Binding AboutVm.ApplyDownloadedUpdateCommand}"
                                Content="Restart &amp; Install" Foreground="#004D99" FontWeight="Bold" FontSize="12"
                                Background="#FFFFFF" BorderThickness="0" Padding="12,3" Height="26" Margin="14,0,0,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="installBtn" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="installBtn" Property="Background" Value="#E6F2FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Right Close Button -->
                    <Button HorizontalAlignment="Right" Command="{Binding AboutVm.CloseSteamUpdateBannerCommand}"
                            Content="Close" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"
                            Background="#0066CC" BorderBrush="#0052A3" BorderThickness="1"
                            Padding="16,4" Height="28" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBtn" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBtn" Property="Background" Value="#0055AA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ─── Steam-Style Patch Notes Modal Dialog (Image 1) ────────────── -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#C80A0E17" Panel.ZIndex="1000"
                  Visibility="{Binding AboutVm.IsSteamPatchNotesModalOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#202A36" BorderBrush="#354556" BorderThickness="1" CornerRadius="8"
                        Width="780" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="10" Opacity="0.8"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Scrollable Feed of Patch Note Posts -->
                        <ScrollViewer x:Name="PatchNotesScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,16,28">
                            <StackPanel>
                                <!-- ═══ POST: V2.0.2 (SEPTEMBER 24, 2026 - LATEST) ═══ -->
                                <StackPanel Margin="0,0,0,32">
                                    <StackPanel Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                            <TextBlock Text="UPDATE / PATCH NOTES" Foreground="#66C0F4" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                            <TextBlock Text="POSTED Thu, September 24, 2026" Foreground="#8F98A0" FontSize="11" Margin="10,0,0,0" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                        </StackPanel>
                                        <TextBlock Text="AxePower v2.0.2 - Skins, Game Mode &amp; DLSS 5 Swapper" Foreground="#FFFFFF" FontSize="22" FontWeight="Normal" TextWrapping="Wrap" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                    </StackPanel>

                                    <TextBlock Text="Themes become skins you can add yourself, Game Mode gets its own power plan and the dedicated GPU, and the tools you use most are one click away." Foreground="#C6D4DF" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <TextBlock Text="Highlights" Foreground="#E1E7EE" FontSize="13.5" FontWeight="Bold" Margin="0,4,0,8"/>
                                    <StackPanel Margin="12,0,0,16">
                                        <TextBlock Text="• DLSS 5 Swapper: a one-click portable downloader and runner that swaps DLSS, Streamline DLLs, RenoDX and ReShade in your games." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Share Screen: stream a display to anyone on your network, in their browser, with hardware encoding and 60 FPS held by dropping resolution, not frames." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Skins: every theme is now a skin you pick in Settings → Theme. Dark, Light, black Glass and Deep Obsidian (Glass) are included, and a new skin folder appears without a restart." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Game Mode: its own GameMode power plan, the dedicated GPU for your games while it is on, and a toggle on the Dashboard. Picking another mode ends it, but never while a game is still running." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Phone Control &amp; LanDrop: instant Wi-Fi file transfers between PC and phone without cables, plus remote quick actions." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Uninstaller Pro: removes applications and cleans only verified leftovers, with a safety backup before cleaning and a fixer for broken uninstall entries." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Terminal: a real CMD and PowerShell inside AxePower, where Software Hub installs and System Doctor repairs stream their output, with a Stop button." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Reaction Bar -->
                                    <Border Background="#161F29" BorderBrush="#263442" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding AboutVm.RateUpPatchNotesCommand}" Background="#2B3948" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="rb1" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="👍" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding AboutVm.FormattedLikesCount}" Foreground="#66C0F4" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding AboutVm.HasLikes, Converter={StaticResource BoolToVis}}"/>
                                                                    <TextBlock Text="Rate Up" Foreground="#C6D4DF" FontSize="12" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="rb1" Property="Background" Value="#384A5E"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Background="#2B3948" BorderThickness="0" Padding="10,6" Margin="6,0,0,0" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="db1" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                <TextBlock Text="👎" FontSize="12" Foreground="#8F98A0" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="db1" Property="Background" Value="#384A5E"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Command="{Binding AboutVm.DiscussPatchNotesCommand}" Background="#2B3948" BorderThickness="0" Padding="12,6" Margin="10,0,0,0" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="cb1" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="💬" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding AboutVm.FormattedCommentsCount}" Foreground="#66C0F4" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding AboutVm.HasComments, Converter={StaticResource BoolToVis}}"/>
                                                                    <TextBlock Text="Discuss" Foreground="#C6D4DF" FontSize="12" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb1" Property="Background" Value="#384A5E"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding AboutVm.SharePatchNotesCommand}" Background="#2B3948" BorderThickness="0" Padding="14,6" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="sb1" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#C6D4DF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Share" Foreground="#C6D4DF" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="sb1" Property="Background" Value="#384A5E"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
