                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="closeCircle" Width="36" Height="36" CornerRadius="18" Background="{TemplateBinding Background}">
                                            <TextBlock Text="✕" FontSize="13" Foreground="#C6D4DF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="closeCircle" Property="Background" Value="#E53E3E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Up arrow (Clickable Scroll Up) -->
                            <Button Click="PatchNotesScrollUp_Click" Width="36" Height="26" Background="#273442" BorderThickness="0" Margin="0,8,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="upBorder" Width="36" Height="26" CornerRadius="3" Background="{TemplateBinding Background}">
                                            <TextBlock Text="▲" FontSize="9" Foreground="#8F98A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="upBorder" Property="Background" Value="#384A5E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Down arrow (Clickable Scroll Down) -->
                            <Button Click="PatchNotesScrollDown_Click" Width="36" Height="26" Background="#273442" BorderThickness="0" Margin="0,4,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="downBorder" Width="36" Height="26" CornerRadius="3" Background="{TemplateBinding Background}">
                                            <TextBlock Text="▼" FontSize="9" Foreground="#8F98A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="downBorder" Property="Background" Value="#384A5E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- App Icon Badge -->
                            <Border Width="36" Height="36" CornerRadius="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,8,0,0">
                                <Image Source="{DynamicResource AppIconImage}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Tray Icon -->
            <tb:TaskbarIcon x:Name="AppTrayIcon"
                            IconSource="{DynamicResource AppIconImage}"
                            ToolTipText="AxePower"
                            TrayMouseDoubleClick="AppTrayIcon_TrayMouseDoubleClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu MinWidth="255" Background="Transparent" BorderThickness="0">
                        <ContextMenu.Template>
                            <ControlTemplate TargetType="ContextMenu">
                                <Border Background="{DynamicResource TrayMenuBackgroundBrush}" 
                                        BorderBrush="{DynamicResource TrayMenuBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="0" 
                                        Padding="1,2">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.5"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </ControlTemplate>
                        </ContextMenu.Template>
                        <ContextMenu.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TrayMenuForegroundBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="0" Margin="0,0" Padding="12,0">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="IconText" Grid.Column="0" Text="{TemplateBinding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    <TextBlock x:Name="HeaderText" Grid.Column="1" Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontSize="12.5" FontFamily="Segoe UI Variable Text, Segoe UI, Arial" FontWeight="Normal" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource TrayMenuHoverBackgroundBrush}"/>
                                                    <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TrayMenuHoverForegroundBrush}"/>
                                                    <Setter TargetName="IconText" Property="Foreground" Value="{DynamicResource TrayMenuHoverForegroundBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource TrayMenuSeparatorBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="Separator">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Height" Value="1"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Separator">
                                            <Border Height="1" Background="{DynamicResource TrayMenuSeparatorBrush}" HorizontalAlignment="Stretch" Margin="0,0"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContextMenu.Resources>

                        <!-- Group 1: Modes -->
                        <MenuItem Header="Eco" Icon="&#xE706;" Foreground="{DynamicResource EcoBrush}" Command="{Binding ApplyPowerModeCommand}" CommandParameter="Eco"/>
                        <MenuItem Header="Smart" Icon="&#xE72C;" Foreground="{DynamicResource SmartBrush}" Command="{Binding ApplyPowerModeCommand}" CommandParameter="Smart"/>
                        <MenuItem Header="Beast" Icon="&#xE7FC;" Foreground="{DynamicResource BeastBrush}" Command="{Binding ApplyPowerModeCommand}" CommandParameter="Beast"/>
                        <MenuItem Header="Game Mode" Icon="&#xE7FC;" Foreground="{DynamicResource AccentBrush}" Command="{Binding ApplyPowerModeCommand}" CommandParameter="GameMode"/>

                        <Separator/>

                        <!-- Group 2: Core Views -->
                        <MenuItem Header="Dashboard" Icon="&#xE80F;" Tag="Dashboard" Click="OpenAppAndNavigate_Click"/>
                        <MenuItem Header="Battery" Icon="&#xEBB5;" Tag="Battery" Click="OpenAppAndNavigate_Click"/>
                        <MenuItem Header="Phone Control" Icon="&#xE8EA;" Tag="PhoneControl" Click="OpenAppAndNavigate_Click"/>
                        <MenuItem Header="Second Monitor" Icon="&#xE7F4;" Click="TraySecondMonitor_Click"/>

                        <Separator/>

                        <!-- Group 3: Maintenance & Tools -->
                        <MenuItem Header="Maintenance" Icon="&#xE909;" Tag="Maintenance" Click="OpenAppAndNavigate_Click"/>
                        <MenuItem Header="Utilities" Icon="&#xE90F;" Tag="Utilities" Click="OpenAppAndNavigate_Click"/>
                        <MenuItem Header="Update PC" Icon="&#xE896;" Tag="UpdatePc" Click="OpenAppAndNavigate_Click"/>

                        <Separator/>

                        <!-- Group 4: Settings & Exit -->
                        <MenuItem Header="Settings" Icon="&#xE713;" Tag="Settings" Click="OpenAppAndNavigate_Click"/>
                        <MenuItem Header="Exit AxePower" Icon="&#xE711;" Click="ExitApp_Click"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </Grid>
    </Grid>
</Window>
