<Window x:Class="AxePower.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:AxePower.App.ViewModels"
        xmlns:views="clr-namespace:AxePower.App.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="AxePower" Height="840" Width="1280" MinWidth="1024" MinHeight="720"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/AxePower_white.ico">
        
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="112" GlassFrameThickness="0" CornerRadius="8" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AutoSwitchViewModel}">
            <views:AutoSwitchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:GameModeViewModel}">
            <views:GameModeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BatteryViewModel}">
            <views:BatteryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
        
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Subtle Glow Effects -->
        <Ellipse Width="800" Height="800" Margin="-200,-300,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.1" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1A4A8A" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="112"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="112"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Branding -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="40,30,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Image Source="/Resources/AxePower_white.ico" Width="52" Height="52" />
                        <TextBlock Text="AxePower" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="24" FontWeight="SemiBold" Margin="14,0,0,0" />
                    </StackPanel>
                    
                    <!-- Navigation -->
                    <StackPanel Grid.Row="1" Margin="0,16,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Dashboard -->
                        <Button Style="{Binding DashboardActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Auto Switch -->
                        <Button Style="{Binding AutoSwitchActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="AutoSwitch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Auto Switch" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Game Mode -->
                        <Button Style="{Binding GameModeActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="GameMode">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Game Mode" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Battery -->
                        <Button Style="{Binding BatteryActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Battery">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEBA6;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Battery" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Settings -->
                        <Button Style="{Binding SettingsActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- About -->
                    <Button Grid.Row="2" Style="{Binding AboutActiveStyle}" Margin="0,0,0,24" WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding NavigateCommand}" CommandParameter="About">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="About" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Title Bar Region -->
            <Grid Grid.Row="0" Grid.Column="1">
                <!-- Battery Status Pill (Figma style: small, left aligned) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,0" Padding="16,8" CornerRadius="12" Background="#111418" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" WindowChrome.IsHitTestVisibleInChrome="True" DataContext="{Binding BatteryVm}" Visibility="{Binding DataContext.ShowBatteryPill, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xEBA6;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding BatteryPercentage}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,0"/>
                            <TextBlock Text="{Binding PowerSource}" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" FontFamily="Segoe UI" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="14" Click="MinimizeButton_Click"/>
                    <Button Content="◻" FontFamily="Segoe UI" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="16" Click="MaximizeButton_Click"/>
                    <Button Content="✕" FontFamily="Segoe UI" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="14" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Notification Snackbar -->
            <Border Grid.Row="1" Grid.Column="1" 
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20,12" Margin="0,0,0,32"
                    Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding NotificationMessage}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
            </Border>

            <!-- Tray Icon -->
            <tb:TaskbarIcon x:Name="AppTrayIcon"
                            IconSource="/Resources/AxePower_white.ico"
                            ToolTipText="AxePower">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Eco Mode" Command="{Binding DashboardVm.SelectModeCommand}" CommandParameter="Eco"/>
                        <MenuItem Header="Smart Mode" Command="{Binding DashboardVm.SelectModeCommand}" CommandParameter="Smart"/>
                        <MenuItem Header="Beast Mode" Command="{Binding DashboardVm.SelectModeCommand}" CommandParameter="Beast"/>
                        <Separator/>
                        <MenuItem Header="Open AxePower" Click="OpenApp_Click"/>
                        <MenuItem Header="Exit" Click="ExitApp_Click"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </Grid>
    </Grid>
</Window>
