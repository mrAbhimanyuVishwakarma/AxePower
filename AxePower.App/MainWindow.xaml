
<Window x:Class="AxePower.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:AxePower.App.ViewModels"
        xmlns:views="clr-namespace:AxePower.App.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:converters="clr-namespace:AxePower.App.Converters"
        xmlns:musicvm="clr-namespace:AxePower.App.ViewModels.Music"
        xmlns:musicviews="clr-namespace:AxePower.App.Views.Music"
        xmlns:sharevm="clr-namespace:AxePower.App.ViewModels.ShareScreen"
        xmlns:shareviews="clr-namespace:AxePower.App.Views.ShareScreen"
        xmlns:shell="clr-namespace:AxePower.App.Views.Shell"
        mc:Ignorable="d"
        Title="AxePower" Height="840" Width="1290" MinWidth="1290" MinHeight="840"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="{DynamicResource AppIconImage}"
        Topmost="{Binding DashboardVm.IsWindowTopmost}">
        
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="112" GlassFrameThickness="0" CornerRadius="8" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxePower;component/Resources/ViewTemplates.xaml"/>
                <ResourceDictionary Source="/AxePower;component/Resources/ShellChromeStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Subtle Glow Effects -->
        <Ellipse Width="800" Height="800" Margin="-200,-300,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.1" IsHitTestVisible="False"
                 Visibility="{Binding DashboardVm.IsShrunk, Converter={StaticResource InverseBoolToVis}}">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1A4A8A" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <shell:ShellSidebar Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"/>

            <!-- Title Bar Region -->
            <!-- Tall only while the battery pill shows; MainWindow.xaml.cs keeps CaptionHeight in step -->
            <Grid x:Name="TitleBar" Grid.Row="0" Grid.Column="1"
                  Visibility="{Binding DashboardVm.IsShrunk, Converter={StaticResource InverseBoolToVis}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Height" Value="44"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowBatteryPill}" Value="True">
                                <Setter Property="Height" Value="112"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- Battery Status Pill (3x Large Prominent Size: Live outline battery + percentage + power status) -->
                <Border x:Name="BatteryPill" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,0" Padding="24,14" CornerRadius="16" DataContext="{Binding BatteryVm}" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="{Binding DataContext.ShowBatteryPill, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Battery Icon with Live Level Fill (3x Size) -->
                        <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                            <!-- Outer Battery Body -->
                            <Border Width="68" Height="32" CornerRadius="7" BorderBrush="{Binding HeaderAccentBrush}" BorderThickness="3.5" Background="Transparent" Padding="3">
                                <!-- Inner Charge Bar -->
                                <Border HorizontalAlignment="Left" Width="{Binding BatteryFillWidth}" CornerRadius="3" Background="{Binding HeaderAccentBrush}"/>
                            </Border>
                            <!-- Battery Positive Tip -->
                            <Border Width="5" Height="14" CornerRadius="0,3.5,3.5,0" Background="{Binding HeaderAccentBrush}" HorizontalAlignment="Right" Margin="0,0,-6,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Status Label: e.g. "75% | AC POWER" or "50% | ON BATTERY" -->
                        <TextBlock Text="{Binding HeaderDisplayText}" FontSize="20" FontWeight="Bold" Foreground="{Binding HeaderAccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Window Controls -->
                <StackPanel x:Name="WindowControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Relaunch with Admin (Left of Help) — hidden once already elevated -->
                    <Button Command="{Binding RelaunchAsAdminCommand}" ToolTip="Restart AxePower with administrator rights for full system access"
                            Background="Transparent" BorderThickness="0" Height="36" Padding="14,0" Margin="0,0,6,0" Cursor="Hand"
                            Visibility="{Binding ShowRelaunchAdmin, Converter={StaticResource BoolToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="adminBtnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Relaunch with Admin" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="adminBtnBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Music ▾ — opens and collapses the title-bar player -->
                    <ToggleButton Style="{StaticResource MusicHeaderToggleStyle}" Margin="0,0,6,0"
                                  DataContext="{Binding NowPlaying}"
                                  Visibility="{Binding Converter={StaticResource NotNullToVis}}"
                                  IsChecked="{Binding IsHeaderPlayerOpen, Mode=TwoWay}"
                                  ToolTip="Show or hide the music player" AutomationProperties.Name="Music player">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Music" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HeaderToggleGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="8,2,0,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- ? Help Button (Left of Minimize) -->
                    <Button Command="{Binding OpenToolHelpCommand}" ToolTip="Help &amp; Documentation"
                            Background="Transparent" BorderThickness="0" Height="36" Padding="14,0" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="helpBtnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="?" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Help" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="helpBtnBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Minimize Window Button -->
                    <Button Content="—" FontFamily="Segoe UI" ToolTip="Minimize" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="14" Click="MinimizeButton_Click" Style="{StaticResource CaptionButtonStyle}"/>

                    <!-- Maximize Window Button -->
                    <Button Content="◻" FontFamily="Segoe UI" ToolTip="Maximize" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="16" Click="MaximizeButton_Click" Style="{StaticResource CaptionButtonStyle}"/>

                    <!-- Close (Minimizes to System Tray) Button -->
                    <Button Content="✕" FontFamily="Segoe UI" ToolTip="Minimize to System Tray" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="14" Click="CloseButton_Click" Style="{StaticResource CaptionCloseButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Title-bar music player: sits beside the window controls (inside the tall Dashboard
                 header) and drops over the page elsewhere. In-window on purpose — a WPF Popup would
                 float above other apps. MainWindow.xaml.cs keeps it left of the controls. -->
            <musicviews:HeaderPlayer x:Name="HeaderPlayerHost" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,300,0"
                                     DataContext="{Binding NowPlaying}"
                                     WindowChrome.IsHitTestVisibleInChrome="True"
                                     Visibility="{Binding DataContext.ShowHeaderPlayer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />

            <!-- Power timer: bottom-right on every page. On the Dashboard it lines up with the right end
                 of the Display / CPU / GPU strip (69px tall, 32px side margin). -->
            <views:PowerTimerControl Grid.Row="1" Grid.Column="1" Margin="0,0,32,15"
                                     WindowChrome.IsHitTestVisibleInChrome="True" />

            <!-- Notification Snackbar -->
            <Border Grid.Row="1" Grid.Column="1" 
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20,12" Margin="0,0,0,32"
                    Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding NotificationMessage}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
            </Border>

            <!-- Tool Instructions & Help Modal Overlay -->
            <shell:ToolHelpOverlay x:Name="ToolHelp" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"/>

            <!-- ─── Steam-Style Client Update Banner (Image 2 & 3) ─────────────── -->
            <shell:UpdateBanner Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="998"/>

            <!-- A friend's invite (call or watch): pops up on any page, bottom right -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="999"
                    DataContext="{Binding ShareScreenVm.AccountFriends}" WindowChrome.IsHitTestVisibleInChrome="True"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,72" Width="340"
                    Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="16,14" Effect="{DynamicResource CardShadowEffect}"
                    Visibility="{Binding IsInvitePopupOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                    AutomationProperties.Name="Friend invite">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Top">
                        <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.2"/>
                        <TextBlock Text="{Binding InviteFromInitials}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding InviteTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding InviteSubtitle}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding DeclineInviteCommand}" Padding="16,7" FontSize="12.5" Margin="0,0,8,0" Content="Decline"/>
                            <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding JoinInviteCommand}" Padding="22,7" FontSize="12.5">
                                <TextBlock Text="Join"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Account dialog (sign in, sign up, username, edit, delete): over the whole window -->
            <views:AccountDialogView Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="1001"
                                     DataContext="{Binding AccountVm}" WindowChrome.IsHitTestVisibleInChrome="True"
                                     Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>

            <!-- ─── Steam-Style Patch Notes Modal Dialog (Image 1) ────────────── -->
            <shell:PatchNotesDialog x:Name="PatchNotes" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="1000"/>

            <!-- Tray Icon -->
            <tb:TaskbarIcon x:Name="AppTrayIcon"
                            IconSource="{DynamicResource AppIconImage}"
                            ToolTipText="AxePower"
                            TrayMouseDoubleClick="AppTrayIcon_TrayMouseDoubleClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu MinWidth="255" Background="Transparent" BorderThickness="0" Opened="TrayMenu_Opened"
                                 Template="{StaticResource TrayMenuTemplate}">
                        <ContextMenu.Resources>
                            <ResourceDictionary Source="/AxePower;component/Resources/TrayMenuStyles.xaml"/>
                        </ContextMenu.Resources>

                        <!-- Group 1: Modes. The only items with an icon, in a fixed colour per mode (the same in
                             every skin); their text is plain like the rest of the menu -->
                        <MenuItem x:Name="TrayItem_Eco" Header="Eco" Icon="&#xE706;" Foreground="#1FA855" Tag="ModeColour" Command="{Binding ApplyPowerModeCommand}" CommandParameter="Eco"/>
                        <MenuItem x:Name="TrayItem_Smart" Header="Smart" Icon="&#xE72C;" Foreground="#3B82F6" Tag="ModeColour" Command="{Binding ApplyPowerModeCommand}" CommandParameter="Smart"/>
                        <MenuItem x:Name="TrayItem_Beast" Header="Beast" Icon="&#xE7FC;" Foreground="#EF4444" Tag="ModeColour" Command="{Binding ApplyPowerModeCommand}" CommandParameter="Beast"/>
                        <MenuItem x:Name="TrayItem_GameMode" Header="Game Mode" Icon="&#xE7FC;" Foreground="#A855F7" Tag="ModeColour" Command="{Binding ApplyPowerModeCommand}" CommandParameter="GameMode"/>

                        <Separator x:Name="TraySeparator1"/>

                        <!-- Group 2: Core Views -->
                        <MenuItem x:Name="TrayItem_Dashboard" Header="Dashboard" Tag="Dashboard" Click="OpenAppAndNavigate_Click"/>
                        <MenuItem x:Name="TrayItem_Battery" Header="Battery" Tag="Battery" Click="OpenAppAndNavigate_Click"/>
                        <MenuItem x:Name="TrayItem_PhoneControl" Header="Phone Control" Tag="PhoneControl" Click="OpenAppAndNavigate_Click"/>
                        <MenuItem x:Name="TrayItem_SecondMonitor" Header="Second Monitor" Click="TraySecondMonitor_Click"/>

                        <Separator x:Name="TraySeparator2"/>

                        <!-- Group 3: Maintenance & Tools -->
                        <MenuItem x:Name="TrayItem_Maintenance" Header="Maintenance" Tag="Maintenance" Click="OpenAppAndNavigate_Click"/>
                        <MenuItem x:Name="TrayItem_Utilities" Header="Utilities" Tag="Utilities" Click="OpenAppAndNavigate_Click"/>
                        <MenuItem x:Name="TrayItem_UpdatePc" Header="Update PC" Tag="UpdatePc" Click="OpenAppAndNavigate_Click"/>

                        <Separator x:Name="TraySeparator3"/>

                        <!-- Group 4: Settings & Exit -->
                        <MenuItem x:Name="TrayItem_Settings" Header="Settings" Tag="Settings" Click="OpenAppAndNavigate_Click"/>
                        <MenuItem x:Name="TrayItem_Exit" Header="Exit AxePower" Click="ExitApp_Click"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </Grid>
    </Grid>
</Window>
