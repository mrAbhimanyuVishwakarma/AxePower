
<Window x:Class="AxePower.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:AxePower.App.ViewModels"
        xmlns:views="clr-namespace:AxePower.App.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="AxePower" Height="840" Width="1280" MinWidth="1024" MinHeight="720"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/AxePower_white.ico">
        
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="112" GlassFrameThickness="0" CornerRadius="8" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AutoSwitchViewModel}">
            <views:AutoSwitchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:GameModeViewModel}">
            <views:GameModeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BatteryViewModel}">
            <views:BatteryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:UninstallerViewModel}">
            <views:UninstallerView />
        </DataTemplate>
        
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Subtle Glow Effects -->
        <Ellipse Width="800" Height="800" Margin="-200,-300,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.1" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1A4A8A" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="112"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="112"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Branding -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="40,30,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Image Source="/Resources/AxePower_white.ico" Width="52" Height="52" />
                        <TextBlock Text="AxePower" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="24" FontWeight="SemiBold" Margin="14,0,0,0" />
                    </StackPanel>
                    
                    <!-- Navigation -->
                    <StackPanel Grid.Row="1" Margin="0,16,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Dashboard -->
                        <Button Style="{Binding DashboardActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/icons/Dashboards.png" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Auto Switch -->
                        <Button Style="{Binding AutoSwitchActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="AutoSwitch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Auto Switch" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Game Mode -->
                        <Button Style="{Binding GameModeActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="GameMode">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/icons/controller.png" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Game Mode" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Battery -->
                        <Button Style="{Binding BatteryActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Battery">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/icons/battery.png" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Battery" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Settings -->
                        <Button Style="{Binding SettingsActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Bottom Actions: Android Control, MSI Afterburner, Uninstaller Pro, Update PC, Debloat, About -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,24" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Android Control with Instructions Info (i) -->
                        <Grid>
                            <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding OpenAndroidControlCommand}" ToolTip="Control &amp; mirror Android device via scrcpy">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Android Control" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenToolHelpCommand}" CommandParameter="AndroidControl"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6"
                                    ToolTip="Credit to - Genymobile (scrcpy)&#x0a;how to use" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Opacity" Value="0.4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>

                        <!-- MSI Afterburner with Instructions Info (i) -->
                        <Grid>
                            <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding OpenMsiAfterburnerCommand}" ToolTip="Open MSI Afterburner (minimized) with hardware monitoring">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Resources/icons/MSI Afterburner.png" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="MSI Afterburner" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenToolHelpCommand}" CommandParameter="MsiAfterburner"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6"
                                    ToolTip="Credit to - MSI&#x0a;how to use" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Opacity" Value="0.4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Uninstaller Pro with Instructions Info (i) -->
                        <Grid>
                            <Button Style="{Binding UninstallerActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="Uninstaller"
                                    ToolTip="Remove applications and clean verified leftovers">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Uninstaller Pro" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenToolHelpCommand}" CommandParameter="Uninstaller"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6"
                                    ToolTip="Credit to - AxePower&#x0a;how to use" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Opacity" Value="0.4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Update PC with Instructions Info (i) -->
                        <Grid>
                            <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding UpdateDriversCommand}" ToolTip="Check &amp; update Windows, GPU drivers, and system packages">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Update PC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenToolHelpCommand}" CommandParameter="UpdatePc"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6"
                                    ToolTip="Credit to - Microsoft&#x0a;how to use" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Opacity" Value="0.4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Debloat with Instructions Info (i) -->
                        <Grid>
                            <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding DebloatCommand}" ToolTip="Launch Win11Debloat by Raphire">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Debloat" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenToolHelpCommand}" CommandParameter="Debloat" 
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6"
                                    ToolTip="Credit to - Raphire&#x0a;how to use" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Opacity" Value="0.4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>

                        <!-- About -->
                        <Button Style="{Binding AboutActiveStyle}" Command="{Binding NavigateCommand}" CommandParameter="About">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="About" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Title Bar Region -->
            <Grid Grid.Row="0" Grid.Column="1">
                <!-- Battery Status Pill (3x Large Prominent Size: Live outline battery + percentage + power status) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,0" Padding="24,14" CornerRadius="16" Background="{Binding BatteryVm.HeaderPillBackgroundBrush}" BorderBrush="{Binding BatteryVm.HeaderPillBorderBrush}" BorderThickness="1.5" WindowChrome.IsHitTestVisibleInChrome="True" DataContext="{Binding BatteryVm}" Visibility="{Binding DataContext.ShowBatteryPill, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Battery Icon with Live Level Fill (3x Size) -->
                        <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                            <!-- Outer Battery Body -->
                            <Border Width="68" Height="32" CornerRadius="7" BorderBrush="{Binding HeaderAccentBrush}" BorderThickness="3.5" Background="Transparent" Padding="3">
                                <!-- Inner Charge Bar -->
                                <Border HorizontalAlignment="Left" Width="{Binding BatteryFillWidth}" CornerRadius="3" Background="{Binding HeaderAccentBrush}"/>
                            </Border>
                            <!-- Battery Positive Tip -->
                            <Border Width="5" Height="14" CornerRadius="0,3.5,3.5,0" Background="{Binding HeaderAccentBrush}" HorizontalAlignment="Right" Margin="0,0,-6,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Status Label: e.g. "75% | AC POWER" or "50% | ON BATTERY" -->
                        <TextBlock Text="{Binding HeaderDisplayText}" FontSize="20" FontWeight="Bold" Foreground="{Binding HeaderAccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE718;" FontFamily="Segoe MDL2 Assets" ToolTip="Minimize to System Tray" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="13" Click="MinimizeToTrayButton_Click"/>
                    <Button Content="—" FontFamily="Segoe UI" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="14" Click="MinimizeButton_Click"/>
                    <Button Content="◻" FontFamily="Segoe UI" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="16" Click="MaximizeButton_Click"/>
                    <Button Content="✕" FontFamily="Segoe UI" Foreground="{DynamicResource SecondaryTextBrush}" Background="Transparent" BorderThickness="0" Width="48" Height="36" FontSize="14" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Notification Snackbar -->
            <Border Grid.Row="1" Grid.Column="1" 
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20,12" Margin="0,0,0,32"
                    Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding NotificationMessage}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
            </Border>

            <!-- Tool Instructions & Help Modal Overlay -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                  Visibility="{Binding IsToolHelpModalOpen, Converter={StaticResource BoolToVis}}"
                  WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Backdrop dismiss on click -->
                <Border Background="#CC0A0D14">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding CloseToolHelpCommand}"/>
                    </Border.InputBindings>
                </Border>

                <!-- Centered Modal Card -->
                <Border Width="760" MaxHeight="640" Margin="24"
                        Background="{DynamicResource ElevatedCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.7" Direction="270" ShadowDepth="12"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Tool Selector Tabs -->
                            <RowDefinition Height="Auto"/>
                            <!-- Body (Scrollable instructions) -->
                            <RowDefinition Height="*"/>
                            <!-- Footer actions -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Padding="24,20,20,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon Badge -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#1A2563EB" BorderBrush="#332563EB" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding SelectedToolHelp.IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedToolHelp.ImageIconSource, Converter={StaticResource NullToVis}}"/>
                                        <Image Source="{Binding SelectedToolHelp.ImageIconSource}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding SelectedToolHelp.ImageIconSource, Converter={StaticResource NotNullToVis}}"/>
                                    </Grid>
                                </Border>

                                <!-- Title & Subtitle & Credit -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                        <TextBlock Text="{Binding SelectedToolHelp.Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedToolHelp.Credit}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource EcoBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedToolHelp.Subtitle}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>

                                <!-- Close Button ✕ -->
                                <Button Grid.Column="2" Command="{Binding CloseToolHelpCommand}"
                                        Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                                            <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Tool Selector Tabs -->
                        <Border Grid.Row="1" Background="{DynamicResource WindowSecondaryBackgroundBrush}" Padding="16,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <ItemsControl ItemsSource="{Binding AllToolGuides}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenToolHelpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}"
                                                Margin="0,0,8,0" Padding="12,6" Cursor="Hand" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                                   Visibility="{Binding ImageIconSource, Converter={StaticResource NullToVis}}"/>
                                                                        <Image Source="{Binding ImageIconSource}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                                                               Visibility="{Binding ImageIconSource, Converter={StaticResource NotNullToVis}}"/>
                                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1AFFFFFF"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Scrollable Guide Content -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18">
                            <StackPanel>
                                <!-- Overview Card -->
                                <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Overview" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedToolHelp.Overview}" FontSize="12" LineHeight="18" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Step-by-Step Instructions -->
                                <TextBlock Text="How To Use (Step-by-Step Instructions)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding SelectedToolHelp.Steps}" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Step check icon -->
                                                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#1A2563EB" BorderBrush="#332563EB" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Top">
                                                        <TextBlock Text="✓" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" LineHeight="17" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Pro Tips & Shortcuts -->
                                <TextBlock Text="Pro Tips &amp; Shortcuts" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding SelectedToolHelp.Tips}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="💡" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="11.5" LineHeight="16" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer Bar -->
                        <Border Grid.Row="3" Padding="24,14" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Links: Readme & Tool Repo -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenReadmeHelpCommand}" Height="34" Padding="12,0" Margin="0,0,8,0" ToolTip="Open AxePower Readme Documentation">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📖" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Readme" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenSelectedToolCreditCommand}" Height="34" Padding="12,0" ToolTip="Open official project website or repository">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🌐" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tool Website / Source" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Right Buttons: Close & Launch -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseToolHelpCommand}" Content="Close" Height="34" Padding="16,0" Margin="0,0,8,0"/>
                                    <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding LaunchSelectedToolAsyncCommand}" Content="{Binding SelectedToolHelp.LaunchButtonText}" Height="34" Padding="16,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Tray Icon -->
            <tb:TaskbarIcon x:Name="AppTrayIcon"
                            IconSource="/Resources/AxePower_white.ico"
                            ToolTipText="AxePower"
                            TrayMouseDoubleClick="AppTrayIcon_TrayMouseDoubleClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu MinWidth="180" Background="Transparent" BorderThickness="0">
                        <ContextMenu.Template>
                            <ControlTemplate TargetType="ContextMenu">
                                <Border Background="#FFFFFF" BorderBrush="#D0D4DC" BorderThickness="1" CornerRadius="8" Padding="4,4">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </ControlTemplate>
                        </ContextMenu.Template>
                        <ContextMenu.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,1" Padding="10,0">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{TemplateBinding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4B5563" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" Foreground="#111827" FontSize="13" FontFamily="Segoe UI, Segoe UI Variable, Arial" FontWeight="Medium" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F3F4F6"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#E5E7EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="Separator">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Separator">
                                            <Border Height="1" Background="#E5E7EB" Margin="6,4"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContextMenu.Resources>
                        <MenuItem Header="Eco Mode" Icon="&#xE706;" Command="{Binding DashboardVm.SelectModeCommand}" CommandParameter="Eco"/>
                        <MenuItem Header="Smart Mode" Icon="&#xE72C;" Command="{Binding DashboardVm.SelectModeCommand}" CommandParameter="Smart"/>
                        <MenuItem Header="Beast Mode" Icon="&#xE7FC;" Command="{Binding DashboardVm.SelectModeCommand}" CommandParameter="Beast"/>
                        <Separator/>
                        <MenuItem Header="Open AxePower" Icon="&#xE8A7;" Click="OpenApp_Click"/>
                        <MenuItem Header="Exit" Icon="&#xE711;" Click="ExitApp_Click"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </Grid>
    </Grid>
</Window>
