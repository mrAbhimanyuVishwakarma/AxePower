<Application x:Class="AxePower.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localConverters="clr-namespace:AxePower.App.Converters"
             Startup="Application_Startup"
             Exit="Application_Exit"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <ResourceDictionary Source="Resources/MusicStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <localConverters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
            <localConverters:InverseBooleanConverter x:Key="InverseBool" />
            <localConverters:NullToVisibilityConverter x:Key="NullToVis" Invert="False" />
            <localConverters:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
            <localConverters:BatteryTrendConverter x:Key="BatteryTrendConverter" />
            <localConverters:BatteryPercentageToYConverter x:Key="BatteryPercentageToYConverter" />
            <localConverters:PercentageToGridLengthConverter x:Key="PercentageToGridLengthConverter" />
            <localConverters:StringEqualsToBooleanConverter x:Key="StringEqualsToBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
