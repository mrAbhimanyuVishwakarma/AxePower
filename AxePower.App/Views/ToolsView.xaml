<UserControl x:Class="AxePower.App.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels"
             xmlns:converters="clr-namespace:AxePower.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ToolsViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent"
             AutomationProperties.Name="Tools">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Small round icon button on a card -->
        <Style x:Key="ToolIconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every card: icon on the left; name and status, what it is for, then its buttons -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardPurpose" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
        </Style>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        </Style>

        <!-- A third-party app -->
        <DataTemplate DataType="{x:Type vm:ToolCard}">
            <Border Style="{DynamicResource CardStyle}" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- The app's own icon; a plain badge only for an app with no icon to show -->
                    <Grid Grid.RowSpan="2" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Grid Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                            <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Image Source="{Binding Icon}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"/>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Purpose}" Style="{StaticResource CardPurpose}"/>

                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding PrimaryCommand}"
                                Padding="18,7" MinWidth="96" Height="32" Margin="0,0,4,0">
                            <TextBlock Text="{Binding PrimaryText}" FontSize="12.5"/>
                        </Button>
                        <Button Style="{StaticResource ToolIconButton}" Content="&#xE895;" Command="{Binding UpdateCommand}"
                                ToolTip="Update" AutomationProperties.Name="Update"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource ToolIconButton}" Content="&#xE8B7;" Command="{Binding OpenFolderCommand}"
                                ToolTip="Show in folder" AutomationProperties.Name="Show in folder"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource ToolIconButton}" Content="&#xE74D;" Command="{Binding UninstallCommand}"
                                ToolTip="Uninstall" AutomationProperties.Name="Uninstall"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource ToolIconButton}" Content="&#xE774;" Command="{Binding OpenWebsiteCommand}"
                                ToolTip="Publisher's website" AutomationProperties.Name="Publisher's website"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- AxePower's power timer -->
        <DataTemplate DataType="{x:Type vm:TimerCard}">
            <Border Style="{DynamicResource CardStyle}" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.RowSpan="2" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                        <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Timer" Style="{StaticResource CardTitle}"/>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Timer.IsRunning}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Off"/>
                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Timer.IsRunning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Text">
                                                    <Setter.Value>
                                                        <MultiBinding StringFormat="{}{0} in {1}">
                                                            <Binding Path="Timer.RunningLabel"/>
                                                            <Binding Path="Timer.CountdownText"/>
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CardPurpose}"
                               Text="Shut down, restart or sleep after a set time, with a warning two minutes before."/>

                    <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenCommand}" Padding="18,7" MinWidth="96" Height="32">
                        <TextBlock Text="Open timer" FontSize="12.5"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- If-then routines: how many are on or running, and the way to the Routines page -->
        <DataTemplate DataType="{x:Type vm:RoutinesCard}">
            <Border Style="{DynamicResource CardStyle}" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.RowSpan="2" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Routines" Style="{StaticResource CardTitle}"/>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CardPurpose}"
                               Text="If this, then that: Beast mode when a game starts, Eco on battery, sleep at bedtime."/>

                    <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenCommand}" Padding="18,7" MinWidth="96" Height="32">
                        <TextBlock Text="Open routines" FontSize="12.5"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A group: its title, then its cards stacked -->
        <DataTemplate x:Key="GroupTemplate">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,16,32,24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEC7A;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Tools" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Trusted free apps for monitoring, hardware details and cleanup, plus AxePower's timer. Installs come straight from each publisher."
                               FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource ToolIconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Check again" AutomationProperties.Name="Check again"/>
            </Grid>

            <!-- Two columns; each group stacks its cards in the column the view model gave it -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ItemsControl Grid.Column="0" ItemsSource="{Binding LeftColumn}" ItemTemplate="{StaticResource GroupTemplate}" Focusable="False" VerticalAlignment="Top"/>
                <ItemsControl Grid.Column="2" ItemsSource="{Binding RightColumn}" ItemTemplate="{StaticResource GroupTemplate}" Focusable="False" VerticalAlignment="Top"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
