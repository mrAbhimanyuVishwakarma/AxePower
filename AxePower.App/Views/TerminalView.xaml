<UserControl x:Class="AxePower.App.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TerminalViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent"
             AutomationProperties.Name="Terminal">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Shell toggle button (CMD / PowerShell) -->
        <Style x:Key="ShellToggleStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ElevatedCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active variant applied via DataTrigger below -->
        <Style x:Key="ShellToggleActiveStyle" TargetType="Button" BasedOn="{StaticResource ShellToggleStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Console -->
            <RowDefinition Height="Auto"/>  <!-- Input -->
        </Grid.RowDefinitions>

        <!-- ─── 1. Header ─── -->
        <Grid Grid.Row="0" Margin="40,24,40,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Terminal" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <!-- Elevation badge -->
                    <Border VerticalAlignment="Center" Margin="14,2,0,0" CornerRadius="6" Padding="10,3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1A94A3B8"/>
                                <Setter Property="BorderBrush" Value="#3394A3B8"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                        <Setter Property="Background" Value="#1AF59E0B"/>
                                        <Setter Property="BorderBrush" Value="#33F59E0B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ElevationBadge}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Run CMD or PowerShell commands inside AxePower. Output from Software Hub and System Doctor also streams here."
                           FontSize="13.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Grid>

        <!-- ─── 2. Toolbar: shell toggles + clear/stop ─── -->
        <Grid Grid.Row="1" Margin="40,0,40,14">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding UseCmdCommand}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ShellToggleStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCmdActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CMD" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding UsePowerShellCommand}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ShellToggleStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPowerShellActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PowerShell" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding StopCommand}" Padding="14,8" FontSize="12.5" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="Stop" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ClearCommand}" Padding="14,8" FontSize="12.5">
                    <TextBlock Text="Clear"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ─── 3. Console output ─── -->
        <Border Grid.Row="2" Margin="40,0,40,14" Background="#0F172A" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <ScrollViewer x:Name="OutputScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding OutputText, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#34D399"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="12.5"
                         TextWrapping="Wrap"
                         IsInactiveSelectionHighlightEnabled="True"/>
            </ScrollViewer>
        </Border>

        <!-- ─── 4. Input row ─── -->
        <Border Grid.Row="3" Margin="40,0,40,24" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>

                <TextBox Grid.Column="1" x:Name="InputBox"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource AccentBrush}"
                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13"
                         VerticalContentAlignment="Center" Padding="0,8"
                         PreviewKeyDown="InputBox_PreviewKeyDown"
                         AutomationProperties.Name="Terminal command input"/>

                <Button Grid.Column="2" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding RunCommandCommand}" Padding="16,7" FontSize="12.5" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Run" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="&#xE751;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
