<UserControl x:Class="AxePower.App.Views.TrustView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Trust and Permissions"
             KeyboardNavigation.TabNavigation="Continue">
    <!-- Trust & Permissions (Prompt 25): permissions, listeners, data, connections and this build,
         live. Every control is a Button with an accessible name, in one vertical tab order, so the
         keyboard and the controller's D-pad (arrow keys) reach all of them. -->
    <UserControl.Resources>
        <Style x:Key="TrustSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="TrustSectionLead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="TrustRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ElevatedCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="TrustMuted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <DataTemplate x:Key="TrustFactTemplate">
            <Border Style="{StaticResource TrustRow}">
                <StackPanel>
                    <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap">
                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Value, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource TrustMuted}" Visibility="{Binding Detail, Converter={StaticResource NotNullToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="28,22,28,28" MaxWidth="980">
            <!-- Header -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Trust &amp; Permissions" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="What AxePower can do on this PC, what it listens on, what it keeps, and what it sends where. Read from the running app, not from a description."
                               Style="{StaticResource TrustSectionLead}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" Content="Refresh" Padding="14,6" Height="32"
                            AutomationProperties.Name="Refresh everything on this page"/>
                    <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource TrustMuted}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding StatusText, Converter={StaticResource NotNullToVis}}" AutomationProperties.LiveSetting="Polite"/>

            <!-- 1. This app on this PC -->
            <Border Style="{DynamicResource CardElevatedStyle}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="This app on this PC" Style="{StaticResource TrustSectionTitle}"/>
                    <TextBlock Text="The rights AxePower runs with and how it starts." Style="{StaticResource TrustSectionLead}"/>
                    <ItemsControl ItemsSource="{Binding AppFacts}" ItemTemplate="{StaticResource TrustFactTemplate}" Focusable="False"/>
                </StackPanel>
            </Border>

            <!-- 2. Listening on your network -->
            <Border Style="{DynamicResource CardElevatedStyle}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Listening on this PC" Style="{StaticResource TrustSectionTitle}"/>
                    <TextBlock Text="Ports AxePower can open, whether each is open now, and who is connected." Style="{StaticResource TrustSectionLead}"/>
                    <ItemsControl ItemsSource="{Binding Listeners}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TrustRow}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="{Binding Address}" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource TrustMuted}"><Run Text="When: " FontWeight="SemiBold"/><Run Text="{Binding WhenOpen, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Style="{StaticResource TrustMuted}"><Run Text="Who can connect: " FontWeight="SemiBold"/><Run Text="{Binding WhoCanConnect, Mode=OneWay}"/></TextBlock>
                                        <ItemsControl ItemsSource="{Binding Clients}" Focusable="False" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap">
                                                            <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Address, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}"/><Run Text="  "/><Run Text="{Binding Since, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}"/>
                                                        </TextBlock>
                                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Disconnect" Padding="10,3" Height="26"
                                                                Command="{Binding DataContext.DisconnectClientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding DataContext.CanRotate, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}, Converter={StaticResource BoolToVis}}"
                                                                AutomationProperties.Name="{Binding Name, StringFormat=Disconnect {0}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Stop" Padding="14,4" Height="28" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.StopListenerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanStop, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{Binding Name, StringFormat=Stop {0}}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Disconnect all and rotate access link" Padding="14,4" Height="28"
                                                    Command="{Binding DataContext.RotateAccessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanRotate, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Disconnect every device and rotate the access link"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. Account and cloud data -->
            <Border Style="{DynamicResource CardElevatedStyle}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Account and cloud data" Style="{StaticResource TrustSectionTitle}"/>
                    <TextBlock Text="Accounts are optional. Only with one is anything about you kept in AxePower's cloud (Supabase)." Style="{StaticResource TrustSectionLead}"/>
                    <ItemsControl ItemsSource="{Binding AccountFacts}" ItemTemplate="{StaticResource TrustFactTemplate}" Focusable="False"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Sign out…" Command="{Binding SignOutCommand}" Padding="14,4" Height="30" Margin="0,0,8,0"
                                AutomationProperties.Name="Sign out of AxePower on this PC"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Delete my account…" Command="{Binding DeleteAccountCommand}" Padding="14,4" Height="30"
                                Foreground="{DynamicResource ErrorBrush}" AutomationProperties.Name="Delete my AxePower account and its cloud data"/>
                    </StackPanel>
                    <TextBlock Text="What the cloud keeps for an account" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding CloudData}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TrustRow}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding Contents}" Style="{StaticResource TrustMuted}"/>
                                        <TextBlock Style="{StaticResource TrustMuted}"><Run Text="When: " FontWeight="SemiBold"/><Run Text="{Binding When, Mode=OneWay}"/><Run Text="  ·  Kept: " FontWeight="SemiBold"/><Run Text="{Binding Retention, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 4. Data on this PC -->
            <Border Style="{DynamicResource CardElevatedStyle}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Data on this PC" Style="{StaticResource TrustSectionTitle}"/>
                    <TextBlock Text="Where AxePower keeps things. Logs, caches and histories can be deleted here; your files, backups, settings and change history can only be opened." Style="{StaticResource TrustSectionLead}"/>
                    <ItemsControl ItemsSource="{Binding Stores}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TrustRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Size, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Contents}" Style="{StaticResource TrustMuted}"/>
                                            <TextBlock Text="{Binding PathDisplay}" FontSize="11.5" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource TrustMuted}" Visibility="{Binding Note, Converter={StaticResource NotNullToVis}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open folder" Padding="12,4" Height="28" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.OpenStoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    IsEnabled="{Binding Exists}" AutomationProperties.Name="{Binding Name, StringFormat=Open the folder of {0}}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Delete…" Padding="12,4" Height="28"
                                                    Command="{Binding DataContext.DeleteStoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding Deletable, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding Exists}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Delete {0}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 5. Connections -->
            <Border Style="{DynamicResource CardElevatedStyle}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Connections to other services" Style="{StaticResource TrustSectionTitle}"/>
                    <TextBlock Text="Every place AxePower contacts, what makes it do so, and what is sent. AxePower has no ads and sends no usage analytics to its developers." Style="{StaticResource TrustSectionLead}"/>
                    <ItemsControl ItemsSource="{Binding Connections}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TrustRow}" Focusable="True" KeyboardNavigation.IsTabStop="True"
                                        AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Trigger}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Hosts}" FontSize="11.5" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Style="{StaticResource TrustMuted}"><Run Text="When: " FontWeight="SemiBold"/><Run Text="{Binding Trigger, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Style="{StaticResource TrustMuted}"><Run Text="Sent: " FontWeight="SemiBold"/><Run Text="{Binding DataSent, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Style="{StaticResource TrustMuted}"><Run Text="To avoid it: " FontWeight="SemiBold"/><Run Text="{Binding Control, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 6. Updates and this build -->
            <Border Style="{DynamicResource CardElevatedStyle}" Padding="22">
                <StackPanel>
                    <TextBlock Text="Updates and this build" Style="{StaticResource TrustSectionTitle}"/>
                    <TextBlock Text="Which version this is, what it was built from, and how updates are checked before they install." Style="{StaticResource TrustSectionLead}"/>
                    <ItemsControl ItemsSource="{Binding BuildFacts}" ItemTemplate="{StaticResource TrustFactTemplate}" Focusable="False"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
