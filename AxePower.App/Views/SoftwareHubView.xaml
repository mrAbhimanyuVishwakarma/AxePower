<UserControl x:Class="AxePower.App.Views.SoftwareHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels"
             xmlns:converters="clr-namespace:AxePower.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SoftwareHubViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent"
             AutomationProperties.Name="Update PC and Software Hub">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <!-- Declared locally as well as in App.xaml so the view can be constructed standalone -->
        <converters:StringEqualsToBooleanConverter x:Key="StringEqualsToBool"/>

        <!-- Fluent Card Selection CheckBox Style -->
        <Style x:Key="FluentCardCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="5"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1.5">
                            <TextBlock x:Name="CheckMark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab RadioButton Style -->
        <Style x:Key="SoftwareTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource ElevatedCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Category Chip Style -->
        <Style x:Key="CategoryChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pill Accent Button Style -->
        <Style x:Key="PillAccentButtonStyle" TargetType="Button">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                </Style>
            </Style.Resources>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Segment Tabs -->
            <RowDefinition Height="*"/>     <!-- Active Tab Panel -->
        </Grid.RowDefinitions>

        <!-- ─── 1. Header (single line; the description moved to its tooltip to leave room for the lists) ── -->
        <Grid Grid.Row="0" Margin="40,14,40,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Background="Transparent"
                        ToolTip="Comprehensive Windows &amp; GPU driver updates, WinGet package manager, gaming runtimes, and update shield policies.">
                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Update PC &amp; Software Hub" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ─── 2. Segment Tabs ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Padding="40,0,40,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="🚀 System &amp; Driver Updaters" Style="{StaticResource SoftwareTabStyle}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Updaters}" Margin="0,0,10,0"/>
                <RadioButton Content="📦 Gaming Runtimes &amp; Tools" Style="{StaticResource SoftwareTabStyle}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Apps}" Margin="0,0,10,0"/>
                <RadioButton Content="🛡️ Windows Update Shield" Style="{StaticResource SoftwareTabStyle}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Updates}" Margin="0,0,10,0"/>
            </StackPanel>
        </Border>

        <!-- ─── 3. Content Panel ────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="40,0,40,12">

            <!-- TAB 1: System & Driver Updaters (Old + New Integration) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Updaters">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Hero Banner: Health & System Update Status (Matching User Design) -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="32,24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Illustrated Monitor + Download Icon -->
                                <Grid Grid.Column="0" Width="110" Height="86" Margin="0,0,32,0" VerticalAlignment="Center">
                                    <!-- Monitor Screen Outline -->
                                    <Border Width="82" Height="56" BorderBrush="#94A3B8" BorderThickness="2" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#0F172A"/>
                                    <!-- Monitor Stand -->
                                    <Path Data="M26,56 L20,74 L62,74 L56,56 Z" Stroke="#94A3B8" StrokeThickness="2" Fill="#0F172A" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Line X1="16" Y1="74" X2="66" Y2="74" Stroke="#94A3B8" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <!-- Download Circle Badge -->
                                    <Border Width="44" Height="44" CornerRadius="22" BorderBrush="#60A5FA" BorderThickness="2.5" Background="#1E293B" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Right: Text Info & Action Button -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="An up-to-date system is a healthy system" FontSize="16.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding LastUpdatedText, StringFormat='Last updated: {0}'}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding NextScheduledUpdateText, StringFormat='Next scheduled update: {0}'}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                                    <!-- Pill Button -->
                                    <Button Style="{StaticResource PillAccentButtonStyle}"
                                            Command="{Binding CheckAllUpdatesCommand}"
                                            IsEnabled="{Binding IsCheckingAllUpdates, Converter={StaticResource InverseBool}}"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Check for updates" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Right: Graphics Driver Centre (auto-detected adapters only) -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="470" Margin="28,0,0,0"
                                            Visibility="{Binding HasGraphicsAdapters, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                        <TextBlock Text="&#xF211;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="GRAPHICS DRIVERS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding GraphicsAdapters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Vendor accent bar -->
                                                        <Border Grid.Column="0" Width="3" CornerRadius="2" Background="{Binding AccentColorHex}" Margin="0,1,12,1"/>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                                <TextBlock Text="{Binding VendorName}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding AccentColorHex}" VerticalAlignment="Center"/>
                                                                <Border Background="#22FFFFFF" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="250" HorizontalAlignment="Left" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding DriverDisplay}" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <!-- NVIDIA Control Panel (second Store app from the same vendor) -->
                                                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.OpenGraphicsCompanionAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{Binding CompanionAppName, StringFormat='Open {0} in the Microsoft Store'}"
                                                                    Visibility="{Binding HasCompanionApp, Converter={StaticResource BoolToVis}}"
                                                                    Padding="9,7" Margin="0,0,6,0" FontSize="11">
                                                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                            </Button>
                                                            <!-- NVIDIA Version Selector / Rollback Button -->
                                                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.OpenNvidiaPickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Select specific Game Ready driver version or rollback if the new update has bugs or stuttering"
                                                                    Visibility="{Binding IsNvidia, Converter={StaticResource BoolToVis}}"
                                                                    Padding="10,7" Margin="0,0,6,0" FontSize="11">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Versions" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- Official download page — only when there is no Store app for this vendor -->
                                                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.OpenGraphicsVendorSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Open the official driver download page"
                                                                    Visibility="{Binding ShowOfficialSiteFallback, Converter={StaticResource BoolToVis}}"
                                                                    Padding="9,7" Margin="0,0,6,0" FontSize="11">
                                                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                            </Button>
                                                            <Button Style="{DynamicResource PrimaryButtonStyle}"
                                                                    Command="{Binding DataContext.UpdateGraphicsDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding DataContext.IsInstallingGraphicsDriver, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"
                                                                    ToolTip="{Binding ToolName, StringFormat='Install or update via {0}'}"
                                                                    Padding="14,7" FontSize="11.5">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Install" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Method 0: BIOS & UEFI Firmware Update Center (New Implementation) -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="BIOS &amp; UEFI Firmware Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <Border Background="#1A6366F1" BorderBrush="#336366F1" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="FIRMWARE CENTER" FontSize="10.5" Foreground="#818CF8" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Query motherboard BIOS versions, scan for Windows Update firmware capsules, and access official vendor update portals."
                                                   FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                Command="{Binding OpenVendorBiosPortalCommand}"
                                                Margin="0,0,10,0" Padding="16,10" FontSize="13">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Vendor Portal" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource PrimaryButtonStyle}"
                                                Command="{Binding CheckFirmwareUpdatesCommand}"
                                                IsEnabled="{Binding IsCheckingFirmware, Converter={StaticResource InverseBool}}"
                                                Padding="20,10" FontSize="13">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Check for BIOS Updates" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Live Firmware Details Grid -->
                                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="16,14" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Detail 1: Current BIOS Version -->
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="CURRENT BIOS VERSION" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding FirmwareInfo.BiosVersion}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding FirmwareInfo.BiosReleaseDate, StringFormat='Release: {0}'}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Detail 2: System Model & Motherboard -->
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="SYSTEM &amp; MOTHERBOARD" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding FirmwareInfo.SystemModel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding FirmwareInfo.MotherboardProduct, StringFormat='Board: {0}'}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Detail 3: UEFI & Secure Boot -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="FIRMWARE STATUS" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding FirmwareInfo.UefiStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding FirmwareInfo.SecureBootStatus, StringFormat='Secure Boot: {0}'}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Status Message Banner -->
                                <Border Grid.Row="2" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ⓘ" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FirmwareCheckStatus}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button Grid.Column="2" Style="{DynamicResource SidebarButtonStyle}" Command="{Binding TriggerWindowsFirmwareScanCommand}" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Scan Windows Capsules" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Method 1: Elevated 3-Step Driver & System Updater (Existing Implementation) -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Elevated 3-Step Driver &amp; System Updater" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <Border Background="#1A06B6D4" BorderBrush="#3306B6D4" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="CLASSIC PIPELINE" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Runs automated PowerShell administrator script to install Windows updates, GPU vendor software (NVIDIA App/AMD Adrenalin/Intel DSA), and upgrade system packages."
                                                   FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{DynamicResource PrimaryButtonStyle}"
                                            Command="{Binding LaunchElevatedDriverUpdateCommand}"
                                            Padding="22,12" FontSize="13.5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Launch Update Pipeline" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Steps Breakdown -->
                                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="16,14" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="STEP 1" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="Windows Software Updates" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="Searches &amp; installs pending Microsoft system updates via COM API / USOClient." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="STEP 2" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="GPU &amp; Graphics Drivers" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="Detects NVIDIA, AMD, or Intel hardware and updates vendor companion apps." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="STEP 3" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="All System Packages" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="Performs silent batch upgrade of all installed applications via WinGet CLI." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Method 2: In-App WinGet Batch Upgrades (New Implementation) -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="In-App WinGet Batch Upgrade" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="NATIVE GUI" FontSize="10.5" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Directly executes 'winget upgrade --all' inside AxePower and streams live progress logs into the built-in terminal console."
                                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                                        Command="{Binding UpgradeAllAppsCommand}"
                                        IsEnabled="{Binding IsUpgradingAll, Converter={StaticResource InverseBool}}"
                                        Padding="20,12" FontSize="13.5" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Upgrade All Apps" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2: Gaming Runtimes & Tools -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Apps">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Search & Category Filters -->
                    <RowDefinition Height="Auto"/>  <!-- Batch Selection Toolbar -->
                    <RowDefinition Height="*"/>     <!-- Packages Grid -->
                </Grid.RowDefinitions>

                <!-- Search & Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Border Grid.Column="0" Background="{DynamicResource ElevatedCardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"
                                     VerticalAlignment="Center" AutomationProperties.Name="Search software packages"/>
                        </Grid>
                    </Border>

                    <!-- Category Chips -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="All" Style="{StaticResource CategoryChipStyle}"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsToBool}, ConverterParameter=All}" Margin="0,0,6,0"/>
                        <RadioButton Content="Runtimes &amp; DirectX" Style="{StaticResource CategoryChipStyle}"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Runtimes}" Margin="0,0,6,0"/>
                        <RadioButton Content="Gaming &amp; Launchers" Style="{StaticResource CategoryChipStyle}"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Gaming}" Margin="0,0,6,0"/>
                        <RadioButton Content="Hardware &amp; Tuning" Style="{StaticResource CategoryChipStyle}"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Monitoring}" Margin="0,0,6,0"/>
                        <RadioButton Content="Tools &amp; Utilities" Style="{StaticResource CategoryChipStyle}"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Utilities}" Margin="0,0,6,0"/>
                    </StackPanel>
                </Grid>

                <!-- Batch Selection Toolbar (flat strip, no card, so the package list gets the height) -->
                <Border Grid.Row="1" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Quick Selection Buttons & Status -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Select Uninstalled" Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding SelectUninstalledCommand}"
                                    Padding="12,5" FontSize="12" Margin="0,0,8,0"
                                    AutomationProperties.Name="Select all uninstalled packages"/>

                            <Button Content="Select All" Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding SelectAllCommand}"
                                    Padding="12,5" FontSize="12" Margin="0,0,8,0"
                                    AutomationProperties.Name="Select all packages"/>

                            <Button Content="Clear" Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding ClearSelectionCommand}"
                                    Padding="10,5" FontSize="12" Margin="0,0,12,0"
                                    IsEnabled="{Binding HasSelectedPackages}"
                                    AutomationProperties.Name="Clear package selection"/>

                            <!-- Selection Pill Badge -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} Selected'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Batch status text if installing -->
                            <TextBlock Text="{Binding BatchInstallStatus}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"
                                       Visibility="{Binding IsBatchInstalling, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- Batch Action Buttons (Direct & Terminal) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Direct Install Button -->
                            <Button Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding InstallSelectedDirectCommand}"
                                    IsEnabled="{Binding HasSelectedPackages}"
                                    Padding="14,5" FontSize="12.5" Margin="0,0,10,0"
                                    ToolTip="Install all selected uninstalled packages sequentially in the background">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Install Selected (Direct)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Terminal Install Button -->
                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding InstallSelectedViaTerminalCommand}"
                                    IsEnabled="{Binding HasSelectedPackages}"
                                    Padding="12,5" FontSize="12.5"
                                    ToolTip="Open in AxePower Terminal and run batch installation live in interactive PowerShell">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Install in Terminal" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Packages List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredPackages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Selection CheckBox -->
                                        <CheckBox Grid.Column="0" Style="{StaticResource FluentCardCheckBoxStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,14,0"
                                                  Visibility="{Binding IsWebLinkOnly, Converter={StaticResource InverseBoolToVis}}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}"/>

                                        <!-- Package Icon -->
                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                
                                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryDisplayName}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                                                </Border>

                                                <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="INSTALLED" FontSize="10.5" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="17"/>
                                            <TextBlock Text="{Binding WinGetId, StringFormat='WinGet ID: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.6" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <!-- Custom Dual Buttons (e.g. Ninite: Install local + Custom web) -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowCustomInstallerButtons, Converter={StaticResource BoolToVis}}">
                                                <Button Style="{DynamicResource PrimaryButtonStyle}"
                                                        Command="{Binding LaunchLocalInstallerCommand}"
                                                        Padding="16,5" FontSize="12.5" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Install" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                        Command="{Binding OpenCustomWebUrlCommand}"
                                                        Padding="14,5" FontSize="12.5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Custom" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Web Link Button (entries that only open a website) -->
                                            <Button Style="{DynamicResource PrimaryButtonStyle}"
                                                    Command="{Binding OpenLinkWithWarningCommand}"
                                                    Visibility="{Binding IsWebLinkOnly, Converter={StaticResource BoolToVis}}"
                                                    Padding="16,5" FontSize="12.5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Link" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Install Button (When not installed, via PowerShell or portable downloader) -->
                                            <Button Style="{DynamicResource PrimaryButtonStyle}"
                                                    Command="{Binding InstallCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                    Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}"
                                                    Padding="18,5" FontSize="12.5" ToolTip="{Binding InstallButtonTooltip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding InstallButtonText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Open Button (When installed) -->
                                            <Button Style="{DynamicResource PrimaryButtonStyle}"
                                                    Command="{Binding OpenAppCommand}"
                                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                                    Padding="14,5" FontSize="12.5" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding OpenButtonText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Update Button (When installed, via PowerShell or portable updater) -->
                                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                    Command="{Binding UpdateCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}"
                                                    Padding="14,5" FontSize="12.5" Margin="0,0,6,0"
                                                    ToolTip="{Binding UpdateButtonTooltip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Update" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Uninstall Button (When installed) -->
                                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                    Command="{Binding UninstallCommand}"
                                                    Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}"
                                                    Padding="12,5" FontSize="12.5">
                                                <TextBlock Text="Uninstall" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- TAB 3: Windows Update Shield -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Updates">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Policy 1: Security Updates Only -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Security Updates Only (Recommended Policy)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Defers major disruptive Windows feature updates by 365 days while ensuring essential security and quality patches install smoothly."
                                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>

                                <CheckBox Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}"
                                          IsChecked="{Binding IsSecurityOnlyActive, Mode=OneWay}"
                                          Command="{Binding ToggleSecurityOnlyCommand}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Policy 2: Block Forced Reboots -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource BeastBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Block Forced Automatic Reboots" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Prevents Windows from forcefully restarting your PC when a user is actively logged on, protecting ongoing games, downloads, and rendering jobs."
                                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>

                                <CheckBox Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}"
                                          IsChecked="{Binding IsNoForcedRebootActive, Mode=OneWay}"
                                          Command="{Binding ToggleNoForcedRebootCommand}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Tool 3: 1-Click Update Cache Repair -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Windows Update Cache &amp; Service Reset" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Fixes stuck or corrupted Windows updates by stopping update services, clearing the SoftwareDistribution cache, and restarting background services."
                                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                                        Command="{Binding ResetUpdateCacheCommand}"
                                        Padding="18,10" FontSize="13" VerticalAlignment="Center">
                                    <TextBlock Text="Reset &amp; Repair Cache" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Tool 4: Create System Restore Point -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource BeastBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Create System Restore Point" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Snapshot Windows before installing updates, drivers, or tweaks so you can roll back if something breaks. Requires administrator rights."
                                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                                        Command="{Binding CreateRestorePointCommand}"
                                        IsEnabled="{Binding IsCreatingRestorePoint, Converter={StaticResource InverseBool}}"
                                        Padding="18,10" FontSize="13" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Create Restore Point"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCreatingRestorePoint}" Value="True">
                                                            <Setter Property="Text" Value="Creating…"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>


        <!-- Warning Modal Dialog for Web Link -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Visibility="{Binding IsWarningModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#CC000000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="999">
            <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Width="500" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.7" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#F59E0B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding WarningModalTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding WarningModalMessage}" FontSize="13.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,24"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CancelWebLinkWarningCommand}" Content="Cancel" Padding="18,9" Margin="0,0,10,0"/>
                        <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ConfirmOpenWebLinkCommand}" Content="Open in Browser" Padding="20,9"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- NVIDIA Driver Version Selector & Rollback Modal Dialog -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Visibility="{Binding IsNvidiaPickerOpen, Converter={StaticResource BoolToVis}}"
              Background="#D9000000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="1000">
            <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Width="620" Padding="28,24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.8" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Adapter info & variant toggle -->
                        <RowDefinition Height="Auto"/> <!-- Dropdown Version Picker -->
                        <RowDefinition Height="Auto"/> <!-- Selected Driver Notes Card -->
                        <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- NVIDIA Badge Icon -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#1A76B900" BorderBrush="#3376B900" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#76B900" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="NVIDIA Driver Version &amp; Rollback" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0"/>
                                <Border Background="#1A76B900" BorderBrush="#3376B900" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="GAME READY" FontSize="9.5" FontWeight="Bold" Foreground="#76B900"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Choose a proven stable version or rollback if recent updates cause stuttering or bugs." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <!-- Close ✕ -->
                        <Button Grid.Column="2" Command="{Binding CloseNvidiaPickerCommand}" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                            <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Current GPU Status Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedNvidiaAdapter.Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedNvidiaAdapter.DriverDisplay, StringFormat='Installed: {0}'}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- Laptop vs Desktop Toggle -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Variant:" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <RadioButton Content="Laptop" IsChecked="{Binding IsNotebookVariant}" Style="{StaticResource CategoryChipStyle}" Margin="0,0,6,0"/>
                                <RadioButton Content="Desktop" IsChecked="{Binding IsNotebookVariant, Converter={StaticResource InverseBool}}" Style="{StaticResource CategoryChipStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Dropdown Version Selector -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,14">
                        <TextBlock Text="CHOOSE VERSION TO INSTALL OR ROLLBACK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                        <ComboBox Style="{DynamicResource AppComboBoxStyle}" ItemsSource="{Binding CuratedNvidiaDrivers}" SelectedItem="{Binding SelectedNvidiaDriver}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Version, StringFormat='v{0}'}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ReleaseDate}" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeColorHex}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Selected Driver Details Card -->
                    <Border Grid.Row="3" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding SelectedNvidiaDriver.Badge}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding SelectedNvidiaDriver.BadgeColorHex}"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedNvidiaDriver.ReleaseDate, StringFormat='Released: {0}'}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedNvidiaDriver.Description}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,8"/>
                            <TextBlock Text="Direct clean WHQL installer downloaded straight from official NVIDIA content delivery servers." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <!-- Footer Actions -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Link to NVIDIA Advanced Driver Search -->
                        <Button Grid.Column="0" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenNvidiaAdvancedSearchCommand}" Padding="12,8" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="NVIDIA Archive Search" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseNvidiaPickerCommand}" Content="Cancel" Padding="16,8" Margin="0,0,8,0"/>
                            <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding InstallSelectedNvidiaDriverCommand}"
                                    IsEnabled="{Binding IsDownloadingNvidiaDriver, Converter={StaticResource InverseBool}}"
                                    Padding="20,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Download &amp; Run Installer" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
