<UserControl x:Class="AxePower.App.Views.SoftwareHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels"
             xmlns:converters="clr-namespace:AxePower.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SoftwareHubViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent"
             AutomationProperties.Name="Update PC and Software Hub">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>

        <!-- Tab RadioButton Style -->
        <Style x:Key="SoftwareTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource ElevatedCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category Chip Style -->
        <Style x:Key="CategoryChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill Accent Button Style -->
        <Style x:Key="PillAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Segment Tabs -->
            <RowDefinition Height="*"/>     <!-- Active Tab Panel -->
            <RowDefinition Height="69"/>    <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ─── 1. Header ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="40,24,40,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Update PC &amp; Software Hub" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Comprehensive Windows &amp; GPU driver updates, WinGet package manager, gaming runtimes, and update shield policies."
                           FontSize="13.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Grid>

        <!-- ─── 2. Segment Tabs ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Padding="40,0,40,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="🚀 System &amp; Driver Updaters" Style="{StaticResource SoftwareTabStyle}"
                             IsChecked="True" Command="{Binding SetTabCommand}" CommandParameter="Updaters" Margin="0,0,10,0"/>
                <RadioButton Content="📦 Gaming Runtimes &amp; Tools" Style="{StaticResource SoftwareTabStyle}"
                             Command="{Binding SetTabCommand}" CommandParameter="Apps" Margin="0,0,10,0"/>
                <RadioButton Content="🛡️ Windows Update Shield" Style="{StaticResource SoftwareTabStyle}"
                             Command="{Binding SetTabCommand}" CommandParameter="Updates" Margin="0,0,10,0"/>
                <RadioButton Content="💻 Live Terminal &amp; Logs" Style="{StaticResource SoftwareTabStyle}"
                             Command="{Binding SetTabCommand}" CommandParameter="Console" Margin="0,0,10,0"/>
            </StackPanel>
        </Border>

        <!-- ─── 3. Content Panel ────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="40,0,40,24">

            <!-- TAB 1: System & Driver Updaters (Old + New Integration) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Updaters">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Hero Banner: Health & System Update Status (Matching User Design) -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="32,24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Illustrated Monitor + Download Icon -->
                                <Grid Grid.Column="0" Width="110" Height="86" Margin="0,0,32,0" VerticalAlignment="Center">
                                    <!-- Monitor Screen Outline -->
                                    <Border Width="82" Height="56" BorderBrush="#94A3B8" BorderThickness="2" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#0F172A"/>
                                    <!-- Monitor Stand -->
                                    <Path Data="M26,56 L20,74 L62,74 L56,56 Z" Stroke="#94A3B8" StrokeThickness="2" Fill="#0F172A" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Line X1="16" Y1="74" X2="66" Y2="74" Stroke="#94A3B8" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <!-- Download Circle Badge -->
                                    <Border Width="44" Height="44" CornerRadius="22" BorderBrush="#60A5FA" BorderThickness="2.5" Background="#1E293B" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Right: Text Info & Action Button -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="An up-to-date system is a healthy system" FontSize="16.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding LastUpdatedText, StringFormat='Last updated: {0}'}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding NextScheduledUpdateText, StringFormat='Next scheduled update: {0}'}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                                    <!-- Pill Button -->
                                    <Button Style="{StaticResource PillAccentButtonStyle}"
                                            Command="{Binding CheckAllUpdatesCommand}"
                                            IsEnabled="{Binding IsCheckingAllUpdates, Converter={StaticResource InverseBool}}"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Check for updates" FontWeight="SemiBold" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Method 0: BIOS & UEFI Firmware Update Center (New Implementation) -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="BIOS &amp; UEFI Firmware Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <Border Background="#1A6366F1" BorderBrush="#336366F1" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="FIRMWARE CENTER" FontSize="10.5" Foreground="#818CF8" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Query motherboard BIOS versions, scan for Windows Update firmware capsules, and access official vendor update portals."
                                                   FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                Command="{Binding OpenVendorBiosPortalCommand}"
                                                Margin="0,0,10,0" Padding="16,10" FontSize="13">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Vendor Portal" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource PrimaryButtonStyle}"
                                                Command="{Binding CheckFirmwareUpdatesCommand}"
                                                IsEnabled="{Binding IsCheckingFirmware, Converter={StaticResource InverseBool}}"
                                                Padding="20,10" FontSize="13">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Check for BIOS Updates" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Live Firmware Details Grid -->
                                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="16,14" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Detail 1: Current BIOS Version -->
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="CURRENT BIOS VERSION" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding FirmwareInfo.BiosVersion}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding FirmwareInfo.BiosReleaseDate, StringFormat='Release: {0}'}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Detail 2: System Model & Motherboard -->
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="SYSTEM &amp; MOTHERBOARD" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding FirmwareInfo.SystemModel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding FirmwareInfo.MotherboardProduct, StringFormat='Board: {0}'}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Detail 3: UEFI & Secure Boot -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="FIRMWARE STATUS" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding FirmwareInfo.UefiStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding FirmwareInfo.SecureBootStatus, StringFormat='Secure Boot: {0}'}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Status Message Banner -->
                                <Border Grid.Row="2" Background="#111827" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ⓘ" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FirmwareCheckStatus}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button Grid.Column="2" Style="{DynamicResource SidebarButtonStyle}" Command="{Binding TriggerWindowsFirmwareScanCommand}" Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Scan Windows Capsules" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Method 1: Elevated 3-Step Driver & System Updater (Existing Implementation) -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Elevated 3-Step Driver &amp; System Updater" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <Border Background="#1A06B6D4" BorderBrush="#3306B6D4" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="CLASSIC PIPELINE" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Runs automated PowerShell administrator script to install Windows updates, GPU vendor software (NVIDIA App/AMD Adrenalin/Intel DSA), and upgrade system packages."
                                                   FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{DynamicResource PrimaryButtonStyle}"
                                            Command="{Binding LaunchElevatedDriverUpdateCommand}"
                                            Padding="22,12" FontSize="13.5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Launch Update Pipeline" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Steps Breakdown -->
                                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="16,14" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="STEP 1" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="Windows Software Updates" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="Searches &amp; installs pending Microsoft system updates via COM API / USOClient." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="STEP 2" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="GPU &amp; Graphics Drivers" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="Detects NVIDIA, AMD, or Intel hardware and updates vendor companion apps." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="STEP 3" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="All System Packages" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="Performs silent batch upgrade of all installed applications via WinGet CLI." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Method 2: In-App WinGet Batch Upgrades (New Implementation) -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="In-App WinGet Batch Upgrade" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="NATIVE GUI" FontSize="10.5" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Directly executes 'winget upgrade --all' inside AxePower and streams live progress logs into the built-in terminal console."
                                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                                        Command="{Binding UpgradeAllAppsCommand}"
                                        IsEnabled="{Binding IsUpgradingAll, Converter={StaticResource InverseBool}}"
                                        Padding="20,12" FontSize="13.5" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Upgrade All Apps" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2: Gaming Runtimes & Tools -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Apps">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Search & Category Filters -->
                    <RowDefinition Height="*"/>     <!-- Packages Grid -->
                </Grid.RowDefinitions>

                <!-- Search & Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Border Grid.Column="0" Background="{DynamicResource ElevatedCardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" Margin="0,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"
                                     VerticalAlignment="Center" AutomationProperties.Name="Search software packages"/>
                        </Grid>
                    </Border>

                    <!-- Category Chips -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="All" Style="{StaticResource CategoryChipStyle}" IsChecked="True"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="All" Margin="0,0,6,0"/>
                        <RadioButton Content="Runtimes &amp; DirectX" Style="{StaticResource CategoryChipStyle}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Runtimes" Margin="0,0,6,0"/>
                        <RadioButton Content="Gaming &amp; Launchers" Style="{StaticResource CategoryChipStyle}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Gaming" Margin="0,0,6,0"/>
                        <RadioButton Content="Hardware &amp; Tuning" Style="{StaticResource CategoryChipStyle}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Monitoring" Margin="0,0,6,0"/>
                        <RadioButton Content="Tools &amp; Utilities" Style="{StaticResource CategoryChipStyle}"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Utilities" Margin="0,0,6,0"/>
                    </StackPanel>
                </Grid>

                <!-- Packages List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredPackages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Package Icon -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                
                                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryDisplayName}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                                                </Border>

                                                <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="INSTALLED" FontSize="10.5" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="17"/>
                                            <TextBlock Text="{Binding WinGetId, StringFormat='WinGet ID: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.6" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <!-- Custom Dual Buttons (e.g. Ninite: Install local + Custom web) -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowCustomInstallerButtons, Converter={StaticResource BoolToVis}}">
                                                <Button Style="{DynamicResource PrimaryButtonStyle}"
                                                        Command="{Binding LaunchLocalInstallerCommand}"
                                                        Padding="16,8" FontSize="12.5" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Install" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                        Command="{Binding OpenCustomWebUrlCommand}"
                                                        Padding="14,8" FontSize="12.5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Custom" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Web Link Button (e.g. FitGirl Repacks) -->
                                            <Button Style="{DynamicResource PrimaryButtonStyle}"
                                                    Command="{Binding OpenLinkWithWarningCommand}"
                                                    Visibility="{Binding IsWebLinkOnly, Converter={StaticResource BoolToVis}}"
                                                    Padding="16,8" FontSize="12.5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Link" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Install Button (When not installed, via PowerShell) -->
                                            <Button Style="{DynamicResource PrimaryButtonStyle}"
                                                    Command="{Binding InstallCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                    Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}"
                                                    Padding="18,8" FontSize="12.5" ToolTip="Install this software via PowerShell">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Install" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Open Button (When installed) -->
                                            <Button Style="{DynamicResource PrimaryButtonStyle}"
                                                    Command="{Binding OpenAppCommand}"
                                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                                    Padding="14,8" FontSize="12.5" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Open" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Update Button (When installed, via PowerShell) -->
                                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                    Command="{Binding UpdateCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                    Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}"
                                                    Padding="14,8" FontSize="12.5" Margin="0,0,6,0"
                                                    ToolTip="Update this software to the latest release via PowerShell">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Update" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Uninstall Button (When installed) -->
                                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                    Command="{Binding UninstallCommand}"
                                                    Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}"
                                                    Padding="12,8" FontSize="12.5">
                                                <TextBlock Text="Uninstall" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- TAB 3: Windows Update Shield -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Updates">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Policy 1: Security Updates Only -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Security Updates Only (Recommended Policy)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Defers major disruptive Windows feature updates by 365 days while ensuring essential security and quality patches install smoothly."
                                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>

                                <CheckBox Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}"
                                          IsChecked="{Binding IsSecurityOnlyActive, Mode=OneWay}"
                                          Command="{Binding ToggleSecurityOnlyCommand}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Policy 2: Block Forced Reboots -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource BeastBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Block Forced Automatic Reboots" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Prevents Windows from forcefully restarting your PC when a user is actively logged on, protecting ongoing games, downloads, and rendering jobs."
                                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>

                                <CheckBox Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}"
                                          IsChecked="{Binding IsNoForcedRebootActive, Mode=OneWay}"
                                          Command="{Binding ToggleNoForcedRebootCommand}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Tool 3: 1-Click Update Cache Repair -->
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Windows Update Cache &amp; Service Reset" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Fixes stuck or corrupted Windows updates by stopping update services, clearing the SoftwareDistribution cache, and restarting background services."
                                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                                        Command="{Binding ResetUpdateCacheCommand}"
                                        Padding="18,10" FontSize="13" VerticalAlignment="Center">
                                    <TextBlock Text="Reset &amp; Repair Cache" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- TAB 4: Live Terminal & Logs -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Console">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding ClearConsoleCommand}"
                                Padding="14,8" FontSize="12.5">
                            <TextBlock Text="Clear Console Log"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Console Window -->
                <Border Grid.Row="1" Background="#0F172A" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding ConsoleOutput, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#34D399"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontSize="12.5"
                                 TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>

        </Grid>

        <!-- ─── 4. Bottom Status Bar ────────────────────────────────────────── -->
        <Border Grid.Row="3" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="32" Height="32" Margin="0,0,16,0">
                        <Ellipse Fill="{DynamicResource ElevatedCardBackgroundBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" />
                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Software Hub Ready" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock Text="WinGet package management &amp; PowerShell 1-click silent installs." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Warning Modal Dialog for Web Link -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Visibility="{Binding IsWarningModalOpen, Converter={StaticResource BoolToVis}}"
              Background="#CC000000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="999">
            <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Width="500" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.7" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#F59E0B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding WarningModalTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding WarningModalMessage}" FontSize="13.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,24"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CancelWebLinkWarningCommand}" Content="Cancel" Padding="18,9" Margin="0,0,10,0"/>
                        <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ConfirmOpenWebLinkCommand}" Content="Open in Browser" Padding="20,9"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
