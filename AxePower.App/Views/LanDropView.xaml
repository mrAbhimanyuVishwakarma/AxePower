<UserControl x:Class="AxePower.App.Views.LanDropView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LanDropViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent"
             AutomationProperties.Name="LAN Drop Quick Transfer">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Main Content Scroll -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="40,24,40,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="LAN Drop" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    
                    <!-- Server State Badge -->
                    <Border Margin="14,0,0,0" Padding="10,4" CornerRadius="12" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1F3729"/>
                                <Setter Property="BorderBrush" Value="#10B981"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerRunning}" Value="False">
                                        <Setter Property="Background" Value="#2A1B20"/>
                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#10B981"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="False">
                                                <Setter Property="Fill" Value="#EF4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="ACTIVE ON WI-FI"/>
                                        <Setter Property="Foreground" Value="#10B981"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="False">
                                                <Setter Property="Text" Value="SERVER STOPPED"/>
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <TextBlock Text="Instant offline file sharing &amp; clipboard drop between PC and phones over local Wi-Fi. No internet or phone app required."
                           FontSize="13.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <!-- Top Header Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenSaveDirectoryCommand}" Margin="0,0,10,0" ToolTip="Open received files folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Downloads Folder" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Toggle Server Button -->
                <Button Command="{Binding ToggleServerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Start Server" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                    <Setter Property="Background" Value="#EF4444"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Stop Server" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,0,36,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="320" MaxWidth="460"/> <!-- Left: QR Code & Connection Card -->
                    <ColumnDefinition Width="3*" MinWidth="360"/>   <!-- Right: Transfers & Clipboard -->
                </Grid.ColumnDefinitions>

                <!-- ─── Left Column: Connection & QR Code ───────────────────────────── -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Border Style="{DynamicResource CardElevatedStyle}">
                        <StackPanel>
                            <TextBlock Text="📱 Connect Phone / Device" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="Scan this QR code with your phone camera or browser on the same Wi-Fi network to transfer files instantly."
                                       FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,16"/>

                            <!-- QR Code Container -->
                            <Border Background="#090D16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="16" Height="220" Margin="0,0,0,16" Padding="14">
                                <Grid>
                                    <Image Source="{Binding QrCodeImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServerRunning}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Server Offline" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Click 'Start Server' to generate QR" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Direct URL Box -->
                            <TextBlock Text="Local Server URL:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <TextBox Text="{Binding ServerUrl, Mode=OneWay}" IsReadOnly="True"
                                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderBrush="{DynamicResource CardBorderBrush}" Padding="10,8" FontSize="12.5" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CopyServerUrlCommand}" ToolTip="Copy URL" Padding="8,4" Margin="0,0,4,0">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenInBrowserCommand}" ToolTip="Open in Browser" Padding="8,4">
                                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Network Adapter / IP Selector -->
                            <TextBlock Text="Network Adapter / IP Address:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding AvailableIpAddresses}" SelectedItem="{Binding SelectedIpAddress}"
                                      Margin="0,0,0,14" Padding="8,6" FontSize="12.5"/>

                            <!-- Port Number -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Port Number:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding PortNumber, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                         Padding="6,4" FontSize="12" TextAlignment="Center" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </Grid>

                            <!-- Instruction tip -->
                            <Border Background="#131B2A" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Tip: Ensure both your PC and phone are connected to the same Wi-Fi router or mobile hotspot."
                                               FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ─── Right Column: Transfers & Quick Drop ────────────────────────── -->
                <StackPanel Grid.Column="1">
                    
                    <!-- Card 1: Share Files from PC to Mobile -->
                    <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📤 Share to Mobile &amp; Other Devices" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SharedCount}" FontSize="11" FontWeight="Bold" Foreground="#090D16"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Files listed here can be downloaded instantly by any connected phone." FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ClearSharedFilesCommand}"
                                            Margin="0,0,8,0" Padding="10,6" ToolTip="Clear shared list">
                                        <TextBlock Text="Clear All" FontSize="12"/>
                                    </Button>
                                    <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding AddFilesToShareCommand}" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Add Files" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Shared Files List -->
                            <ItemsControl ItemsSource="{Binding SharedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FormattedSize}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.RemoveSharedFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Padding="8,4" ToolTip="Remove from share list">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#EF4444"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty Shared Placeholder -->
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="20" Background="#0C111C">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSharedFiles}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="No files queued for mobile download" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click '+ Add Files' above to host files for your phone." FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Received Files from Mobile -->
                    <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📥 Received Files from Devices" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <Border Background="#10B981" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ReceivedCount}" FontSize="11" FontWeight="Bold" Foreground="#090D16"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Files dropped from mobile phones to this PC are saved here." FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ClearReceivedFilesCommand}"
                                        Padding="10,6" VerticalAlignment="Top" ToolTip="Clear history">
                                    <TextBlock Text="Clear History" FontSize="12"/>
                                </Button>
                            </Grid>

                            <!-- Received Files List -->
                            <ItemsControl ItemsSource="{Binding ReceivedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0">
                                                        <Run Text="{Binding FormattedSize}"/>
                                                        <Run Text=" • From "/>
                                                        <Run Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.OpenReceivedFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="8,4" Margin="0,0,6,0" ToolTip="Open File">
                                                        <TextBlock Text="Open" FontSize="11.5"/>
                                                    </Button>
                                                    <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.ShowReceivedFileInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="8,4" Margin="0,0,6,0" ToolTip="Show in Explorer">
                                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                    </Button>
                                                    <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.DeleteReceivedFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="8,4" ToolTip="Delete File">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#EF4444"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty Received Placeholder -->
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="20" Background="#0C111C">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasReceivedFiles}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="No files received yet" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Scan the QR code with your phone and drop files to see them here." FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Quick Text & Clipboard Sync -->
                    <Border Style="{DynamicResource CardElevatedStyle}">
                        <StackPanel>
                            <TextBlock Text="📋 Quick Text &amp; Clipboard Drop" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Send notes, links, or OTP codes between your PC and phone instantly." FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>

                            <!-- Input Box -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding QuickTextInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderBrush="{DynamicResource CardBorderBrush}" Padding="10,8" FontSize="13" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SendQuickTextCommand}" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Send to Phone" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Messages History -->
                            <ItemsControl ItemsSource="{Binding ClipboardMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Content}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0">
                                                        <Run Text="{Binding SenderDevice}"/>
                                                        <Run Text=" • "/>
                                                        <Run Text="{Binding Timestamp, StringFormat=HH:mm:ss}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.CopyMessageTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Padding="6,3" ToolTip="Copy Text">
                                                    <TextBlock Text="Copy" FontSize="11"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
