<UserControl x:Class="AxePower.App.Views.SoftwareHub.PackagesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels"
             xmlns:converters="clr-namespace:AxePower.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SoftwareHubViewModel, IsDesignTimeCreatable=False}">
    <!-- The Gaming Runtimes and Tools tab: category rail, search, batch toolbar and the package cards. Moved out of SoftwareHubView.xaml unchanged (Prompt 20); its DataContext is the SoftwareHubViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/AxePower;component/Resources/SoftwareHubStyles.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActiveTab}" Value="Apps">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Category navigation belongs only to this package page. -->
        <Border Grid.Column="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="220"/>
                    <Setter Property="Background" Value="{DynamicResource WindowSecondaryBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="CornerRadius" Value="10,0,0,10"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCategoryListCollapsed}" Value="True">
                            <Setter Property="Width" Value="64"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Border IsHitTestVisible="False">
                    <Border.OpacityMask>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,120">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#80000000" Offset="0.45"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,12,10,8">
                        <TextBlock Text="CATEGORIES"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="10,0,8,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsCategoryListCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                        <Button HorizontalAlignment="Right"
                                Width="32"
                                Height="32"
                                Cursor="Hand"
                                Command="{Binding ToggleCategoryListCommand}"
                                AutomationProperties.Name="Collapse or expand software categories">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="ToolTip" Value="Collapse categories"/>
                                    <Setter Property="Content" Value="&#xE76B;"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ToggleBackground" Background="Transparent" CornerRadius="8">
                                                    <TextBlock Text="{TemplateBinding Content}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ToggleBackground" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="ToggleBackground" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCategoryListCollapsed}" Value="True">
                                            <Setter Property="ToolTip" Value="Expand categories"/>
                                            <Setter Property="Content" Value="&#xE76C;"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Margin="10,0,10,10">
                    <RadioButton Content="All" ToolTip="All"
                                 Tag="&#xE71D;"
                                 GroupName="SoftwareCategories"
                                 Style="{StaticResource SoftwareCategoryRailStyle}"
                                 IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource StringEqualsToBool}, ConverterParameter=All}"/>
                    <RadioButton Content="Runtimes &amp; DirectX" ToolTip="Runtimes &amp; DirectX"
                                 Tag="&#xE896;"
                                 GroupName="SoftwareCategories"
                                 Style="{StaticResource SoftwareCategoryRailStyle}"
                                 IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Runtimes}"/>
                    <RadioButton Content="Gaming &amp; Launchers" ToolTip="Gaming &amp; Launchers"
                                 Tag="&#xE7FC;"
                                 GroupName="SoftwareCategories"
                                 Style="{StaticResource SoftwareCategoryRailStyle}"
                                 IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Gaming}"/>
                    <RadioButton Content="Hardware &amp; Tuning" ToolTip="Hardware &amp; Tuning"
                                 Tag="&#xE950;"
                                 GroupName="SoftwareCategories"
                                 Style="{StaticResource SoftwareCategoryRailStyle}"
                                 IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Monitoring}"/>
                    <RadioButton Content="Tools &amp; Utilities" ToolTip="Tools &amp; Utilities"
                                 Tag="&#xE90F;"
                                 GroupName="SoftwareCategories"
                                 Style="{StaticResource SoftwareCategoryRailStyle}"
                                 IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Utilities}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="18,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Search -->
                <RowDefinition Height="Auto"/>  <!-- Batch Selection Toolbar -->
                <RowDefinition Height="*"/>     <!-- Packages Grid -->
            </Grid.RowDefinitions>

            <!-- Search Input -->
            <Border Grid.Row="0" Width="300" HorizontalAlignment="Left"
                    Background="{DynamicResource ElevatedCardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"
                             VerticalAlignment="Center" AutomationProperties.Name="Search software packages"/>
                </Grid>
            </Border>

        <!-- Batch Selection Toolbar (flat strip, no card, so the package list gets the height) -->
        <Border Grid.Row="1" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Quick Selection Buttons & Status -->
                <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <Button Content="Select Uninstalled" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding SelectUninstalledCommand}"
                            Padding="12,5" FontSize="12" Margin="0,0,8,6"
                            AutomationProperties.Name="Select all uninstalled packages"/>

                    <Button Content="Select All" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding SelectAllCommand}"
                            Padding="12,5" FontSize="12" Margin="0,0,8,6"
                            AutomationProperties.Name="Select all packages"/>

                    <Button Content="Clear" Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding ClearSelectionCommand}"
                            Padding="10,5" FontSize="12" Margin="0,0,12,6"
                            IsEnabled="{Binding HasSelectedPackages}"
                            AutomationProperties.Name="Clear package selection"/>

                    <!-- Selection Pill Badge -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,0,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} Selected'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Batch status text if installing -->
                    <TextBlock Text="{Binding BatchInstallStatus}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"
                               Visibility="{Binding IsBatchInstalling, Converter={StaticResource BoolToVis}}"/>

                    <!-- Cancel the running batch -->
                    <Button Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding CancelBatchCommand}"
                            Visibility="{Binding IsBatchInstalling, Converter={StaticResource BoolToVis}}"
                            Padding="10,3" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                            ToolTip="Stop the current install and skip the rest">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,6,0" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Cancel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Batch Action Buttons (Direct & Terminal) -->
                <WrapPanel VerticalAlignment="Center">
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <!-- Keep actions inline while the category rail is collapsed. -->
                            <Setter Property="Grid.Row" Value="0"/>
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="Grid.ColumnSpan" Value="1"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Style.Triggers>
                                <!-- Move actions below only when the content area is actually narrow. -->
                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource LessThan}, ConverterParameter=820}" Value="True">
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.Column" Value="0"/>
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Margin" Value="0,4,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                    <!-- Direct Install Button -->
                    <Button Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding InstallSelectedDirectCommand}"
                            IsEnabled="{Binding HasSelectedPackages}"
                            Padding="14,5" FontSize="12.5" Margin="0,0,10,0"
                            ToolTip="Install all selected uninstalled packages sequentially in the background">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Install Selected (Direct)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Terminal Install Button -->
                    <Button Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding InstallSelectedViaTerminalCommand}"
                            IsEnabled="{Binding HasSelectedPackages}"
                            Padding="12,5" FontSize="12.5"
                            ToolTip="Install the selected packages with the Terminal page showing the output live">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Install in Terminal" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Packages List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredPackages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Selection CheckBox -->
                                <CheckBox Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource FluentCardCheckBoxStyle}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,14,0"
                                          Visibility="{Binding IsWebLinkOnly, Converter={StaticResource InverseBoolToVis}}"
                                          AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}"/>

                                <!-- Package Icon -->
                                <Border Grid.RowSpan="2" Grid.Column="1" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <WrapPanel Margin="0,0,0,2">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,2"/>

                                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="8,2" Margin="0,0,8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryDisplayName}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                                        </Border>

                                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,0,2" VerticalAlignment="Center"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="INSTALLED" FontSize="10.5" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="17"/>
                                    <TextBlock Text="{Binding WinGetId, StringFormat='WinGet ID: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.6" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <WrapPanel VerticalAlignment="Center">
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <!-- Collapsed category rail: retain the original compact inline actions. -->
                                            <Setter Property="Grid.Row" Value="0"/>
                                            <Setter Property="Grid.Column" Value="3"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="16,0,0,0"/>
                                            <Style.Triggers>
                                                <!-- Use a lower row only when the card itself has insufficient width. -->
                                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource LessThan}, ConverterParameter=760}" Value="True">
                                                    <Setter Property="Grid.Row" Value="1"/>
                                                    <Setter Property="Grid.Column" Value="2"/>
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="Margin" Value="0,8,0,0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>
                                    <!-- Custom Dual Buttons (e.g. Ninite: Install local + Custom web) -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowCustomInstallerButtons, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{DynamicResource PrimaryButtonStyle}"
                                                Command="{Binding LaunchLocalInstallerCommand}"
                                                Padding="16,5" FontSize="12.5" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Install" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                Command="{Binding OpenCustomWebUrlCommand}"
                                                Padding="14,5" FontSize="12.5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Custom" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Web Link Button (entries that only open a website) -->
                                    <Button Style="{DynamicResource PrimaryButtonStyle}"
                                            Command="{Binding OpenLinkWithWarningCommand}"
                                            Visibility="{Binding IsWebLinkOnly, Converter={StaticResource BoolToVis}}"
                                            Padding="16,5" FontSize="12.5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Link" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Install Button (When not installed, via PowerShell or portable downloader) -->
                                    <Button Style="{DynamicResource PrimaryButtonStyle}"
                                            Command="{Binding InstallCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}"
                                            Padding="18,5" FontSize="12.5" ToolTip="{Binding InstallButtonTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding InstallButtonText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Open Button (When installed) -->
                                    <Button Style="{DynamicResource PrimaryButtonStyle}"
                                            Command="{Binding OpenAppCommand}"
                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                            Padding="14,5" FontSize="12.5" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding OpenButtonText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Update Button (When installed, via PowerShell or portable updater) -->
                                    <Button Style="{DynamicResource SecondaryButtonStyle}"
                                            Command="{Binding UpdateCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}"
                                            Padding="14,5" FontSize="12.5" Margin="0,0,6,0"
                                            ToolTip="{Binding UpdateButtonTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Update" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Uninstall Button (When installed) -->
                                    <Button Style="{DynamicResource SecondaryButtonStyle}"
                                            Command="{Binding UninstallCommand}"
                                            Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}"
                                            Padding="12,5" FontSize="12.5">
                                        <TextBlock Text="Uninstall" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Cancel Button (While an install, update or uninstall runs) -->
                                    <Button Style="{DynamicResource SecondaryButtonStyle}"
                                            Command="{Binding CancelCommand}"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                            Padding="12,5" FontSize="12.5" Margin="6,0,0,0"
                                            ToolTip="Stop and end the running installer">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Cancel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
