<UserControl x:Class="AxePower.App.Views.SoftwareHub.NvidiaDriverPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SoftwareHubViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary Source="/AxePower;component/Resources/SoftwareHubStyles.xaml"/>
    </UserControl.Resources>

    <Grid Visibility="{Binding IsNvidiaPickerOpen, Converter={StaticResource BoolToVis}}"
          Background="#D9000000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="16" MaxWidth="620" Margin="16" Padding="24,20" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.8" Color="#000000"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Detected adapter -->
                    <RowDefinition Height="Auto"/> <!-- Dropdown Version Picker -->
                    <RowDefinition Height="Auto"/> <!-- Selected Driver Notes Card -->
                    <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- NVIDIA Badge Icon -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#1A76B900" BorderBrush="#3376B900" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#76B900" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NVIDIA Driver Versions" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,2"/>
                        <TextBlock Text="Choose a release for the detected GPU." FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <!-- Close ✕ -->
                    <Button Grid.Column="2" Command="{Binding CloseNvidiaPickerCommand}" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top"
                            AutomationProperties.Name="Close NVIDIA driver versions">
                        <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Button>
                </Grid>

                <!-- Current GPU Status Bar -->
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNvidiaAdapter.Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding SelectedNvidiaAdapter.DriverDisplay, StringFormat='Installed: {0}'}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Dropdown Version Selector -->
                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <TextBlock Text="Driver version" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <ComboBox Style="{DynamicResource AppComboBoxStyle}" ItemsSource="{Binding NvidiaDrivers}" SelectedItem="{Binding SelectedNvidiaDriver}"
                              IsEnabled="{Binding CanInstallSelectedNvidiaDriver}" AutomationProperties.Name="NVIDIA driver version">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Version, StringFormat='v{0}'}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ReleaseDate}" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeColorHex}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding NvidiaPickerStatus}" Margin="0,7,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>

                <!-- Selected Driver Details Card -->
                <TextBlock Grid.Row="3" Text="{Binding SelectedNvidiaDriver.Description, FallbackValue=''}"
                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <!-- Footer Actions -->
                <WrapPanel Grid.Row="4">
                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenNvidiaAdvancedSearchCommand}" Padding="12,8" FontSize="12" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nvidia Drivers" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseNvidiaPickerCommand}" Content="Cancel" Padding="16,8" Margin="0,0,8,6"/>
                    <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding InstallSelectedNvidiaDriverCommand}"
                            IsEnabled="{Binding CanInstallSelectedNvidiaDriver}" Margin="0,0,0,6" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Install selected driver" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
