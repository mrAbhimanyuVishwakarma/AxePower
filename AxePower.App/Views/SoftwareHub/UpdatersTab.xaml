<UserControl x:Class="AxePower.App.Views.SoftwareHub.UpdatersTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:AxePower.App.Views.SoftwareHub"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SoftwareHubViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxePower;component/Resources/SoftwareHubStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="UpdateSection" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ElevatedCardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Padding" Value="22,16"/>
            </Style>
            <Style x:Key="UpdateTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="UpdateText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="UpdateRow" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                <Setter Property="Padding" Value="0,9"/>
            </Style>
            <Style x:Key="UpdateAction" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Padding" Value="12,8"/>
            </Style>
            <Style x:Key="PrimaryUpdateAction" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Padding" Value="14,8"/>
            </Style>
            <Style x:Key="OptionalUpdateText" TargetType="TextBlock" BasedOn="{StaticResource UpdateText}">
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="CatalogUpdateRow">
                <Border Style="{StaticResource UpdateRow}">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource UpdateTitle}" FontSize="13"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource OptionalUpdateText}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="UpdateGroupHeader">
                <TextBlock Style="{StaticResource UpdateTitle}" Margin="0">
                    <Run Text="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=Expander}, Mode=OneWay}"/>
                    <Run Text="   "/><Run Text="{Binding Mode=OneWay}" FontSize="13" FontWeight="Normal"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                </TextBlock>
            </DataTemplate>
            <Style x:Key="UpdateGroup" TargetType="Expander">
                <Setter Property="Background" Value="{DynamicResource ElevatedCardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="Padding" Value="22,12"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Tag" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=local:UpdatersTab}, Converter={StaticResource LessThan}, ConverterParameter=850}"/>
                <Setter Property="HeaderTemplate" Value="{StaticResource UpdateGroupHeader}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                <StackPanel>
                                    <ToggleButton x:Name="GroupToggle" Background="Transparent" HorizontalContentAlignment="Stretch"
                                                  AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ToggleSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="0,4">
                                                    <DockPanel>
                                                        <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource SecondaryTextBrush}"
                                                              StrokeThickness="1.6" VerticalAlignment="Center" Margin="4,0,12,0" RenderTransformOrigin="0.5,0.5"/>
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                            <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ToggleSurface" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <ContentPresenter ContentSource="Header"/>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="GroupBody" Visibility="Collapsed" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="GroupBody" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActiveTab}" Value="Updaters">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Border Style="{StaticResource UpdateSection}" CornerRadius="18" Padding="32,24" Margin="0,0,0,16">
                    <Grid x:Name="UpdateHero">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid VerticalAlignment="Center">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, ElementName=UpdateHero, Converter={StaticResource LessThan}, ConverterParameter=775}" Value="True">
                                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="110" Height="86" Margin="0,0,32,0" VerticalAlignment="Center">
                                <Border Width="82" Height="56" BorderBrush="#94A3B8" BorderThickness="2" CornerRadius="8"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Background="#0F172A"/>
                                <Path Data="M26,56 L20,74 L62,74 L56,56 Z" Stroke="#94A3B8" StrokeThickness="2"
                                      Fill="#0F172A" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Line X1="16" Y1="74" X2="66" Y2="74" Stroke="#94A3B8" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Border Width="44" Height="44" CornerRadius="22" BorderBrush="#60A5FA" BorderThickness="2.5"
                                        Background="#1E293B" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#60A5FA"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Update status" Style="{StaticResource UpdateTitle}" FontSize="16.5" Margin="0,0,0,8"/>
                                <TextBlock Text="Find Windows patches, app upgrades, and device updates." Style="{StaticResource UpdateText}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding LastPcCheck}" Style="{StaticResource UpdateText}" Margin="0,0,0,16"/>
                                <Button Content="Check for updates" Style="{StaticResource PillAccentButtonStyle}"
                                        Command="{Binding CheckAllUpdatesCommand}" IsEnabled="{Binding CanCheckForUpdates}"
                                        HorizontalAlignment="Left">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentForegroundBrush}"/>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <TextBlock Text="{Binding PcUpdateProgress, TargetNullValue='', NotifyOnTargetUpdated=True}"
                                           AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus"
                                           Style="{StaticResource OptionalUpdateText}" Margin="0,8,0,0"/>
                                <Button Content="Stop after current app" Style="{StaticResource UpdateAction}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding StopSelectedUpdatesCommand}"
                                        Visibility="{Binding CanStopSelectedUpdates, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Visibility="{Binding PcRestartRequired, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                    <TextBlock Text="A restart is needed to finish or continue updating." Style="{StaticResource UpdateTitle}" FontSize="13"/>
                                    <Button Content="Open restart options" Style="{StaticResource UpdateAction}" HorizontalAlignment="Left"
                                            Command="{Binding OpenWindowsRestartOptionsCommand}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding UpdateHandoffStatus, TargetNullValue='', NotifyOnTargetUpdated=True}"
                                           Style="{StaticResource OptionalUpdateText}" AutomationProperties.LiveSetting="Polite" TargetUpdated="AnnounceStatus"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="UpdateHeroGraphics" VerticalAlignment="Center" MaxWidth="470"
                                    Visibility="{Binding HasGraphicsAdapters, Converter={StaticResource BoolToVis}}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Grid.Column" Value="1"/>
                                    <Setter Property="Margin" Value="28,0,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, ElementName=UpdateHero, Converter={StaticResource LessThan}, ConverterParameter=775}" Value="True">
                                            <Setter Property="Grid.Row" Value="1"/>
                                            <Setter Property="Grid.Column" Value="0"/>
                                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Margin" Value="0,20,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                <TextBlock Text="&#xF211;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="GRAPHICS DRIVERS" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding GraphicsAdapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="3" CornerRadius="2" Background="{Binding AccentColorHex}" Margin="0,1,12,1"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding VendorName}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TypeLabel}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="11.5" MaxWidth="250"
                                                               HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="{Binding DriverDisplay}" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <Button Style="{DynamicResource SecondaryButtonStyle}" Padding="9,7" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.OpenGraphicsCompanionAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="{Binding CompanionAppName, StringFormat='Open {0}'}"
                                                            AutomationProperties.Name="{Binding CompanionAppName, StringFormat='Open {0}'}"
                                                            IsEnabled="{Binding DataContext.CanCheckForUpdates, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Visibility="{Binding IsNvidia, Converter={StaticResource BoolToVis}}">
                                                        <Image Source="/Resources/icons/nvidia_control_panel.png" Width="14" Height="14"/>
                                                    </Button>
                                                    <Button Style="{DynamicResource SecondaryButtonStyle}" Padding="9,7" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.OpenNvidiaPickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Select NVIDIA driver version"
                                                            AutomationProperties.Name="Select NVIDIA driver version"
                                                            IsEnabled="{Binding DataContext.CanCheckForUpdates, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Visibility="{Binding IsNvidia, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                    </Button>
                                                    <Button Style="{DynamicResource PrimaryButtonStyle}" Padding="14,7" FontSize="11.5"
                                                            Command="{Binding DataContext.UpdateGraphicsDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="{Binding ToolName, StringFormat='Open {0} or start setup if missing'}"
                                                            AutomationProperties.Name="{Binding ToolName, StringFormat='Open {0}'}"
                                                            IsEnabled="{Binding DataContext.CanCheckForUpdates, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Open" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource UpdateSection}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AppUpdateResults.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="App update results" Style="{StaticResource UpdateTitle}"/>
                        <TextBlock Text="{Binding LastAppUpdate, TargetNullValue=''}" Style="{StaticResource OptionalUpdateText}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding AppUpdateResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource UpdateRow}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource UpdateTitle}" FontSize="13"/>
                                            <TextBlock Style="{StaticResource UpdateText}">
                                                <Run Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Detail, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Expander x:Name="WindowsGroup" Style="{StaticResource UpdateGroup}" AutomationProperties.Name="Windows"
                              Header="{Binding WindowsUpdateSummary}" Grid.Row="0" KeyboardNavigation.TabIndex="0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding WindowsUpdates}" ItemTemplate="{StaticResource CatalogUpdateRow}"/>
                            <Button Content="Open Windows Update" Style="{StaticResource UpdateAction}" HorizontalAlignment="Left"
                                    Command="{Binding OpenWindowsUpdateSettingsCommand}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="AppsGroup" Style="{StaticResource UpdateGroup}" AutomationProperties.Name="Apps (WinGet)"
                              Header="{Binding AppUpdateSummary}" Grid.Row="1" KeyboardNavigation.TabIndex="1">
                        <StackPanel>
                            <ItemsControl x:Name="AppUpdateRows" ItemsSource="{Binding AppUpdates}" IsEnabled="{Binding CanReviewAppUpdates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource UpdateRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                                          AutomationProperties.Name="{Binding Name, StringFormat='Select {0} update'}"
                                                          VerticalAlignment="Top" Margin="0,2,10,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource UpdateTitle}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource UpdateText}"/>
                                                    <TextBlock Text="{Binding SelectionNote, TargetNullValue=''}" Style="{StaticResource OptionalUpdateText}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Update selected apps" Style="{StaticResource PrimaryUpdateAction}"
                                        Command="{Binding UpgradeSelectedAppsCommand}" IsEnabled="{Binding CanUpgradeSelectedApps}"/>
                                <Button Content="Open Microsoft Store updates" Style="{StaticResource UpdateAction}"
                                        Command="{Binding OpenStoreUpdatesCommand}"/>
                            </WrapPanel>
                            <Expander Style="{StaticResource UpdateGroup}" AutomationProperties.Name="Bulk upgrade"
                                      Header="" Tag="{x:Null}" Padding="8,6" Margin="0,4,0,0" Background="{DynamicResource CardBackgroundBrush}">
                                <StackPanel>
                                    <TextBlock Text="WinGet chooses all eligible apps when the upgrade starts." Style="{StaticResource UpdateText}"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Update all eligible apps" Style="{StaticResource UpdateAction}"
                                                Command="{Binding UpgradeAllAppsCommand}" IsEnabled="{Binding CanUpgradeAllApps}"/>
                                        <CheckBox IsChecked="{Binding IncludeUnknownAppVersions, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanUpgradeAllApps}"
                                                  Foreground="{DynamicResource PrimaryTextBrush}" Margin="4,6,0,8">
                                            <TextBlock Text="Include unknown installed versions" TextWrapping="Wrap"/>
                                        </CheckBox>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="DriversGroup" AutomationProperties.Name="Optional drivers" Header="{Binding DeviceUpdateSummary}">
                        <Expander.Style>
                            <Style TargetType="Expander" BasedOn="{StaticResource UpdateGroup}">
                                <Setter Property="Grid.Row" Value="2"/>
                                <Setter Property="KeyboardNavigation.TabIndex" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="Grid.Row" Value="3"/>
                                        <Setter Property="KeyboardNavigation.TabIndex" Value="3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding DeviceUpdates}" ItemTemplate="{StaticResource CatalogUpdateRow}"/>
                            <Button Content="Open Windows Optional Updates" Style="{StaticResource UpdateAction}" HorizontalAlignment="Left"
                                    Command="{Binding OpenWindowsOptionalUpdatesCommand}"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="FirmwareGroup" AutomationProperties.Name="BIOS and UEFI firmware" Header="{Binding FirmwareCheckStatus}">
                        <Expander.Style>
                            <Style TargetType="Expander" BasedOn="{StaticResource UpdateGroup}">
                                <Setter Property="Grid.Row" Value="3"/>
                                <Setter Property="KeyboardNavigation.TabIndex" Value="3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="Grid.Row" Value="2"/>
                                        <Setter Property="KeyboardNavigation.TabIndex" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding FirmwareInfo.SystemModel, StringFormat='System: {0}'}" Style="{StaticResource UpdateText}"/>
                            <TextBlock Text="{Binding FirmwareInfo.BiosVersion, StringFormat='BIOS version: {0}'}" Style="{StaticResource UpdateText}"/>
                            <TextBlock Text="{Binding FirmwareInfo.BiosReleaseDate, StringFormat='BIOS release: {0}'}" Style="{StaticResource UpdateText}"/>
                            <TextBlock Text="{Binding FirmwareInfo.MotherboardProduct, StringFormat='Motherboard: {0}'}" Style="{StaticResource UpdateText}"/>
                            <TextBlock Text="{Binding FirmwareInfo.UefiStatus, StringFormat='Boot mode: {0}'}" Style="{StaticResource UpdateText}"/>
                            <TextBlock Text="{Binding FirmwareInfo.SecureBootStatus, StringFormat='Secure Boot: {0}'}" Style="{StaticResource UpdateText}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Open BIOS vendor support" Style="{StaticResource UpdateAction}"
                                        Command="{Binding OpenVendorBiosPortalCommand}"/>
                                <Button Content="Check for BIOS updates" Style="{StaticResource UpdateAction}"
                                        IsEnabled="{Binding CanCheckForUpdates}" Command="{Binding CheckFirmwareUpdatesCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
