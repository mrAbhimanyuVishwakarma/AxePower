<UserControl x:Class="AxePower.App.Views.SystemDoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SystemDoctorViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent"
             AutomationProperties.Name="System Doctor &amp; Maintenance">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tab RadioButton Style -->
        <Style x:Key="DoctorTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource ElevatedCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Tab Switcher -->
            <RowDefinition Height="*"/>     <!-- Active Tab Content -->
        </Grid.RowDefinitions>

        <!-- ─── 1. Header ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="40,24,40,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="System Doctor &amp; Maintenance" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Automated Windows health repair, shader/junk cache cleaner, and low-latency gaming DNS benchmark."
                           FontSize="13.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Grid>

        <!-- ─── 2. Segmented Tab Switcher ───────────────────────────────────── -->
        <Border Grid.Row="1" Padding="40,0,40,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="🩺 Health &amp; Repairs" Style="{StaticResource DoctorTabStyle}"
                             IsChecked="True" Command="{Binding SetTabCommand}" CommandParameter="Doctor" Margin="0,0,10,0"/>
                <RadioButton Content="🧹 Junk &amp; Shader Cleaner" Style="{StaticResource DoctorTabStyle}"
                             Command="{Binding SetTabCommand}" CommandParameter="Cleaner" Margin="0,0,10,0"/>
                <RadioButton Content="🌐 Low-Latency DNS Switcher" Style="{StaticResource DoctorTabStyle}"
                             Command="{Binding SetTabCommand}" CommandParameter="Dns" Margin="0,0,10,0"/>
            </StackPanel>
        </Border>

        <!-- ─── 3. Tab Contents ─────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="40,0,40,24">

            <!-- TAB A: Health & Repairs (SFC, DISM, WinGet, Network) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Doctor">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Diagnostic Buttons Toolbar -->
                <Border Grid.Row="0" Margin="0,0,0,14">
                    <WrapPanel Orientation="Horizontal">
                        <!-- SFC Scan -->
                        <Button Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding RunSfcScanCommand}"
                                IsEnabled="{Binding IsDiagnosticRunning, Converter={x:Null}}"
                                ToolTip="Run System File Checker to scan and repair corrupted Windows system files"
                                Padding="16,9" FontSize="13" Margin="0,0,10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SFC Health Scan" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- DISM Repair -->
                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding RunDismRepairCommand}"
                                ToolTip="Restore Windows Component Store health using DISM"
                                Padding="16,9" FontSize="13" Margin="0,0,10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="DISM Component Repair" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- WinGet Reset -->
                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding RunWinGetResetCommand}"
                                ToolTip="Reset and repair corrupted WinGet package sources"
                                Padding="16,9" FontSize="13" Margin="0,0,10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="WinGet Catalog Reset" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Network Reset -->
                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding RunNetworkResetCommand}"
                                ToolTip="Reset Winsock, TCP/IP stack, and flush DNS cache to fix network lag"
                                Padding="16,9" FontSize="13" Margin="0,0,10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Network Stack Reset" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Cancel -->
                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding CancelDiagnosticCommand}"
                                Visibility="{Binding IsDiagnosticRunning, Converter={StaticResource BoolToVis}}"
                                Padding="14,9" FontSize="13" Margin="0,0,10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cancel Task" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Clear Log -->
                        <Button Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding ClearConsoleCommand}"
                                Padding="12,9" FontSize="13" Margin="0,0,10,6">
                            <TextBlock Text="Clear Log" VerticalAlignment="Center"/>
                        </Button>
                    </WrapPanel>
                </Border>

                <!-- Live Terminal Console Box -->
                <Border Grid.Row="1" Background="#0F172A" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Console Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0"/>
                                <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0"/>
                                <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,12,0"/>
                                <TextBlock Text="Diagnostics Terminal Output" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                            </StackPanel>

                            <TextBlock Grid.Column="0" HorizontalAlignment="Right" Text="{Binding DiagnosticStatusText}"
                                       Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"
                                       Visibility="{Binding IsDiagnosticRunning, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <!-- Scrollable Log Output -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding ConsoleLogs, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#38BDF8"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="12.5"
                                     TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB B: Junk & Shader Cleaner -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Cleaner">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Cleaner Action Card -->
                    <RowDefinition Height="*"/>     <!-- Categories List -->
                </Grid.RowDefinitions>

                <!-- Top Space Summary Banner -->
                <Border Grid.Row="0" Background="{DynamicResource ElevatedCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24,18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Total Cleanable Cache Space" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding FormattedTotalScanned}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding CleanSummaryText}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Analyze Button -->
                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding AnalyzeCacheCommand}"
                                    ToolTip="Scan all temp and shader cache folders"
                                    Padding="18,10" FontSize="13" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Re-Scan Caches" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Clean Button -->
                            <Button Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding CleanCacheCommand}"
                                    ToolTip="Safely delete selected temporary files and DirectX shader cache"
                                    Padding="22,10" FontSize="13">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clean Selected Caches" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Categories Breakdown Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CacheCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Selection Checkbox -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding DirectoryPath}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7"/>
                                        </StackPanel>

                                        <!-- Size Tag -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FormattedSize}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- TAB C: Low-Latency DNS Optimizer -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Dns">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Benchmark Toolbar -->
                    <RowDefinition Height="*"/>     <!-- DNS Cards List -->
                </Grid.RowDefinitions>

                <!-- DNS Benchmark Actions -->
                <Border Grid.Row="0" Background="{DynamicResource ElevatedCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24,18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Active Adapter: " FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding ActiveAdapterName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DnsStatusText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Reset DHCP -->
                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding ResetDhcpCommand}"
                                    ToolTip="Restore Automatic DHCP DNS assigned by router"
                                    Padding="16,10" FontSize="13" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Restore Automatic (DHCP)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Benchmark Ping -->
                            <Button Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding BenchmarkDnsCommand}"
                                    ToolTip="Ping each DNS provider to measure live latency and identify fastest ping"
                                    Padding="20,10" FontSize="13">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Run Ping Benchmark" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DNS Provider Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DnsProviders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="22,16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Provider info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>

                                                <!-- Fastest Badge -->
                                                <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsFastest, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="⚡ FASTEST PING" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                                                </Border>

                                                <!-- Active Badge -->
                                                <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="✓ ACTIVE" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PrimaryIpv4, StringFormat='Primary: {0}'}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,16,0"/>
                                                <TextBlock Text="{Binding SecondaryIpv4, StringFormat='Secondary: {0}'}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Ping Latency Badge -->
                                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="14,8" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Ping" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding FormattedLatency}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Apply Button -->
                                        <Button Grid.Column="2"
                                                Style="{DynamicResource PrimaryButtonStyle}"
                                                Command="{Binding DataContext.ApplyDnsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="16,8" FontSize="13" VerticalAlignment="Center">
                                            <TextBlock Text="Apply DNS" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
