<UserControl x:Class="AxePower.App.Views.SystemOptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SystemOptimizerViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent"
             AutomationProperties.Name="System Optimizer">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Filter chip style -->
        <Style x:Key="OptimizerFilterChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource ElevatedCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header & Stats -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar & Actions -->
            <RowDefinition Height="Auto"/>  <!-- Search & Category Filter -->
            <RowDefinition Height="Auto"/>  <!-- Status Notice / Busy Bar -->
            <RowDefinition Height="*"/>     <!-- Tweaks Scrollable Cards List -->
            <RowDefinition Height="69"/>    <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ─── 1. Header & Overview ────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="40,24,40,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="System Optimizer &amp; Debloat" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Safe Windows tweaks, background telemetry debloat, and gamer latency optimizations."
                           FontSize="13.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <!-- Stats Badge Card -->
            <Border Grid.Column="1" Background="{DynamicResource ElevatedCardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Applied" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}">
                            <Run Text="{Binding AppliedCount, Mode=OneWay}"/>
                            <Run Text="/" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Width="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2,18,2"/>
                    <StackPanel>
                        <TextBlock Text="Recommended" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RecommendedCount, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ─── 2. Action Toolbar ───────────────────────────────────────────── -->
        <Border Grid.Row="1" Padding="40,0,40,14">
            <WrapPanel Orientation="Horizontal">
                <!-- Apply All Recommended -->
                <Button Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding ApplyAllRecommendedCommand}"
                        ToolTip="Create Restore Point and apply all recommended safe optimizations in 1 click"
                        AutomationProperties.Name="Apply all recommended tweaks"
                        Padding="18,9" FontSize="13" Margin="0,0,10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Apply Recommended" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Revert All -->
                <Button Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding RevertAllCommand}"
                        ToolTip="Revert applied tweaks back to standard Windows defaults"
                        AutomationProperties.Name="Revert all tweaks to default"
                        Padding="16,9" FontSize="13" Margin="0,0,10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Revert All to Default" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Create Restore Point -->
                <Button Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding CreateRestorePointCommand}"
                        ToolTip="Create a Windows System Restore point before modifying settings"
                        AutomationProperties.Name="Create System Restore Point"
                        Padding="16,9" FontSize="13" Margin="0,0,10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Create Restore Point" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Refresh -->
                <Button Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding RefreshStatusCommand}"
                        ToolTip="Re-read live Windows Registry states"
                        AutomationProperties.Name="Refresh tweak states"
                        Padding="14,9" FontSize="13" Margin="0,0,10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh Status" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- ─── 3. Search & Filter Bar ──────────────────────────────────────── -->
        <Border Grid.Row="2" Padding="40,0,40,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Border Grid.Column="0" Background="{DynamicResource ElevatedCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10,6" Margin="0,0,16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"
                                 VerticalAlignment="Center" AutomationProperties.Name="Search tweaks"/>
                    </Grid>
                </Border>

                <!-- Filter Chips -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="All Tweaks" Style="{StaticResource OptimizerFilterChipStyle}"
                                 IsChecked="True" Command="{Binding SetCategoryCommand}" CommandParameter="All" Margin="0,0,8,0"/>
                    <RadioButton Content="🛡️ Privacy &amp; Telemetry" Style="{StaticResource OptimizerFilterChipStyle}"
                                 Command="{Binding SetCategoryCommand}" CommandParameter="Privacy" Margin="0,0,8,0"/>
                    <RadioButton Content="🎮 Gaming &amp; Latency" Style="{StaticResource OptimizerFilterChipStyle}"
                                 Command="{Binding SetCategoryCommand}" CommandParameter="Gaming" Margin="0,0,8,0"/>
                    <RadioButton Content="⚙️ Windows 11 QoL" Style="{StaticResource OptimizerFilterChipStyle}"
                                 Command="{Binding SetCategoryCommand}" CommandParameter="Windows11" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ─── 4. Busy Indicator Banner ────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="40,0,40,12" Background="{DynamicResource CardHoverBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding BusyStatusText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ─── 5. Tweaks Cards List ────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,0,40,24">
            <ItemsControl ItemsSource="{Binding FilteredTweaks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left content -->
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <!-- Title -->
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        
                                        <!-- Category Tag -->
                                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryDisplayName}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Recommended Badge -->
                                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Recommended" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>

                                <!-- Right Toggle & Status -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <TextBlock Text="Applied" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,12,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="Default" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApplied}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Switch -->
                                    <CheckBox Style="{DynamicResource ToggleSwitchStyle}"
                                              IsChecked="{Binding IsApplied, Mode=OneWay}"
                                              Command="{Binding ToggleCommand}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Title}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ─── 6. Bottom Status Bar ────────────────────────────────────────── -->
        <Border Grid.Row="5" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="32" Height="32" Margin="0,0,16,0">
                        <Ellipse Fill="{DynamicResource ElevatedCardBackgroundBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" />
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="System Optimizer Active" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock Text="Privacy debloating, Windows telemetry reduction, and gaming responsiveness." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
