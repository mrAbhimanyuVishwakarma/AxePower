<UserControl x:Class="AxePower.App.Views.AccountDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AxePower.App.Converters">

    <!-- The account dialog: one glass card over the dimmed app, whose form follows AccountViewModel.Mode.
         Colours come only from skin brushes, so it follows every skin. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="2,14,0,6"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="frame" Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <!-- No padding here: a TextBox applies its own Padding inside the text area -->
                            <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldPassword" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="frame" Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9">
                            <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Return" Command="{Binding SubmitCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseDialogCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <!-- Backdrop: a click outside closes, as with the other dialogs -->
        <Border Background="#CC0A0D14">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDialogCommand}"/>
            </Border.InputBindings>
        </Border>

        <Border Width="440" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="18" Padding="32,28,32,26" Effect="{DynamicResource CardShadowEffect}">
            <Grid>
                <!-- Close -->
                <Button Command="{Binding CloseDialogCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-14,0"
                        Cursor="Hand" ToolTip="Close" AutomationProperties.Name="Close">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Width="30" Height="30" CornerRadius="15" Background="Transparent">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel>
                    <!-- Header -->
                    <Image Source="{DynamicResource AppIconImage}" Width="40" Height="40" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding DialogSubtitle}" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,4"/>

                    <!-- Check your inbox -->
                    <StackPanel Visibility="{Binding IsCheckEmailMode, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                        <Grid Width="56" Height="56" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding CheckEmailMessage}" FontSize="13.5" Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" LineHeight="20"/>
                        <TextBlock Text="Not there? Check your spam folder." FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenSignInCommand}"
                                Margin="0,20,0,0" Padding="0,11" FontSize="14">
                            <TextBlock Text="Back to sign in"/>
                        </Button>
                    </StackPanel>

                    <!-- Delete confirmation -->
                    <StackPanel Visibility="{Binding IsConfirmDeleteMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Type DELETE to confirm"/>
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding DeleteConfirmation, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Type DELETE to confirm"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSignInMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsSignUpMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsForgotMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Email"/>
                        <TextBox x:Name="EmailBox" Style="{StaticResource FieldBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Email"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Visibility="{Binding ShowsPasswordField, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Password"/>
                            <Button Style="{StaticResource LinkButton}" Content="Forgot password?" Command="{Binding OpenForgotPasswordCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,6"
                                    Visibility="{Binding IsSignInMode, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource FieldPassword}" PasswordChanged="OnPasswordChanged"
                                     AutomationProperties.Name="Password"/>
                        <TextBlock Text="At least 8 characters." FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="2,6,0,0"
                                   Visibility="{Binding IsSignUpMode, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Username and display name -->
                    <StackPanel Visibility="{Binding ShowsUsernameField, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Username"/>
                        <Grid>
                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="27,9,12,9" MaxLength="21" AutomationProperties.Name="Username"/>
                            <TextBlock Text="@" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" Margin="13,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock Text="{Binding UsernameHint}" FontSize="11.5" TextWrapping="Wrap" Margin="2,6,0,0"
                                   Visibility="{Binding HasUsernameHint, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUsernameHintGood}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Display name"/>
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="32" AutomationProperties.Name="Display name"/>
                        <TextBlock Text="Shown in the sidebar and to friends. Leave empty to use your username." FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,6,0,0"
                                   Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>

                    <!-- Error -->
                    <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0" CornerRadius="10" Padding="12,9"
                            BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ErrorBrush}"
                                       VerticalAlignment="Top" Margin="0,2,8,0"/>
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="12.5" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" MaxWidth="330"/>
                        </StackPanel>
                    </Border>

                    <!-- Main action, one per form -->
                    <Grid Margin="0,20,0,0" Visibility="{Binding IsCheckEmailMode, Converter={StaticResource InverseBoolToVis}}">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SubmitSignInCommand}"
                                IsEnabled="{Binding IsIdle}" Padding="0,11" FontSize="14"
                                Visibility="{Binding IsSignInMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Sign in"/>
                        </Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SubmitSignUpCommand}"
                                IsEnabled="{Binding IsIdle}" Padding="0,11" FontSize="14"
                                Visibility="{Binding IsSignUpMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Create account"/>
                        </Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SubmitForgotPasswordCommand}"
                                IsEnabled="{Binding IsIdle}" Padding="0,11" FontSize="14"
                                Visibility="{Binding IsForgotMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Send reset link"/>
                        </Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SubmitChooseUsernameCommand}"
                                IsEnabled="{Binding IsIdle}" Padding="0,11" FontSize="14"
                                Visibility="{Binding IsChooseUsernameMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Continue"/>
                        </Button>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SubmitEditProfileCommand}"
                                IsEnabled="{Binding IsIdle}" Padding="0,11" FontSize="14"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Save"/>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding ConfirmDeleteCommand}"
                                IsEnabled="{Binding IsIdle}" Padding="0,11" FontSize="14"
                                Visibility="{Binding IsConfirmDeleteMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Delete my account"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Working..." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <!-- Switch between forms -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"
                                Visibility="{Binding IsSignInMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="New to AxePower? " FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Style="{StaticResource LinkButton}" Content="Create an account" Command="{Binding OpenSignUpCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"
                                Visibility="{Binding IsSignUpMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Already have an account? " FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button Style="{StaticResource LinkButton}" Content="Sign in" Command="{Binding OpenSignInCommand}"/>
                    </StackPanel>
                    <Button Style="{StaticResource LinkButton}" Content="Back to sign in" Command="{Binding OpenSignInCommand}"
                            HorizontalAlignment="Center" Margin="0,16,0,0"
                            Visibility="{Binding IsForgotMode, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
