<UserControl x:Class="AxePower.App.Views.PhoneHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PhoneHubViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent"
             AutomationProperties.Name="Phone Control">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tab RadioButton Style -->
        <Style x:Key="HubTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource ElevatedCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#090D16"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Tab Switcher -->
            <RowDefinition Height="*"/>     <!-- Active Content Scroll -->
        </Grid.RowDefinitions>

        <!-- ─── 1. Header ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="40,24,40,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Phone Control" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="All-in-one mobile suite: screen mirroring, Wi-Fi LAN drop file sharing, and remote companion controls."
                           FontSize="13.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>

            <!-- Green SpaceDesk Button (Click to Open or Install) -->
            <Button Grid.Column="1" Command="{Binding SpaceDeskActionCommand}"
                    Background="#10B981" Foreground="#FFFFFF" BorderThickness="0"
                    Padding="18,10" Cursor="Hand" VerticalAlignment="Center"
                    ToolTip="SpaceDesk: Turn phone/tablet into a secondary display (Click to Open if installed, or Install)">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SpaceDesk" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ─── 2. Segmented Tab Switcher ───────────────────────────────────── -->
        <Border Grid.Row="1" Padding="40,0,40,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="📂 LAN Drop (Wi-Fi Share)" Style="{StaticResource HubTabStyle}"
                             IsChecked="True" Command="{Binding SetTabCommand}" CommandParameter="LanDrop" Margin="0,0,10,0"/>
                <RadioButton Content="📱 Screen Mirror &amp; Control (scrcpy)" Style="{StaticResource HubTabStyle}"
                             Command="{Binding SetTabCommand}" CommandParameter="ScreenMirror" Margin="0,0,10,0"/>
            </StackPanel>
        </Border>

        <!-- ─── 3. Content Area ─────────────────────────────────────────────── -->
        <Grid Grid.Row="2">

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- TAB 1: LAN Drop                                                 -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="LanDrop">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,0,36,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="320" MaxWidth="460"/>
                            <ColumnDefinition Width="3*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Connection Card & QR -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <Border Style="{DynamicResource CardElevatedStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📱 Connect Phone / Device" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ToggleServerCommand}" Padding="14,6">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Start Server"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                                <Setter Property="Text" Value="Stop Server"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="Scan this QR code with your phone camera or browser on the same Wi-Fi network to transfer files instantly."
                                               FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,14"/>

                                    <!-- QR Code Container -->
                                    <Border Background="#090D16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="16" Height="210" Margin="0,0,0,14" Padding="12">
                                        <Grid>
                                            <Image Source="{Binding QrCodeImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="Server Offline" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Click 'Start Server' to generate QR" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Direct URL Box -->
                                    <TextBlock Text="Local Server URL:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,12">
                                        <TextBox Text="{Binding ServerUrl, Mode=OneWay}" IsReadOnly="True"
                                                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                 BorderBrush="{DynamicResource CardBorderBrush}" Padding="10,8" FontSize="12" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                            <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CopyServerUrlCommand}" ToolTip="Copy URL" Padding="8,4" Margin="0,0,4,0">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                            </Button>
                                            <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenInBrowserCommand}" ToolTip="Open in Browser" Padding="8,4">
                                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Network Adapter & Port -->
                                    <TextBlock Text="Network Adapter / IP Address:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding AvailableIpAddresses}" SelectedItem="{Binding SelectedIpAddress}"
                                              Margin="0,0,0,12" Padding="8,6" FontSize="12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Port Number:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding PortNumber, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                                 Padding="6,4" FontSize="12" TextAlignment="Center" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>

                                    <!-- Instruction Tip -->
                                    <Border Background="#131B2A" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Ensure both PC and phone are connected to the same Wi-Fi router or mobile hotspot."
                                                       FontSize="11.5" LineHeight="16" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Share, Received & Clipboard -->
                        <StackPanel Grid.Column="1">
                            <!-- Share to Mobile -->
                            <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📤 Share to Mobile &amp; Other Devices" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SharedCount}" FontSize="11" FontWeight="Bold" Foreground="#090D16"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Files queued here can be downloaded instantly by any connected phone." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ClearSharedFilesCommand}"
                                                    Margin="0,0,8,0" Padding="10,6" ToolTip="Clear shared list">
                                                <TextBlock Text="Clear All" FontSize="12"/>
                                            </Button>
                                            <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding AddFilesToShareCommand}" Padding="12,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Add Files" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Shared Files List -->
                                    <ItemsControl ItemsSource="{Binding SharedFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                                                                Command="{Binding DataContext.RemoveSharedFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Padding="8,4">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#EF4444"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty Shared Placeholder -->
                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="16" Background="#0C111C">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSharedFiles}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="No files queued for mobile download. Click '+ Add Files' above." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Received Files from Mobile -->
                            <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📥 Received Files from Devices" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <Border Background="#10B981" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ReceivedCount}" FontSize="11" FontWeight="Bold" Foreground="#090D16"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Files dropped from mobile phones to this PC are stored in your Downloads folder." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenSaveDirectoryCommand}" Margin="0,0,6,0" Padding="10,6" ToolTip="Open downloads folder">
                                                <TextBlock Text="Open Folder" FontSize="12"/>
                                            </Button>
                                            <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ClearReceivedFilesCommand}" Padding="10,6">
                                                <TextBlock Text="Clear" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Received Files List -->
                                    <ItemsControl ItemsSource="{Binding ReceivedFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                                                                <Run Text="{Binding FormattedSize}"/>
                                                                <Run Text=" • From "/>
                                                                <Run Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.OpenReceivedFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" Padding="8,4" Margin="0,0,4,0">
                                                                <TextBlock Text="Open" FontSize="11"/>
                                                            </Button>
                                                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.ShowReceivedFileInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" Padding="8,4" Margin="0,0,4,0">
                                                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                                            </Button>
                                                            <Button Style="{DynamicResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.DeleteReceivedFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" Padding="8,4">
                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#EF4444"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty Received Placeholder -->
                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="16" Background="#0C111C">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasReceivedFiles}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="No files received yet. Scan the QR code with your phone and drop files." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Quick Text Drop -->
                            <Border Style="{DynamicResource CardElevatedStyle}">
                                <StackPanel>
                                    <TextBlock Text="📋 Quick Text &amp; Clipboard Drop" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Send notes, OTP codes, or links between your PC and phone instantly." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding QuickTextInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                 BorderBrush="{DynamicResource CardBorderBrush}" Padding="10,8" FontSize="12.5" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SendQuickTextCommand}" Padding="14,8">
                                            <TextBlock Text="Send to Phone" FontWeight="SemiBold" FontSize="12"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding ClipboardMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Content}" FontSize="12.5" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}">
                                                                <Run Text="{Binding SenderDevice}"/>
                                                                <Run Text=" • "/>
                                                                <Run Text="{Binding Timestamp, StringFormat=HH:mm:ss}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                                                                Command="{Binding DataContext.CopyMessageTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Padding="6,3">
                                                            <TextBlock Text="Copy" FontSize="11"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- TAB 2: Android Screen Control (scrcpy)                           -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="ScreenMirror">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,0,36,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="340" MaxWidth="460"/>
                            <ColumnDefinition Width="3*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Devices & 1-Click Launch -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <!-- Device Detection Card -->
                            <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📱 Connected Devices" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding RefreshDevicesCommand}" Padding="8,4" ToolTip="Scan for ADB devices">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Scan" FontSize="11.5"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Device Selector ComboBox -->
                                    <ComboBox ItemsSource="{Binding ConnectedDevices}" SelectedItem="{Binding SelectedDevice}"
                                              Margin="0,0,0,14" Padding="8,6" FontSize="13">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Model}" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" (" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <TextBlock Text="{Binding Serial}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <TextBlock Text=")" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Big Launch Button -->
                                    <Button Command="{Binding LaunchScrcpyCommand}" Style="{DynamicResource PrimaryButtonStyle}" Padding="16,12" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Launch Screen Mirroring" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Wireless ADB Connect Box -->
                                    <TextBlock Text="Connect Wirelessly (IP:Port):" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding WirelessIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                 BorderBrush="{DynamicResource CardBorderBrush}" Padding="8,6" FontSize="12"
                                                 ToolTip="e.g. 192.168.1.50:5555" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ConnectWirelessAdbCommand}" Padding="10,6">
                                            <TextBlock Text="Connect" FontSize="12"/>
                                        </Button>
                                    </Grid>

                                    <!-- Direct APK Installer -->
                                    <Border Background="#0C111C" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="📦 Install APK to Phone" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="Directly sideload any APK package onto your connected device." FontSize="11.5" LineHeight="16" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <Button Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding InstallApkCommand}" Padding="10,6">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Choose APK File..." FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Presets & Controls -->
                        <StackPanel Grid.Column="1">
                            <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="⚙️ Mirroring &amp; Performance Presets" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Resolution Limit" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Lower resolution reduces latency and Wi-Fi bandwidth." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableResolutions}" SelectedItem="{Binding SelectedResolution}" Padding="8,6" FontSize="12"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Max Frame Rate" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Cap framerate for smoother streaming." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFps}" SelectedItem="{Binding SelectedFps}" Padding="8,6" FontSize="12"/>
                                    </Grid>

                                    <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,8,0,14"/>

                                    <!-- Toggles -->
                                    <CheckBox IsChecked="{Binding StayAwake}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Keep Phone Awake (--stay-awake)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Prevents phone from locking or going to sleep while mirrored." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding TurnScreenOff}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Turn Screen OFF on Phone (--turn-screen-off)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Saves phone battery &amp; reduces thermals while keeping PC mirror active." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding ForwardAudio}">
                                        <StackPanel>
                                            <TextBlock Text="Forward Audio to PC" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Routes Android sound directly through PC speakers/headphones." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- Keyboard Shortcuts Card -->
                            <Border Style="{DynamicResource CardElevatedStyle}">
                                <StackPanel>
                                    <TextBlock Text="⌨️ Scrcpy Shortcuts &amp; Tips" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ctrl + F" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Toggle Fullscreen Mirror" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ctrl + H" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Press Android Home button" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ctrl + B / Right Click" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Press Android Back button" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Drag &amp; Drop APK" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Drop any .apk on mirror window to install" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
