<UserControl x:Class="AxePower.App.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DebloatViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent"
             AutomationProperties.Name="Debloat Hub">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Custom Tooltip Style for Info (i) Hover View -->
        <Style x:Key="DebloatCreditTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ElevatedCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Info (i) Button Style -->
        <Style x:Key="DebloatInfoCircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <TextBlock Text="&#xE946;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circleBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="circleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="32,16,32,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Page Header -->
                <RowDefinition Height="Auto"/> <!-- Status / Progress Notice -->
                <RowDefinition Height="Auto"/> <!-- Tools Stack -->
            </Grid.RowDefinitions>

            <!-- ─── 1. Header & Actions ────────────────────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Debloat &amp; Windows Tools" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Trusted tools to clean up unwanted apps, protect your privacy, and keep Windows running smoothly."
                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Header Actions: Restore Point & Admin Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Create Restore Point Button -->
                    <Button Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding CreateRestorePointCommand}"
                            ToolTip="Create a Windows System Restore point before running any debloat script"
                            Padding="12,6" FontSize="12" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Create Restore Point" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Elevation Status Pill -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="10,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="UAC Elevated" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ─── 2. Status / Progress Notice (When creating restore point) ─── -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ElevatedCardBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,6"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsCreatingRestorePoint, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding RestorePointStatus}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ─── 3. Tools Cards Stack (Fits without scroll) ─────────────────── -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Tools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,12"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Top Row: Launch Button + (i) Info Hover View only -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Launch Button -->
                                    <Button Style="{DynamicResource PrimaryButtonStyle}"
                                            Command="{Binding DataContext.LaunchToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Height="34"
                                            Padding="18,0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Margin="0,0,10,0"
                                            ToolTip="Launch this tool with elevated administrator privileges">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding LaunchButtonTitle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- (i) Info Button with Hover View (Creator Details) & Click (Opens GitHub) -->
                                    <Button Style="{StaticResource DebloatInfoCircleButtonStyle}"
                                            Command="{Binding DataContext.OpenCreditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding CreditUrl}"
                                            ToolTipService.InitialShowDelay="50"
                                            ToolTipService.BetweenShowDelay="0"
                                            ToolTipService.ShowDuration="15000">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource DebloatCreditTooltipStyle}">
                                                <StackPanel MaxWidth="300">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CreditLabel}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding Tagline}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2,0,5"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Click to open GitHub repository" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>

                                <!-- Lower Box: Description Panel -->
                                <Border Background="Transparent"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,8,0,0">
                                    <StackPanel>
                                        <!-- Header: Description - Tagline -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Description" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text=" — " FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Tagline}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Description Text -->
                                        <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   LineHeight="17"
                                                   Margin="0,0,0,6"/>

                                        <!-- Highlights -->
                                        <ItemsControl ItemsSource="{Binding Highlights}" Margin="0,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Command preview strip -->
                                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="10,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Script: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CommandPreview}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                <Button Grid.Column="2"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.CopyCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding CommandPreview}"
                                                        ToolTip="Copy script command to clipboard"
                                                        Padding="8,3"
                                                        FontSize="11">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Copy" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
