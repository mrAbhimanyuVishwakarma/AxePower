<UserControl x:Class="AxePower.App.Views.Music.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:music="clr-namespace:AxePower.App.ViewModels.Music"
             xmlns:helpers="clr-namespace:AxePower.App.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance music:MusicViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent"
             Focusable="True"
             AutomationProperties.Name="Music">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ─── Header ─── -->
        <Grid Grid.Row="0" Margin="40,24,40,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="Music" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Play your music files with gapless playback, media keys and taskbar controls. Drop files anywhere on this page."
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <!-- Spotify Green Button: Open & minimize + control -->
                <Button Style="{StaticResource SpotifyButtonStyle}" Command="{Binding LaunchAndMinimizeSpotifyCommand}" Margin="0,0,8,0"
                        ToolTip="Launch Spotify minimized &amp; control playback" AutomationProperties.Name="Spotify">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Spotify" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- YouTube Music Free In-App Streaming -->
                <Button Style="{StaticResource YouTubeMusicButtonStyle}" Command="{Binding SearchYouTubeCommand}" Margin="0,0,8,0"
                        ToolTip="Stream YouTube Music In-App (Free, No Browser)" AutomationProperties.Name="YouTube Music">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FF0000" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="YT Music" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Music Settings Button ("*" Gear Icon) -->
                <Button Style="{StaticResource MusicIconButtonStyle}" Width="38" Height="38" Content="&#xE713;"
                        Command="{Binding ToggleMusicSettingsCommand}" Margin="0,0,8,0"
                        ToolTip="Music Settings (Configure Library &amp; Playlist storage path)" AutomationProperties.Name="Music Settings" />

                <!-- Queue / Playlist Toggle Button ("=" Icon) -->
                <ToggleButton Style="{StaticResource MusicIconButtonStyle}" Width="38" Height="38" Content="&#xE8FD;"
                              IsChecked="{Binding IsQueueOpen, Mode=TwoWay}"
                              ToolTip="{Binding QueueToggleLabel}" AutomationProperties.Name="{Binding QueueToggleLabel}" />
            </StackPanel>
        </Grid>

        <!-- ─── Body ─── -->
        <Grid Grid.Row="1" Margin="40,0,40,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ─── Pinned Player & Search (Never scrolls out of view) ─── -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <!-- Now Playing: glass card controlling Local, YouTube Music & Spotify -->
                    <Border x:Name="NowPlayingCard" Style="{StaticResource MusicGlassCardStyle}" Padding="24"
                            DataContext="{Binding NowPlaying}" AutomationProperties.Name="Now playing">
                        <Grid>
                            <Border CornerRadius="16" Margin="-24" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#14FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.5" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Artwork -->
                                <Border Grid.Column="0" Style="{StaticResource MusicArtFrameStyle}" Width="200" Height="200" CornerRadius="14" Margin="0,0,28,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000" />
                                    </Border.Effect>
                                    <Grid>
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="56" Foreground="#E6FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVis}}" />
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                               AutomationProperties.Name="Album cover" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- Spotify Mode Badge in Main Player -->
                                    <Border Background="#221DB954" BorderBrush="#551DB954" BorderThickness="1" CornerRadius="6"
                                            Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8"
                                            Visibility="{Binding IsSpotifyMode, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#1DB954" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Spotify (Streaming Minimized)" FontSize="11.5" FontWeight="SemiBold" Foreground="#1DB954" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    <TextBlock Text="{Binding ArtistAndAlbum}" FontSize="13.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,18"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ArtistAndAlbum}" />

                                    <!-- Seek -->
                                    <Slider Style="{StaticResource MusicSliderStyle}"
                                            Minimum="0" Maximum="{Binding SeekMaximum}" Value="{Binding PositionSeconds, Mode=TwoWay}"
                                            SmallChange="5" LargeChange="5" IsEnabled="{Binding HasCurrent}"
                                            helpers:MusicSeekBehavior.IsEnabled="True"
                                            AutomationProperties.Name="Seek" AutomationProperties.HelpText="Arrow keys move 5 seconds" />
                                    <Grid Margin="0,2,0,10">
                                        <TextBlock Text="{Binding PositionText}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding DurationText}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Transport -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ToggleButton Style="{StaticResource MusicIconButtonStyle}" Content="&#xE8B1;"
                                                      IsChecked="{Binding IsShuffle, Mode=TwoWay}"
                                                      ToolTip="{Binding ShuffleLabel}" AutomationProperties.Name="{Binding ShuffleLabel}" />
                                        <Button Style="{StaticResource MusicIconButtonStyle}" Width="44" Height="44" FontSize="18" Margin="18,0,0,0"
                                                Content="&#xE892;" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"
                                                ToolTip="Previous (Ctrl+Left)" AutomationProperties.Name="Previous" />
                                        <Button Style="{StaticResource MusicPlayButtonStyle}" Width="58" Height="58" FontSize="20" Margin="16,0"
                                                Background="{DynamicResource PrimaryTextBrush}" Foreground="{DynamicResource MusicPlayGlyphBrush}"
                                                Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" IsEnabled="{Binding HasCurrent}"
                                                ToolTip="{Binding PlayPauseLabel}" AutomationProperties.Name="{Binding PlayPauseLabel}" />
                                        <Button Style="{StaticResource MusicIconButtonStyle}" Width="44" Height="44" FontSize="18" Margin="0,0,18,0"
                                                Content="&#xE893;" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"
                                                ToolTip="Next (Ctrl+Right)" AutomationProperties.Name="Next" />
                                        <ToggleButton Style="{StaticResource MusicIconButtonStyle}" Content="{Binding RepeatGlyph}"
                                                      IsChecked="{Binding IsRepeatOn, Mode=TwoWay}"
                                                      ToolTip="{Binding RepeatLabel}" AutomationProperties.Name="{Binding RepeatLabel}" />
                                    </StackPanel>

                                    <!-- Volume -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource MusicIconButtonStyle}" Content="{Binding VolumeGlyph}"
                                                Command="{Binding ToggleMuteCommand}" ToolTip="Mute / unmute" AutomationProperties.Name="Mute" />
                                        <Slider Grid.Column="1" Style="{StaticResource MusicSliderStyle}" Margin="6,0" VerticalAlignment="Center"
                                                Minimum="0" Maximum="{Binding VolumeMaximum}" Value="{Binding VolumePercent, Mode=TwoWay}"
                                                SmallChange="5" LargeChange="10"
                                                AutomationProperties.Name="Volume" AutomationProperties.HelpText="Ctrl+Up and Ctrl+Down change the volume" />
                                        <TextBlock Grid.Column="2" Text="{Binding VolumeLabel}" MinWidth="86" FontSize="11.5" TextAlignment="Right"
                                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Text="{Binding UpNext}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding UpNext}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Error banner -->
                    <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="10" BorderThickness="1"
                            BorderBrush="{DynamicResource WarningBrush}" Background="{DynamicResource CardBackgroundBrush}"
                            Visibility="{Binding NowPlaying.ErrorMessage, Converter={StaticResource NotNullToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding NowPlaying.ErrorMessage}" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- ─── YouTube Music In-App Search Bar ─── -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14,8" Margin="0,24,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,14,0">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="YouTube Music" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBox Text="{Binding SearchYouTubeText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" FontSize="13"
                                         Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"
                                         Padding="4,2"
                                         ToolTip="Search songs, artists or playlists on YouTube Music (plays in-app without browser)">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchYouTubeCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="Search tracks, artists or albums on YouTube Music..." FontSize="12.5"
                                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchYouTubeText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchYouTubeText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchYouTubeCommand}"
                                    Padding="16,6" Height="32" ToolTip="Search and load results into Library and Queue">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Search YT Music" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ─── Dedicated Scrollable Playlist Section (Player stays fixed at top) ─── -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,16">
                    <StackPanel>
                        <!-- Section Header & Toolbar (Buttons placed below title to prevent hiding title) -->
                        <StackPanel Margin="4,0,4,12">
                            <!-- Row 1: Section Title & Summary -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Library &amp; Playlists" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock Text="{Binding LibraryItemsSummary}" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Row 2: Action Buttons Bar (never overlaps or clips the title) -->
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Create Playlist Button -->
                                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenCreatePlaylistDialogCommand}" Margin="0,0,8,6" Padding="14,6" Height="32"
                                        ToolTip="Create new playlist in configured music folder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Create Playlist" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Open files... moved here -->
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NowPlaying.OpenFilesCommand}" Margin="0,0,8,6" Padding="12,6" Height="32"
                                        ToolTip="Open individual audio files" AutomationProperties.Name="Open files">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Open files…" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Open folder... moved here -->
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NowPlaying.OpenFolderCommand}" Margin="0,0,8,6" Padding="12,6" Height="32"
                                        ToolTip="Open folder into queue" AutomationProperties.Name="Open folder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Open folder…" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Add Folder to Library -->
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddFolderToLibraryCommand}" Margin="0,0,8,6" Padding="12,6" Height="32"
                                        ToolTip="Add external folder to Library">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add Folder" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Rescan Library -->
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshLibraryCommand}" Margin="0,0,8,6" Padding="10,6" Height="32" ToolTip="Rescan Local Music &amp; Playlists">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Responsive WrapPanel: Automatically fits more columns as screen expands, never stretches images -->
                        <ItemsControl ItemsSource="{Binding LibraryItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="150" Margin="6" Background="{DynamicResource ElevatedCardBackgroundBrush}" 
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="12" Padding="10" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.SelectLibraryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Cover Art / Stylized Tile: Fixed height 130 for perfect square proportion -->
                                            <Grid Grid.Row="0" Height="130" Margin="0,0,0,8">
                                                <Border CornerRadius="8" Background="{Binding GradientBrush}" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" 
                                                                   FontSize="36" Foreground="#66FFFFFF"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVis}}"/>
                                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" 
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Quick Play button -->
                                                <Button Style="{StaticResource MusicPlayButtonStyle}" Width="36" Height="36" FontSize="13"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                                                        Command="{Binding DataContext.PlayLibraryItemDirectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Play now" AutomationProperties.Name="Play playlist">
                                                    <Button.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
                                                    </Button.Effect>
                                                </Button>
                                            </Grid>

                                            <!-- Title -->
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="2,0,2,2"/>

                                            <!-- Subtitle / Track count -->
                                            <TextBlock Grid.Row="2" Text="{Binding Subtitle}" FontSize="11" 
                                                       Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="2,0,2,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ─── Right Drawer: Dual Queued / Songs Panel ─── -->
            <Border x:Name="QueuePanel" Grid.Column="1" Width="340" Margin="20,0,0,0" Padding="0,16,0,8"
                    Style="{StaticResource MusicGlassCardStyle}"
                    Visibility="{Binding IsQueueOpen, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Music panel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header with Segmented Tabs: [ Queued ] [ Songs ] -->
                    <Grid Margin="16,0,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Segmented Switcher -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource MusicTabRadioStyle}" Content="Queued"
                                             IsChecked="{Binding IsQueueTabSelected, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource MusicTabRadioStyle}" Content="Songs"
                                             IsChecked="{Binding IsSongsTabSelected, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Track count / Subtitle -->
                        <TextBlock Grid.Column="1" Text="{Binding RightPanelSubtitle}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" 
                                   VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />

                        <!-- Actions for Queued Tab: Add files, Clear queue -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" 
                                    Visibility="{Binding IsQueueTabSelected, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MusicIconButtonStyle}" Content="&#xE710;" Command="{Binding NowPlaying.AddFilesCommand}"
                                    ToolTip="Add files to the queue" AutomationProperties.Name="Add files to the queue" />
                            <Button Style="{StaticResource MusicIconButtonStyle}" Content="&#xE74D;" Command="{Binding NowPlaying.ClearQueueCommand}"
                                    IsEnabled="{Binding NowPlaying.HasQueue}" ToolTip="Clear the queue" AutomationProperties.Name="Clear the queue" />
                        </StackPanel>

                        <!-- Actions for Songs Tab: Play All, Queue All -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsSongsTabSelected, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MusicIconButtonStyle}" Content="&#xE768;" Command="{Binding PlaySelectedSongsCommand}"
                                    ToolTip="Play All" AutomationProperties.Name="Play All" />
                            <Button Style="{StaticResource MusicIconButtonStyle}" Content="&#xE710;" Command="{Binding QueueSelectedSongsCommand}"
                                    ToolTip="Add All to Queue" AutomationProperties.Name="Queue All" />
                        </StackPanel>
                    </Grid>

                    <!-- TAB 1: Queue List -->
                    <Grid Grid.Row="1" Visibility="{Binding IsQueueTabSelected, Converter={StaticResource BoolToVis}}">
                        <ListBox x:Name="QueueList" ItemsSource="{Binding NowPlaying.Queue}"
                                 Background="Transparent" BorderThickness="0" Padding="6,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 AutomationProperties.Name="Queue"
                                 MouseDoubleClick="QueueList_MouseDoubleClick"
                                 PreviewKeyDown="QueueList_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="QueueList_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="QueueList_PreviewMouseLeftButtonUp">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                    <Setter Property="ToolTip" Value="{Binding AccessibleName}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="row" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu MinWidth="180">
                                                <MenuItem Header="Play" Icon="&#xE768;" Command="{Binding PlacementTarget.Tag.JumpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Move up" Icon="&#xE74A;" InputGestureText="Alt+Up" Command="{Binding PlacementTarget.Tag.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Move down" Icon="&#xE74B;" InputGestureText="Alt+Down" Command="{Binding PlacementTarget.Tag.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                <Separator Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}" />
                                                <MenuItem Header="Play from" Icon="&#xE895;"
                                                          ItemsSource="{Binding Candidates}"
                                                          Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                                                    <MenuItem.ItemContainerStyle>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Header" Value="{Binding Title}" />
                                                            <Setter Property="InputGestureText" Value="{Binding Detail}" />
                                                            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneTime}" />
                                                            <Setter Property="IsCheckable" Value="False" />
                                                            <Setter Property="Command" Value="{Binding DataContext.NowPlaying.SelectCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.ItemContainerStyle>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="Remove from queue" Icon="&#xE74D;" InputGestureText="Del" Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Tag" Value="{Binding NowPlaying, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type music:QueueEntryViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="number" Text="{Binding Number}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock x:Name="nowGlyph" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource MusicAccentBrush}" Visibility="Collapsed" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock x:Name="title" Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="10.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Visibility="{Binding SourceLabel, Converter={StaticResource NotNullToVis}}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="number" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="nowGlyph" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="title" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="title" Property="Foreground" Value="{DynamicResource MusicAccentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Nothing queued yet. Add files, or drop them here to add them to the end."
                                   Margin="18,8" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}"
                                   Visibility="{Binding NowPlaying.HasQueue, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>

                    <!-- TAB 2: Songs List of Selected Playlist/Folder -->
                    <Grid Grid.Row="1" Visibility="{Binding IsSongsTabSelected, Converter={StaticResource BoolToVis}}">
                        <ListBox x:Name="SongsList" ItemsSource="{Binding SelectedSongs}"
                                 Background="Transparent" BorderThickness="0" Padding="6,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 MouseDoubleClick="SongsList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="row" CornerRadius="8" Padding="10,7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu MinWidth="180">
                                                <MenuItem Header="Play" Icon="&#xE768;" Command="{Binding DataContext.PlaySongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Add to queue" Icon="&#xE710;" Command="{Binding DataContext.QueueSongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type music:SongItemViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="No songs found in this playlist or folder."
                                   Margin="18,8" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSongs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ─── Modal 1: Create Playlist Dialog ─── -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#B2000000"
              Visibility="{Binding IsCreatePlaylistOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="100">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ElevatedCardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5"
                    CornerRadius="16" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Create Playlist" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Enter a name for your new playlist. It will be saved into your designated playlist folder as an .m3u playlist."
                               FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="Playlist Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,14">
                        <TextBox Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPlaylistPath}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCreatePlaylistCommand}" Content="Cancel" Margin="0,0,10,0" Padding="16,8"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmCreatePlaylistCommand}" Content="Create" Padding="20,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ─── Modal 2: Music Settings Dialog ─── -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#B2000000"
              Visibility="{Binding IsMusicSettingsOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="100">
            <Border Width="640" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ElevatedCardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5"
                    CornerRadius="16" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Music Settings" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource MusicIconButtonStyle}" HorizontalAlignment="Right" Content="&#xE711;"
                                Command="{Binding CloseMusicSettingsCommand}" ToolTip="Close" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>

                        <!-- Library & Playlist Storage Path -->
                        <TextBlock Text="Music &amp; Playlist Folder" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Created playlists and local music collections are saved and read from this folder."
                                   FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SelectedPlaylistPath}" FontSize="12.5" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ChangePlaylistPathCommand}" Padding="12,6" Content="Change Path…"/>
                            </Grid>
                        </Border>

                        <!-- Sources: one card per music source, the way a plugin list reads -->
                        <Grid Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Sources" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                                    <Run Text="Searching with"/>
                                    <Run Text="{Binding Sources.ActiveMetadataName, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="· audio from"/>
                                    <Run Text="{Binding Sources.ActiveStreamingName, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Style="{StaticResource MusicIconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Content="&#xE72C;" Command="{Binding Sources.RefreshCommand}" ToolTip="Re-check every source"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Sources.Sources}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <!-- Title row: icon, name, status pill, on/off -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9"
                                                        Background="{Binding AccentBrush}" VerticalAlignment="Top" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Author}" FontSize="11" Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Capabilities}" FontSize="11" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>

                                                <Border Grid.Column="2" CornerRadius="9" Padding="8,3" Margin="8,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource ElevatedCardBackgroundBrush}">
                                                    <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </Border>

                                                <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanBeDisabled}"
                                                          ToolTip="Use this source"/>
                                            </Grid>

                                            <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap" Margin="48,8,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                                            <!-- Setup: Client ID and sign-in, only for sources that need an account -->
                                            <StackPanel Margin="48,10,0,0" Visibility="{Binding NeedsClientId, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding SetupHint}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding ClientId, UpdateSourceTrigger=LostFocus}" FontSize="12"
                                                         Padding="8,6" Margin="0,0,0,8"
                                                         Background="{DynamicResource ElevatedCardBackgroundBrush}"
                                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                                         BorderBrush="{DynamicResource CardBorderBrush}"
                                                         ToolTip="Your Spotify app's Client ID"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding AccountLine}" FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0"/>
                                                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Content="Sign in"
                                                            Command="{Binding SignInCommand}"
                                                            Visibility="{Binding IsSignedIn, Converter={StaticResource InverseBoolToVis}}"/>
                                                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Content="Sign out"
                                                            Command="{Binding SignOutCommand}"
                                                            Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Foreground="#EF4444"
                                                           Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}"/>
                                            </StackPanel>

                                            <!-- Which job this source does -->
                                            <StackPanel Orientation="Horizontal" Margin="48,10,0,0">
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,8,0"
                                                        Content="Search with this" Command="{Binding UseForSearchCommand}"
                                                        Visibility="{Binding SuppliesSearch, Converter={StaticResource BoolToVis}}"
                                                        IsEnabled="{Binding IsActiveForSearch, Converter={StaticResource InverseBool}}"/>
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"
                                                        Content="Play audio with this" Command="{Binding UseForAudioCommand}"
                                                        Visibility="{Binding SuppliesAudio, Converter={StaticResource BoolToVis}}"
                                                        IsEnabled="{Binding IsActiveForAudio, Converter={StaticResource InverseBool}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Streamed audio: how it is fetched and how much is kept -->
                        <TextBlock Text="Streamed audio" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Download before playing" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Slower to start, but steadier on a weak connection. Off means playback begins while the track is still arriving."
                                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                              IsChecked="{Binding Sources.CacheStreamsToDisk, Mode=TwoWay}"/>
                                </Grid>
                                <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Cached audio" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding Sources.CacheSizeText}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Content="Clear"
                                            VerticalAlignment="Center" Command="{Binding Sources.ClearCacheCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Controlling the Spotify and YouTube Music desktop apps: a separate feature -->
                        <TextBlock Text="Control other players" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="Spotify Background Control" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Launches Spotify minimized and controls playback via Windows media sessions" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SpotifyButtonStyle}" Command="{Binding LaunchAndMinimizeSpotifyCommand}" Padding="10,5" Content="Open Minimized" VerticalAlignment="Center"/>
                                </Grid>
                                <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,6"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="YouTube Music (Free)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Opens YouTube Music in background with universal media controls" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource YouTubeMusicButtonStyle}" Command="{Binding LaunchYouTubeMusicCommand}" Padding="10,5" Content="Open YT Music" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,16,0,0"
                            Command="{Binding CloseMusicSettingsCommand}" Content="Done" Padding="24,8"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
