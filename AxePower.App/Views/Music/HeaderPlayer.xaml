<UserControl x:Class="AxePower.App.Views.Music.HeaderPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:music="clr-namespace:AxePower.App.ViewModels.Music"
             xmlns:helpers="clr-namespace:AxePower.App.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance music:NowPlayingViewModel, IsDesignTimeCreatable=False}"
             Width="336"
             AutomationProperties.Name="Now playing">

    <!-- Compact glass player shown from the title bar's "Music" toggle -->
    <Border Style="{StaticResource MusicGlassCardStyle}" Padding="10">
        <Grid>
            <!-- Soft top sheen for the glass look -->
            <Border CornerRadius="16" Margin="-10" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1AFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.55" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Artwork; click opens the Music page -->
                <Button Grid.Column="0" Width="80" Height="80" Margin="0,0,12,0" Cursor="Hand"
                        Command="{Binding OpenMusicPageCommand}"
                        ToolTip="Open the Music page" AutomationProperties.Name="Open the Music page">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="frame" Style="{StaticResource MusicArtFrameStyle}" CornerRadius="10">
                                <Grid>
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#E6FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVis}}" />
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                    <Setter TargetName="frame" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- Title line -->
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                               ToolTip="{Binding ArtistAndAlbum}">
                        <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" /><Run Text="{Binding Artist, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Normal" />
                    </TextBlock>

                    <!-- Transport -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Button Style="{StaticResource MusicIconButtonStyle}" Width="30" Height="30" Content="&#xE892;" Command="{Binding PreviousCommand}"
                                IsEnabled="{Binding CanPrevious}" ToolTip="Previous" AutomationProperties.Name="Previous" />
                        <Button Style="{StaticResource MusicPlayButtonStyle}" Width="32" Height="32" FontSize="13" Margin="10,0"
                                Background="{DynamicResource PrimaryTextBrush}" Foreground="{DynamicResource MusicPlayGlyphBrush}"
                                Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" IsEnabled="{Binding HasCurrent}"
                                ToolTip="{Binding PlayPauseLabel}" AutomationProperties.Name="{Binding PlayPauseLabel}" />
                        <Button Style="{StaticResource MusicIconButtonStyle}" Width="30" Height="30" Content="&#xE893;" Command="{Binding NextCommand}"
                                IsEnabled="{Binding CanNext}" ToolTip="Next" AutomationProperties.Name="Next" />
                    </StackPanel>

                    <!-- Seek -->
                    <Slider Style="{StaticResource MusicSliderStyle}" Height="12"
                            Minimum="0" Maximum="{Binding SeekMaximum}" Value="{Binding PositionSeconds, Mode=TwoWay}"
                            SmallChange="5" LargeChange="5" IsEnabled="{Binding HasCurrent}"
                            helpers:MusicSeekBehavior.IsEnabled="True"
                            AutomationProperties.Name="Seek">
                        <Slider.ToolTip>
                            <TextBlock>
                                <Run Text="{Binding PositionText, Mode=OneWay}" /> / <Run Text="{Binding DurationText, Mode=OneWay}" />
                            </TextBlock>
                        </Slider.ToolTip>
                    </Slider>

                    <!-- Small controls row -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton Grid.Column="0" Style="{StaticResource MusicIconButtonStyle}" Width="24" Height="24" FontSize="11"
                                      Content="&#xE8B1;" IsChecked="{Binding IsShuffle, Mode=TwoWay}"
                                      ToolTip="{Binding ShuffleLabel}" AutomationProperties.Name="{Binding ShuffleLabel}" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource MusicIconButtonStyle}" Width="24" Height="24" FontSize="11"
                                      Content="{Binding RepeatGlyph}" IsChecked="{Binding IsRepeatOn, Mode=TwoWay}"
                                      ToolTip="{Binding RepeatLabel}" AutomationProperties.Name="{Binding RepeatLabel}" />
                        <Button Grid.Column="2" Style="{StaticResource MusicIconButtonStyle}" Width="24" Height="24" FontSize="11"
                                Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}"
                                ToolTip="{Binding VolumeLabel}" AutomationProperties.Name="Mute" />
                        <Slider Grid.Column="3" Style="{StaticResource MusicSliderStyle}" Height="14" Margin="2,0,6,0" VerticalAlignment="Center"
                                Minimum="0" Maximum="{Binding VolumeMaximum}" Value="{Binding VolumePercent, Mode=TwoWay}"
                                SmallChange="5" LargeChange="10" ToolTip="{Binding VolumeLabel}" AutomationProperties.Name="Volume" />
                        <Button Grid.Column="4" x:Name="MoreButton" Style="{StaticResource MusicIconButtonStyle}" Width="24" Height="24" FontSize="12"
                                Content="&#xE712;" ToolTip="More" AutomationProperties.Name="More options" Click="MoreButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open Music" Command="{Binding OpenMusicPageCommand}" />
                                    <MenuItem Header="Open files…" Command="{Binding OpenFilesCommand}" />
                                    <MenuItem Header="Open folder…" Command="{Binding OpenFolderCommand}" />
                                    <MenuItem Header="Add files to queue…" Command="{Binding AddFilesCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
