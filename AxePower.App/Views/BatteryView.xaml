<UserControl x:Class="AxePower.App.Views.BatteryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:AxePower.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="728" d:DesignWidth="1040">
             
    <UserControl.Resources>
        <converters:BatteryTrendConverter x:Key="BatteryTrendConverter" />
        <converters:BatteryPercentageToYConverter x:Key="BatteryPercentageToYConverter" />
        <converters:SparklinePathConverter x:Key="SparklinePathConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid Margin="32,20,32,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Battery" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBlock Text="Monitor battery health, usage, and performance." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
            </StackPanel>

            <!-- Top Cards: Strictly 3 Columns and 2 Rows in both normal and fullscreen -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0, Column 0: Battery Health -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource EcoBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource EcoBrush}" Opacity="0.15"/>
                            <Image Source="/Resources/icons/batteryhealth.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Battery Health" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding HealthPercentage}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding HealthStatus}" Foreground="{DynamicResource EcoBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Your battery health is in great condition." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 0, Column 2: Estimated Time Remaining -->
                <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource SmartBrush}" Opacity="0.15"/>
                            <Image Source="/Resources/icons/timeremaining.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Estimated Time Remaining" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding EstimatedTimeRemaining}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding PowerSource}" Foreground="{DynamicResource SmartBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Time left based on your current usage." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 0, Column 4: Charge Level -->
                <Border Grid.Row="0" Grid.Column="4" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                            <Image Source="/Resources/icons/battery.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Charge Level" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding BatteryPercentage, StringFormat={}{0}}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ChargingState}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Current charge level of your device." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1, Column 0: Charge Cycles -->
                <Border Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="#9C27B0" Opacity="0.15"/>
                            <Image Source="/Resources/icons/chargecycle.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Charge Cycles" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CycleCount}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Cycles" Foreground="#9C27B0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Battery cycle count since first use." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1, Column 2: Temperature -->
                <Border Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="#FF5722" Opacity="0.15"/>
                            <Image Source="/Resources/icons/thermometer_beast.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Temperature" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Temperature}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Normal" Foreground="#FF5722" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Battery temperature is within normal range." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1, Column 4: Current Power Usage -->
                <Border Grid.Row="1" Grid.Column="4" Margin="0,10,0,0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource WarningBrush}" Opacity="0.15"/>
                            <Image Source="/Resources/icons/bolt_beast.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Current Power Usage" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CurrentPowerUsage}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Live Draw" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Power draw based on live sensor telemetry." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Section (Analytics, Details & Charging Controls) -->
            <Grid Grid.Row="2" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Battery Level Trend (Image 1 - copy of dashboard battery graph) -->
                <Border Grid.Column="0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: Title on left, Mode & live Battery on right -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔋" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="BATTERY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentMode, StringFormat='{}Mode: {0}'}" Foreground="{DynamicResource SmartBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BatteryPercentage}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Graph Row with Left Y-Axis Marks (100%, 50%, 0%) -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Y-Axis Percentage Marks -->
                            <Grid Grid.Column="0" Height="120" Margin="0,1,4,1">
                                <TextBlock Text="100%" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="8.5" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                <TextBlock Text="50%" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="8.5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <TextBlock Text="0%" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="8.5" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- High-Resolution Timeline Sparkline Canvas with Glowing Gradient (identical to Dashboard) -->
                            <Border Grid.Column="1" Height="120" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid ClipToBounds="True">
                                    <!-- Background Grid Lines -->
                                    <Grid Opacity="0.12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Row="0" Grid.ColumnSpan="4" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,0,0,1"/>
                                        <Border Grid.Row="1" Grid.ColumnSpan="4" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,0,0,1"/>
                                        <Border Grid.Row="2" Grid.ColumnSpan="4" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,0,0,1"/>
                                        <Border Grid.Column="0" Grid.RowSpan="4" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="1" Grid.RowSpan="4" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="2" Grid.RowSpan="4" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,0,1,0"/>
                                    </Grid>

                                    <!-- Gradient Fill and Stroke Line -->
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="100" Height="50">
                                            <Path Data="{Binding BatteryTrendPoints, Converter={StaticResource SparklinePathConverter}, ConverterParameter='Fill'}">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#4010B981" Offset="0.0"/>
                                                        <GradientStop Color="#0010B981" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                            </Path>
                                            <Path Data="{Binding BatteryTrendPoints, Converter={StaticResource SparklinePathConverter}}"
                                                  Stroke="{DynamicResource SuccessBrush}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Time Axis Sub-Labels -->
                        <Grid Grid.Row="2" Margin="28,4,4,0">
                            <TextBlock Text="24h ago" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9" HorizontalAlignment="Left"/>
                            <TextBlock Text="12h ago" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9" HorizontalAlignment="Center"/>
                            <TextBlock Text="Now" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="9" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Center Column: Battery Details (Image 2 with 'Open Settings' button) -->
                <Border Grid.Column="2" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Battery Details" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="14.5" Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE914;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Design Capacity" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding DesignCapacity}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Full Charge Capacity" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding FullChargeCapacity}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Voltage" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Voltage}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE836;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Chemistry" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding DeviceChemistry}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE925;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Manufacturer" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Manufacturer}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE8B0;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Serial Number" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding SerialNumber}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Manufacture Date" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ManufactureDate}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- Open Settings Button (Windows Settings > System > Power & battery) -->
                        <Button Grid.Row="2" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenPowerSettingsCommand}" Height="30" Background="Transparent" BorderBrush="{DynamicResource DividerBrush}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Settings" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Right Column: Charging Controls (Toggles moved from middle section) -->
                <Border Grid.Column="4" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Charging Controls" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="14.5" Margin="0,0,0,10"/>

                        <!-- 1. Conservation mode -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Conservation mode" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Text="Limits battery charge to 75%–80% to extend lifespan." 
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap" LineHeight="14" Margin="0,0,0,2"/>
                                <TextBlock Text="Charge cap: 80%" Foreground="{DynamicResource EcoBrush}" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding ConservationMode, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,8"/>

                        <!-- 2. Rapid charge -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Rapid charge" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Text="Charges battery at accelerated speed when connected to AC." 
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap" LineHeight="14"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding RapidCharge, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,8"/>

                        <!-- 3. Overnight battery charging -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Overnight battery charging" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Text="Charges to 80%, then completes right before morning use." 
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap" LineHeight="14"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding OvernightBatteryCharging, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Bottom Status Region -->
        <Border Grid.Row="1" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="28" Height="28" Margin="0,0,12,0">
                        <Ellipse Fill="{DynamicResource ElevatedCardBackgroundBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" />
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Auto switch enabled" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,1"/>
                        <TextBlock Text="AxePower is optimizing your system automatically." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
