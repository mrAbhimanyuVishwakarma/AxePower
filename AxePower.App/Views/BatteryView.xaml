<UserControl x:Class="AxePower.App.Views.BatteryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:AxePower.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="728" d:DesignWidth="1040">
             
    <UserControl.Resources>
        <converters:BatteryTrendConverter x:Key="BatteryTrendConverter" />
        <converters:BatteryPercentageToYConverter x:Key="BatteryPercentageToYConverter" />
        <converters:SparklinePathConverter x:Key="SparklinePathConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Power & Sleep Segment Tab Style -->
        <Style x:Key="PowerTabSegmentStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid Margin="32,20,32,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Battery" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBlock Text="Monitor battery health, usage, and performance." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
            </StackPanel>

            <!-- Top Cards: Strictly 3 Columns and 2 Rows in both normal and fullscreen -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0, Column 0: Battery Health -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource EcoBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource EcoBrush}" Opacity="0.15"/>
                            <Image Source="/Resources/icons/batteryhealth.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Battery Health" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding HealthPercentage}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding HealthStatus}" Foreground="{DynamicResource EcoBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Your battery health is in great condition." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 0, Column 2: Estimated Time Remaining -->
                <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource SmartBrush}" Opacity="0.15"/>
                            <Image Source="/Resources/icons/timeremaining.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Estimated Time Remaining" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding EstimatedTimeRemaining}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding PowerSource}" Foreground="{DynamicResource SmartBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Time left based on your current usage." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 0, Column 4: Charge Level -->
                <Border Grid.Row="0" Grid.Column="4" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                            <Image Source="/Resources/icons/battery.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Charge Level" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding BatteryPercentage, StringFormat={}{0}}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ChargingState}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Current charge level of your device." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1, Column 0: Charge Cycles -->
                <Border Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="#9C27B0" Opacity="0.15"/>
                            <Image Source="/Resources/icons/chargecycle.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Charge Cycles" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CycleCount}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Cycles" Foreground="#9C27B0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Battery cycle count since first use." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1, Column 2: Temperature -->
                <Border Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="#FF5722" Opacity="0.15"/>
                            <Image Source="/Resources/icons/thermometer_beast.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Temperature" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Temperature}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Normal" Foreground="#FF5722" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Battery temperature is within normal range." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1, Column 4: Current Power Usage -->
                <Border Grid.Row="1" Grid.Column="4" Margin="0,10,0,0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource WarningBrush}" Opacity="0.15"/>
                            <Image Source="/Resources/icons/bolt_beast.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Current Power Usage" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CurrentPowerUsage}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Live Draw" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Power draw based on live sensor telemetry." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Section (Analytics, Details & Charging Controls) -->
            <Grid Grid.Row="2" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Battery Level Trend + Charging Controls -->
                <Border Grid.Column="0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header: Title on left, Mode & live Battery on right -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔋" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="BATTERY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentMode, StringFormat='{}Mode: {0}'}" Foreground="{DynamicResource SmartBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BatteryPercentage}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Graph Row with Left Y-Axis Marks (100%, 50%, 0%) -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Y-Axis Percentage Marks -->
                            <Grid Grid.Column="0" Height="100" Margin="0,1,4,1">
                                <TextBlock Text="100%" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="8.5" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                <TextBlock Text="50%" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="8.5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <TextBlock Text="0%" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="8.5" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- High-Resolution Timeline Sparkline Canvas with Glowing Gradient (identical to Dashboard) -->
                            <Border Grid.Column="1" Height="100" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid ClipToBounds="True">
                                    <!-- Background Grid Lines -->
                                    <Grid Opacity="0.12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Row="0" Grid.ColumnSpan="4" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,0,0,1"/>
                                        <Border Grid.Row="1" Grid.ColumnSpan="4" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,0,0,1"/>
                                        <Border Grid.Row="2" Grid.ColumnSpan="4" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,0,0,1"/>
                                        <Border Grid.Column="0" Grid.RowSpan="4" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="1" Grid.RowSpan="4" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,0,1,0"/>
                                        <Border Grid.Column="2" Grid.RowSpan="4" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,0,1,0"/>
                                    </Grid>

                                    <!-- Gradient Fill and Stroke Line -->
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="100" Height="50">
                                            <Path Data="{Binding BatteryTrendPoints, Converter={StaticResource SparklinePathConverter}, ConverterParameter='Fill'}">
                                                <Path.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#4010B981" Offset="0.0"/>
                                                        <GradientStop Color="#0010B981" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Path.Fill>
                                            </Path>
                                            <Path Data="{Binding BatteryTrendPoints, Converter={StaticResource SparklinePathConverter}}"
                                                  Stroke="{DynamicResource SuccessBrush}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Time Axis Sub-Labels -->
                        <Grid Grid.Row="2" Margin="28,2,4,8">
                            <TextBlock Text="24h ago" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9" HorizontalAlignment="Left"/>
                            <TextBlock Text="12h ago" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9" HorizontalAlignment="Center"/>
                            <TextBlock Text="Now" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="9" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Divider between Graph and Charging Controls -->
                        <Border Grid.Row="3" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,10"/>

                        <!-- Charging Controls Section moved from right column -->
                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Charging Controls" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,8"/>

                            <!-- 1. Conservation mode -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Conservation mode" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1"/>
                                    <TextBlock Text="Limits battery charge to 75%–80% to extend lifespan." 
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap" LineHeight="13"/>
                                    <TextBlock Text="Charge cap: 80%" Foreground="{DynamicResource EcoBrush}" FontSize="9.5" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding ConservationMode, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,3,0,6"/>

                            <!-- 2. Rapid charge -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Rapid charge" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1"/>
                                    <TextBlock Text="Charges battery at accelerated speed when connected to AC." 
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap" LineHeight="13"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding RapidCharge, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,3,0,6"/>

                            <!-- 3. Overnight battery charging -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Overnight battery charging" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1"/>
                                    <TextBlock Text="Charges to 80%, then completes right before morning use." 
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap" LineHeight="13"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding OvernightBatteryCharging, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Center Column: Battery Details, capacity over time and the battery report -->
                <Border Grid.Column="2" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Battery Details" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="14.5" Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE914;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Design Capacity" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding DesignCapacity}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Full Charge Capacity" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding FullChargeCapacity}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Voltage" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Voltage}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE836;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Chemistry" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding DeviceChemistry}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE925;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Manufacturer" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Manufacturer}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE8B0;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Serial Number" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding SerialNumber}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Manufacture Date" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ManufactureDate}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Capacity over time, from the history Windows keeps in its battery report -->
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,12"/>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Capacity over time" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Text="from Windows" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Height="80" Visibility="{Binding HasCapacityHistory, Converter={StaticResource BoolToVis}}">
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"/>
                                <Path Data="{Binding CapacityAreaGeometry}" Stretch="Fill" Fill="{DynamicResource SuccessBrush}" Opacity="0.18"/>
                                <Path Data="{Binding CapacityLineGeometry}" Stretch="Fill" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <Grid Margin="0,4,0,0" Visibility="{Binding HasCapacityHistory, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CapacityStartLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5"/>
                                <TextBlock Text="{Binding CapacityEndLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="{Binding CapacitySummary}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- The full Windows battery report: usage, charge sessions and capacity history -->
                        <Button Grid.Row="2" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenBatteryReportCommand}" Height="30"
                                Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" Margin="0,10,0,0"
                                ToolTip="Creates the Windows battery report on this PC and opens it in your browser">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Open full battery report"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCreatingReport}" Value="True">
                                                    <Setter Property="Text" Value="Creating report…"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Right Column: Windows Power & Sleep Controls -->
                <Border Grid.Column="4" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Header with Segmented Tab Switcher -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Power &amp; Sleep" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="14.5"/>
                            </StackPanel>

                            <!-- Segmented Tabs: Time-outs vs Buttons & Lid -->
                            <Border Grid.Column="1" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="7" Padding="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Time-outs" Style="{StaticResource PowerTabSegmentStyle}" GroupName="PowerSettingsTabGroup"
                                                 IsChecked="{Binding SelectedPowerSettingsTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter='ScreenSleep', Mode=TwoWay}"/>
                                    <RadioButton Content="Buttons &amp; Lid" Style="{StaticResource PowerTabSegmentStyle}" GroupName="PowerSettingsTabGroup"
                                                 IsChecked="{Binding SelectedPowerSettingsTab, Converter={StaticResource StringEqualsToBool}, ConverterParameter='ButtonsLid', Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Tab 1: Screen, Sleep & Hibernate Time-outs -->
                        <StackPanel Grid.Row="1" Visibility="{Binding IsScreenSleepTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Screen, sleep, &amp; hibernate time-outs" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1"/>
                            <TextBlock Text="Choose what happens when your device is idle for a specified time" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <!-- Plugged In -->
                            <TextBlock Text="Plugged in" Foreground="{DynamicResource SmartBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5"/>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Turn my screen off after" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ScreenTimeoutOptions}" SelectedItem="{Binding SelectedScreenTimeoutAc, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="28" Padding="10,4" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Make my device sleep after" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SleepTimeoutOptions}" SelectedItem="{Binding SelectedSleepTimeoutAc, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="28" Padding="10,4" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Make my device hibernate after" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding HibernateTimeoutOptions}" SelectedItem="{Binding SelectedHibernateTimeoutAc, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="28" Padding="10,4" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- On Battery -->
                            <TextBlock Text="On battery" Foreground="{DynamicResource EcoBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,5"/>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Turn my screen off after" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ScreenTimeoutOptions}" SelectedItem="{Binding SelectedScreenTimeoutDc, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="28" Padding="10,4" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Make my device sleep after" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SleepTimeoutOptions}" SelectedItem="{Binding SelectedSleepTimeoutDc, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="28" Padding="10,4" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Make my device hibernate after" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding HibernateTimeoutOptions}" SelectedItem="{Binding SelectedHibernateTimeoutDc, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="28" Padding="10,4" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Tab 2: Lid, Power & Sleep Button Controls -->
                        <StackPanel Grid.Row="1" Visibility="{Binding IsButtonsLidTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Lid, power &amp; sleep button controls" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,1"/>
                            <TextBlock Text="Choose what happens when you interact with physical controls" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <!-- Plugged In -->
                            <TextBlock Text="Plugged in" Foreground="{DynamicResource SmartBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5"/>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pressing power button will make PC" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PowerButtonOptions}" SelectedItem="{Binding SelectedPowerButtonActionAc, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="28" Padding="10,4" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pressing sleep button will make PC" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SleepButtonOptions}" SelectedItem="{Binding SelectedSleepButtonActionAc, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="28" Padding="10,4" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Closing the lid will make PC" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding LidActionOptions}" SelectedItem="{Binding SelectedLidActionAc, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="28" Padding="10,4" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- On Battery -->
                            <TextBlock Text="On battery" Foreground="{DynamicResource EcoBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,5"/>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pressing power button will make PC" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PowerButtonOptions}" SelectedItem="{Binding SelectedPowerButtonActionDc, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="28" Padding="10,4" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pressing sleep button will make PC" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SleepButtonOptions}" SelectedItem="{Binding SelectedSleepButtonActionDc, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="28" Padding="10,4" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Closing the lid will make PC" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding LidActionOptions}" SelectedItem="{Binding SelectedLidActionDc, Mode=TwoWay}" DisplayMemberPath="DisplayName" Height="28" Padding="10,4" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Direct shortcut to Windows Power & Sleep Settings -->
                        <Button Grid.Row="2" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenPowerSleepSettingsCommand}" Height="30" Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Windows Power &amp; Sleep" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
