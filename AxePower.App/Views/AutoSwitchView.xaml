<UserControl x:Class="AxePower.App.Views.AutoSwitchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="728" d:DesignWidth="1040">
             
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="69"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,24,32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="440"/>
                    <ColumnDefinition Width="2*" MinWidth="280" MaxWidth="360"/>
                </Grid.ColumnDefinitions>

            <!-- Main Area (Left) -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <!-- Header -->
                <TextBlock Text="Smart Auto Switch" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Automatically change performance modes based on your power conditions." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="15" Margin="0,0,0,32"/>

                <!-- Rules list -->
                <StackPanel>
                    
                    <!-- When plugged in -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                <Ellipse Fill="{DynamicResource BeastBrush}" Opacity="0.15"/>
                                <Image Source="/Resources/icons/power.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When plugged in" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                <TextBlock Text="Use maximum performance&#x0a;when connected to power." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
                            </StackPanel>
                            
                            <ComboBox Grid.Column="2" Style="{DynamicResource AppComboBoxStyle}" ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding PluggedInMode}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox Grid.Column="3" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding PluggedInEnabled}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- When unplugged -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                <Ellipse Fill="{DynamicResource EcoBrush}" Opacity="0.15"/>
                                <Image Source="/Resources/icons/poweroff.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When unplugged" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                <TextBlock Text="Optimize efficiency&#x0a;when running on battery." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
                            </StackPanel>
                            
                            <ComboBox Grid.Column="2" Style="{DynamicResource AppComboBoxStyle}" ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding UnpluggedMode}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox Grid.Column="3" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding UnpluggedEnabled}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- When battery below 30% -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                <Ellipse Fill="{DynamicResource WarningBrush}" Opacity="0.15"/>
                                <Image Source="/Resources/icons/battery_below30.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When battery below 30%" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                <TextBlock Text="Extend battery life by&#x0a;switching to Eco Mode." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
                            </StackPanel>
                            
                            <ComboBox Grid.Column="2" Style="{DynamicResource AppComboBoxStyle}" ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding LowBatteryMode}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox Grid.Column="3" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding LowBatteryEnabled}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- Custom rule -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                    <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                                    <Image Source="/Resources/icons/custom.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Custom rule (Optional)" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="Create a schedule or custom condition that fits your workflow." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <ComboBox Grid.Column="2" Style="{DynamicResource AppComboBoxStyle}" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ComboBoxItem Content="Custom Schedule" IsSelected="True"/>
                                </ComboBox>
                                <CheckBox Grid.Column="3" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding CustomRuleEnabled}" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE162;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Weekdays" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                                            <TextBlock Text="Mon – Fri" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="9:00 AM – 5:00 PM" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                                            <TextBlock Text="Work hours" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Smart Mode" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                                            <TextBlock Text="Balanced performance" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Dynamic Mode Automation & Background Tuning (Phase 4) -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                    <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Dynamic Mode Automation" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16"/>
                                        <Border Background="#1A06B6D4" BorderBrush="#3306B6D4" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="DYNAMIC TUNING" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Intelligently pause heavy background services in Beast mode and optimize RAM cache." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                                        Command="{Binding OptimizeRamNowCommand}"
                                        Padding="14,8" FontSize="12.5" VerticalAlignment="Center"
                                        ToolTip="Purge Windows standby RAM cache to free memory for games">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Purge RAM" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" CornerRadius="10" Padding="16,14">
                                <StackPanel>
                                    <!-- Option 1: Auto-Pause Services -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto-Pause Heavy Services in Beast / Game Mode" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Pauses SysMain, Windows Search Indexer, Telemetry, and Error Reporting while gaming." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding AutoPauseServicesInBeast}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Option 2: Auto-Flush RAM Cache -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto-Flush Standby RAM on High Performance Mode" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Frees standby memory cache pages into active physical RAM." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding AutoFlushRamOnGameLaunch}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Option 3: Auto-Restore on Eco -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto-Restore All Services on Eco / Balanced Mode" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Smoothly restarts previously paused background services when switching back to Eco." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding AutoRestoreOnEco}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Rules list end -->

                </StackPanel>
            </StackPanel>

            <!-- Right Rail -->
            <StackPanel Grid.Column="1">
                
                <!-- Summary Card -->
                <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Auto Switch Summary" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                        <TextBlock Text="Here's how AxePower will respond:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,24"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0">
                                <Ellipse Fill="{DynamicResource BeastBrush}" Opacity="0.15"/>
                                <Image Source="/Resources/icons/power.png" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When plugged in" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                                <TextBlock Text="Switch to Beast Mode" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <Image Grid.Column="2" Source="/Resources/icons/performance_beast.png" Width="16" Height="16" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0">
                                <Ellipse Fill="{DynamicResource EcoBrush}" Opacity="0.15"/>
                                <Image Source="/Resources/icons/poweroff.png" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When unplugged" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                                <TextBlock Text="Switch to Eco Mode" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <Image Grid.Column="2" Source="/Resources/icons/tick.png" Width="14" Height="14" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0">
                                <Ellipse Fill="{DynamicResource WarningBrush}" Opacity="0.15"/>
                                <Image Source="/Resources/icons/battery_below30.png" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When battery below 30%" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                                <TextBlock Text="Switch to Eco Mode" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <Image Grid.Column="2" Source="/Resources/icons/tick.png" Width="14" Height="14" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0">
                                <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                                <Image Source="/Resources/icons/custom.png" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Custom schedule" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
                                <TextBlock Text="Weekdays, 9:00 AM – 5:00 PM&#x0a;Switch to Smart Mode" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <Image Grid.Column="2" Source="/Resources/icons/bolt_beast.png" Width="16" Height="16" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- General Options Card -->
                <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="General Options" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Show notifications" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding ShowNotifications}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Start with Windows" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
            </Grid>
        </ScrollViewer>
        <!-- Bottom Status Region -->
        <Border Grid.Row="1" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding SaveSettingsCommand}" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,8" Background="#222" BorderBrush="#444" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Apply Changes" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="32" Height="32" Margin="0,0,16,0">
                        <Ellipse Fill="{DynamicResource ElevatedCardBackgroundBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" />
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Auto switch enabled" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock Text="AxePower is monitoring your power conditions." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding OpenHelpCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Help" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding CheckForUpdatesCommand}" Padding="16,8" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Check for updates" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
