<UserControl x:Class="AxePower.App.Views.AutoSwitchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="728" d:DesignWidth="1040">
             
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="40,32,40,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Main Area (Left) -->
            <StackPanel Grid.Column="0" Margin="0,0,32,0">
                <!-- Header -->
                <TextBlock Text="Smart Auto Switch" Foreground="{StaticResource PrimaryTextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Automatically change performance modes based on your power conditions." Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" Margin="0,0,0,32"/>

                <!-- Rules list -->
                <StackPanel>
                    
                    <!-- When plugged in -->
                    <Border Background="{StaticResource ElevatedCardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                <Ellipse Fill="{StaticResource BeastBrush}" Opacity="0.1"/>
                                <TextBlock Text="&#xE9A1;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource BeastBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When plugged in" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                <TextBlock Text="Use maximum performance&#x0a;when connected to power." Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                            </StackPanel>
                            
                            <ComboBox Grid.Column="2" Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding PluggedInMode}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding PluggedInEnabled}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- When unplugged -->
                    <Border Background="{StaticResource ElevatedCardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                <Ellipse Fill="{StaticResource EcoBrush}" Opacity="0.1"/>
                                <TextBlock Text="&#xE9A1;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource EcoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/> <!-- Note: icon might differ -->
                            </Grid>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When unplugged" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                <TextBlock Text="Optimize efficiency&#x0a;when running on battery." Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                            </StackPanel>
                            
                            <ComboBox Grid.Column="2" Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding UnpluggedMode}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UnpluggedEnabled}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- When battery below 30% -->
                    <Border Background="{StaticResource ElevatedCardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                <Ellipse Fill="{StaticResource WarningBrush}" Opacity="0.1"/>
                                <TextBlock Text="&#xEBAA;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When battery below 30%" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                <TextBlock Text="Extend battery life by&#x0a;switching to Eco Mode." Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                            </StackPanel>
                            
                            <ComboBox Grid.Column="2" Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding LowBatteryMode}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LowBatteryEnabled}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- Custom rule -->
                    <Border Background="{StaticResource ElevatedCardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                    <Ellipse Fill="{StaticResource AccentBrush}" Opacity="0.1"/>
                                    <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Custom rule (Optional)" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="Create a schedule or custom condition&#x0a;that fits your workflow." Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                                </StackPanel>
                                
                                <ComboBox Grid.Column="2" Style="{StaticResource AppComboBoxStyle}" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ComboBoxItem Content="Custom Schedule" IsSelected="True"/>
                                </ComboBox>
                                <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CustomRuleEnabled}" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Border Background="{StaticResource WindowSecondaryBackgroundBrush}" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE162;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Weekdays" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13"/>
                                            <TextBlock Text="Mon – Fri" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="9:00 AM – 5:00 PM" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13"/>
                                            <TextBlock Text="Work hours" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="Smart Mode" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13"/>
                                            <TextBlock Text="Balanced performance" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock Text="ⓘ Rules are evaluated in order. The first matching rule will be applied." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,16,0,0"/>

                </StackPanel>
            </StackPanel>

            <!-- Right Rail -->
            <StackPanel Grid.Column="1">
                
                <!-- Summary Card -->
                <Border Background="{StaticResource ElevatedCardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Auto Switch Summary" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                        <TextBlock Text="Here's how AxePower will respond:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,24"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0">
                                <Ellipse Fill="{StaticResource BeastBrush}" Opacity="0.1"/>
                                <TextBlock Text="&#xE9A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource BeastBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When plugged in" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13"/>
                                <TextBlock Text="Switch to Beast Mode" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource BeastBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0">
                                <Ellipse Fill="{StaticResource EcoBrush}" Opacity="0.1"/>
                                <TextBlock Text="&#xE9A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource EcoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When unplugged" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13"/>
                                <TextBlock Text="Switch to Eco Mode" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource EcoBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0">
                                <Ellipse Fill="{StaticResource WarningBrush}" Opacity="0.1"/>
                                <TextBlock Text="&#xEBAA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When battery below 30%" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13"/>
                                <TextBlock Text="Switch to Eco Mode" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource EcoBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0">
                                <Ellipse Fill="{StaticResource AccentBrush}" Opacity="0.1"/>
                                <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Custom schedule" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13"/>
                                <TextBlock Text="Weekdays, 9:00 AM – 5:00 PM&#x0a;Switch to Smart Mode" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SmartBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- General Options Card -->
                <Border Background="{StaticResource ElevatedCardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="General Options" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Show notifications" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShowNotifications}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Start with Windows" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- Centered Apply Changes Button (Overflowing the bottom bar) -->
        <Button Grid.Row="1" Style="{StaticResource PrimaryButtonStyle}" 
                Command="{Binding SaveSettingsCommand}" 
                Margin="0,-38,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="32,16" Background="#222" BorderBrush="#444" BorderThickness="1" Panel.ZIndex="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="Apply Changes" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Bottom Status Region -->
        <Border Grid.Row="1" Background="{StaticResource WindowSecondaryBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="32" Height="32" Margin="0,0,16,0">
                        <Ellipse Fill="{StaticResource ElevatedCardBackgroundBrush}" Stroke="{StaticResource CardBorderBrush}" StrokeThickness="1" />
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Auto switch enabled" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock Text="AxePower is monitoring your power conditions." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SidebarButtonStyle}" Padding="16,8" Height="32" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Help" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Padding="16,8" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Check for updates" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
