<UserControl x:Class="AxePower.App.Views.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="728" d:DesignWidth="1040">
             
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,32,40,24">
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Main Area (Left) -->
            <StackPanel Grid.Column="0" Margin="0,0,32,0">
                <!-- Header -->
                <TextBlock Text="Game Mode &amp; Boost" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Optimize your system for gaming by closing background apps and managing system services." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="15" Margin="0,0,0,32"/>

                <StackPanel>
                    
                    <!-- Manual Game Mode Toggle -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Image Grid.Column="0" Source="/Resources/Gamemode.png" Width="72" Height="72" Margin="0,0,24,0" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Manual Game Mode" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,4"/>
                                <TextBlock Text="Instantly apply Beast mode, close background apps, and stop unnecessary services." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <Button Grid.Column="2" Command="{Binding ToggleManualGameModeCommand}" Padding="24,12" Height="48" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Turn On Game Mode" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsManualGameModeActive}" Value="True">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Turn Off Game Mode" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Game Mode Rule -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                    <Ellipse Fill="{DynamicResource PrimaryBlueBrush}" Opacity="0.15"/>
                                    <Image Source="/Resources/icons/controller.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Game Mode &amp; App Switch" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="Automatically switch to Beast mode when these apps are running." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AppRulesEnabled}" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ClearAllRulesCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Clear All" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ScanForGamesCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE10C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Scan for Games" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddRuleCommand}" Padding="16,8" Height="32">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Add App" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Added Items -->
                                    <ItemsControl ItemsSource="{Binding AppRules}">
                                        <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ExecutableName}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1" Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding DataContext.AvailableModes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding TargetMode}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SidebarButtonStyle}" Width="32" Height="32" Padding="0">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Game Booster -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                    <Ellipse Fill="{DynamicResource WarningBrush}" Opacity="0.15"/>
                                    <Image Source="/Resources/icons/boost.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Game Booster (Background Apps)" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap">
                                        <Run Text="WARNING: " Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
                                        <Run Text="Automatically close selected background apps to free up RAM when Game Mode activates."/>
                                    </TextBlock>
                                </StackPanel>
                                
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding GameBoosterEnabled}" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding SelectAllAppsCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Select All" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding DeselectAllAppsCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE739;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Deselect All" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding KillSelectedNowCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE10B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Kill Selected Now" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding RefreshBackgroundAppsCommand}" Padding="16,8" Height="32">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE149;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Refresh Active Apps" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    
                                    <TextBlock Text="Select apps to close during Game Mode:" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RunningBackgroundApps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- System Services Optimizer -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                    <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="System Services Optimizer" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="Select heavy, non-essential Windows services to stop and set to Manual mode to free up system resources." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            
                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OptimizeSelectedServicesCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Optimize Selected Services" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding RefreshServicesCommand}" Padding="16,8" Height="32">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE149;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Refresh" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    
                                    <TextBlock Text="Select services to set to Manual:" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding AvailableServices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ServiceName}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                        
                                                        <Border Grid.Column="3" Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="6,2" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Running" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>
        
        <!-- Bottom Status Region -->
        <Border Grid.Row="1" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding SaveSettingsCommand}" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,8" Background="#222" BorderBrush="#444" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Save Configuration" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="32" Height="32" Margin="0,0,16,0">
                        <Ellipse Fill="{DynamicResource ElevatedCardBackgroundBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" />
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Game Mode Status" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock Text="Configure optimizations" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
