<UserControl x:Class="AxePower.App.Views.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a11y="clr-namespace:AxePower.App.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:AxePower.App.Converters"
             xmlns:controls="clr-namespace:AxePower.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:SparklinePathConverter x:Key="SparklinePathConverter" />
        <converters:PercentageToGridLengthConverter x:Key="PercentageToGridLengthConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Ghost action button style for inline links -->
        <Style x:Key="ActionLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Purple Master Game Mode Toggle Switch (matches Image 1) -->
        <Style x:Key="MasterPurpleToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="border" Width="52" Height="28" CornerRadius="14"
                                    Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                                <Ellipse x:Name="ellipse" Width="18" Height="18" Fill="#94A3B8" HorizontalAlignment="Left" Margin="4,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="TranslateTransform" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A855F7" />
                                <Setter TargetName="border" Property="BorderThickness" Value="0" />
                                <Setter TargetName="ellipse" Property="Fill" Value="#1A102A" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TranslateTransform" Storyboard.TargetProperty="X" To="25" Duration="{a11y:Motion 0:0:0.16}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TranslateTransform" Storyboard.TargetProperty="X" To="0" Duration="{a11y:Motion 0:0:0.16}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact blue toggle used by the hero card automation switches -->
        <Style x:Key="MiniToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="border" Width="46" Height="25" CornerRadius="12.5"
                                    Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                                <Ellipse x:Name="ellipse" Width="17" Height="17" Fill="#94A3B8" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="TranslateTransform" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E7FF0" />
                                <Setter TargetName="border" Property="BorderThickness" Value="0" />
                                <Setter TargetName="ellipse" Property="Fill" Value="#FFFFFF" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TranslateTransform" Storyboard.TargetProperty="X" To="22" Duration="{a11y:Motion 0:0:0.16}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TranslateTransform" Storyboard.TargetProperty="X" To="0" Duration="{a11y:Motion 0:0:0.16}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========================================================= -->
            <!-- HEADER (Gamepad Icon + Title + Description)               -->
            <!-- ========================================================= -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Game Mode &amp; Boost" Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Optimize your system for gaming by closing background apps and managing system services."
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13.5"/>
            </StackPanel>

            <!-- ========================================================= -->
            <!-- MAIN COCKPIT LAYOUT (Full-width Hero + 2x2 Even Cards)    -->
            <!-- ========================================================= -->
            <StackPanel Grid.Row="1">

                    <!-- HERO CARD: Game Mode wordmark, master toggle, live stats & quick automation -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}"
                            BorderBrush="#00D2FF" BorderThickness="1.5" CornerRadius="16"
                            Padding="18,14" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#00D2FF" BlurRadius="18" Opacity="0.25" ShadowDepth="0"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- ZONE 1: Lion emblem (the artwork carries its own neon ring, so no extra chrome) -->
                            <Image Grid.Column="0" Source="/Resources/Gamemode.png" Stretch="Uniform"
                                   Width="112" Height="112" VerticalAlignment="Center" Margin="4,0,26,0"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="26" Opacity="0.7" ShadowDepth="0"/>
                                </Image.Effect>
                            </Image>

                            <!-- ZONE 2: Wordmark + master toggle above the live stat strip -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,26,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="GAMEMODE" FontSize="38" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <!-- Wordmark lights up while Game Mode is engaged -->
                                                    <DataTrigger Binding="{Binding IsManualGameModeActive}" Value="True">
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#A855F7" BlurRadius="20" Opacity="0.9" ShadowDepth="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <CheckBox Style="{StaticResource MasterPurpleToggleSwitchStyle}"
                                              IsChecked="{Binding IsManualGameModeActive, Mode=TwoWay}"
                                              ToolTip="{Binding GameModeStatusHeader}"
                                              VerticalAlignment="Center" Margin="26,4,0,0"/>
                                </StackPanel>

                                <!-- Stat strip: labels on row 0, values aligned together on row 1 -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ACTIVE GAME" VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold"
                                               LineHeight="14" LineStackingStrategy="BlockLineHeight" Margin="0,0,16,7"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold"
                                               LineHeight="14" LineStackingStrategy="BlockLineHeight" Margin="0,0,16,7"><Run Text="SERVICES"/><LineBreak/><Run Text="PAUSED"/></TextBlock>
                                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold"
                                               LineHeight="14" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,7"><Run Text="RAM"/><LineBreak/><Run Text="FREED"/></TextBlock>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ActiveGameName}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource PrimaryTextBrush}" FontSize="17" FontWeight="Bold" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServicesPausedCountText}"
                                               Foreground="{DynamicResource PrimaryTextBrush}" FontSize="17" FontWeight="Bold" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RamFreedText}"
                                               Foreground="{DynamicResource PrimaryTextBrush}" FontSize="17" FontWeight="Bold"/>
                                </Grid>
                            </Grid>

                            <!-- ZONE 3: Purge RAM action + automation switches, split off by a hairline rule -->
                            <Border Grid.Column="2" BorderBrush="#222C3D" BorderThickness="1,0,0,0" Padding="22,0,0,0" VerticalAlignment="Center">
                                <StackPanel Width="205">
                                    <Button Command="{Binding OptimizeRamNowCommand}" Cursor="Hand" Margin="0,0,0,14" HorizontalAlignment="Stretch"
                                            ToolTip="Flush the standby memory list right now">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#1C182F" BorderBrush="#8B5CF6" BorderThickness="1"
                                                        CornerRadius="9" Padding="14,8">
                                                    <Grid>
                                                        <TextBlock Text="Purge RAM" Foreground="#C4B5FD" FontWeight="SemiBold" FontSize="13.5"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                   Foreground="#C4B5FD" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#2A2246"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#A855F7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#171328"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Switch 1: Auto-Pause Heavy Services -->
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"
                                                   LineHeight="15" LineStackingStrategy="BlockLineHeight"><Run Text="Auto-Pause"/><LineBreak/><Run Text="Heavy Services"/></TextBlock>
                                        <CheckBox Grid.Column="1" Style="{StaticResource MiniToggleSwitchStyle}"
                                                  IsChecked="{Binding AutoPauseServicesInBeast, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Switch 2: Auto-Flush Standby RAM -->
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"
                                                   LineHeight="15" LineStackingStrategy="BlockLineHeight"><Run Text="Auto-Flush"/><LineBreak/><Run Text="Standby RAM"/></TextBlock>
                                        <CheckBox Grid.Column="1" Style="{StaticResource MiniToggleSwitchStyle}"
                                                  IsChecked="{Binding AutoFlushRamOnGameLaunch, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Switch 3: Auto-Restore on Exit -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"
                                                   LineHeight="15" LineStackingStrategy="BlockLineHeight"><Run Text="Auto-Restore"/><LineBreak/><Run Text="on Exit"/></TextBlock>
                                        <CheckBox Grid.Column="1" Style="{StaticResource MiniToggleSwitchStyle}"
                                                  IsChecked="{Binding AutoRestoreOnEco, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ========================================================= -->
                    <!-- ROW 1 (SIDE BY SIDE 60-40): Library & Game Controller    -->
                    <!-- ========================================================= -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Library (16:9 Landscape Banner Cards) -->
<Border Grid.Column="0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <!-- Header & Toolbar -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Library"
                                           Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionLinkButtonStyle}" Content="Add Custom (.exe)" Command="{Binding AddRuleCommand}" ToolTip="Browse and add a game executable"/>
                                    <TextBlock Text="|" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource ActionLinkButtonStyle}" Content="Scan Library" Command="{Binding RefreshInstalledGamesCommand}" ToolTip="Re-scan installed games from Steam and drives"/>
                                    <TextBlock Text="|" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0" VerticalAlignment="Center"/>
                                    <Button Command="{Binding ClearAllRulesCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Clear All Rules" Padding="4,2">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource WarningBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 3-Column Grid with Vertical Scroll (6 games directly visible in 3 cols x 2 rows) -->
                            <ScrollViewer MaxHeight="380"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          PanningMode="VerticalOnly"
                                          PreviewMouseWheel="LibraryScrollViewer_PreviewMouseWheel">
                                <ItemsControl ItemsSource="{Binding GameCards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Card Container (Landscape 16:9 Aspect Ratio, 3 per row) -->
                                            <Border x:Name="GameCardBorder" CornerRadius="10" Margin="5,6"
                                                    ClipToBounds="True" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="36"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Top 16:9 Banner Image Area (Strict 16:9 ratio, no cropping) -->
                                                    <controls:AspectRatioBox Grid.Row="0" AspectRatio="1.7777777777777777" ClipToBounds="True">
                                                        <Grid Background="{DynamicResource CardBackgroundBrush}">
                                                            <!-- Poster / Banner Image (Uniform avoids cropping) -->
                                                            <Image Source="{Binding PosterImage}" Stretch="Uniform"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasPoster, Converter={StaticResource BoolToVis}}"/>

                                                            <!-- Fallback Styled Banner if image loading/offline -->
                                                            <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" Visibility="{Binding HasPoster, Converter={StaticResource InverseBoolToVis}}">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8">
                                                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                                               FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- HOVER OVERLAY (Appears on Mouse Over with SETTINGS and PLAY buttons) -->
                                                            <Border Background="#C0090D14"
                                                                    Visibility="{Binding ElementName=GameCardBorder, Path=IsMouseOver, Converter={StaticResource BoolToVis}}">
                                                                <Grid>
                                                                    <!-- Center: SETTINGS & PLAY Buttons -->
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <!-- SETTINGS Button (Lime-green NVIDIA / AMD branded) -->
                                                                        <Button Command="{Binding OpenSettingsCommand}" Cursor="Hand" ToolTip="Open Graphics Settings in NVIDIA App / AMD Software" Margin="0,0,0,8">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{Binding GpuBrandBrush}" CornerRadius="4" Padding="18,5">
                                                                                        <TextBlock Text="SETTINGS" Foreground="#111827" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>

                                                                        <!-- PLAY Button (Bold White Text) -->
                                                                        <Button Command="{Binding PlayGameCommand}" Cursor="Hand" ToolTip="Launch Game">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="Transparent" CornerRadius="4" Padding="12,3">
                                                                                        <TextBlock Text="PLAY" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                    </StackPanel>

                                                                    <!-- Top Right: Delete/Remove Game Button -->
                                                                    <Button Command="{Binding RemoveCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                            Background="#80000000" BorderThickness="0" Width="22" Height="22"
                                                                            Margin="6" Cursor="Hand" ToolTip="Remove game from list">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                                                               Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>

                                                                    <!-- Bottom Right: Power Mode Badge (Click to cycle) -->
                                                                    <Button Command="{Binding CycleModeCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                            Margin="6" Cursor="Hand" ToolTip="Click to cycle Power Mode">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{Binding ModeBadgeBrush}" CornerRadius="4" Padding="6,2">
                                                                                    <TextBlock Text="{Binding ModeDisplayName}" Foreground="#FFFFFF"
                                                                                               FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </controls:AspectRatioBox>

                                                    <!-- Bottom Title Footer Bar -->
                                                    <Border Grid.Row="1" Background="{DynamicResource ElevatedCardBackgroundBrush}" Padding="10,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                        <!-- Right: Game Controller (Controller & Gopher) -->
<Border Grid.Column="1" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <!-- FEATURE 1: CONTROLLER DETECTION & COMPATIBILITY MODE -->
                            <!-- Header Row with Xbox / PS5 Compatibility Toggle -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Game Controller" Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>

                                <!-- Compatibility Toggle Button: Switch between Xbox and PS5 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Xbox" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPs5ModeSelected}" Value="False">
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <CheckBox Style="{DynamicResource ToggleSwitchStyle}"
                                              IsChecked="{Binding IsPs5ModeSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="Toggle between Xbox and PS5 controller compatibility"/>

                                    <TextBlock Text="PS5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPs5ModeSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Connected Status Row with Green / Grey Dot & Re-detect -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status Dot (Green when connected, Grey when disconnected) -->
                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#64748B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsControllerConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#10B981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <!-- Controller Status Text -->
                                <TextBlock Grid.Column="1" Text="{Binding ControllerStatusText}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <!-- Quick Re-detect Button -->
                                <Button Grid.Column="2" Command="{Binding RefreshControllerCommand}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Re-detect Controller" Padding="4">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Controller Image Display (Xbox or PS5 transparent PNG) -->
                            <Border Height="135" Margin="0,0,0,12" Background="Transparent">
                                <Image Source="{Binding ControllerImagePath}" Stretch="Uniform"
                                       Opacity="{Binding ControllerImageOpacity}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Dynamic Key Mapping Legend (Xbox A/X/B/Y vs PS5 Cross/Square/Triangle/Circle) -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding LeftStickLegend}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Action1Legend}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Action2Legend}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DpadLegend}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ToggleShortcutLegend}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                                </StackPanel>
                            </Grid>

                            <!-- FEATURE 2: GOPHER CONTROLLER NAVIGATION (Bottom last row with single toggle & (i) help button) -->
                            <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="12,10" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Gopher Navigation Title & Description -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Gopher Controller"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontWeight="SemiBold" FontSize="12.5"/>
                                        <TextBlock Text="control Windows with controller"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- (i) Help Button -->
                                    <Button Grid.Column="1" Command="{Binding OpenControllerHelpCommand}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Gopher360 Help &amp; Controller Shortcuts Guide"
                                            VerticalAlignment="Center" Margin="0,0,10,0" Padding="4">
                                        <Border Width="22" Height="22" CornerRadius="11"
                                                Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" Foreground="#38BDF8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>

                                    <!-- Single Toggle Switch for Gopher -->
                                    <CheckBox Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}"
                                              IsChecked="{Binding IsControllerNavigationEnabled, Mode=OneWay}"
                                              Command="{Binding ToggleControllerNavigationCommand}"
                                              VerticalAlignment="Center"
                                              ToolTip="Turn Gopher Controller Navigation On or Off"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    </Grid>

                    <!-- ========================================================= -->
                    <!-- ROW 2 (SIDE BY SIDE 60-40): Booster & Telemetry          -->
                    <!-- ========================================================= -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Game Booster & Services Optimizer -->
<Border Grid.Column="0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <!-- Card Header -->
                            <TextBlock Text="Game Booster &amp; Services Optimizer" Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>

                            <!-- SUB-SECTION 1: Background Apps -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding AllAppsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"
                                              ToolTip="Select all / unselect all. Caution apps are never selected by this; tick them yourself."/>
                                    <TextBlock Text="Background Apps" Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Foreground="#F59E0B" FontSize="12" Margin="14,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="⚠ " FontWeight="Bold"/><Run Text="Close selected apps to free up RAM when Game Mode activates."/>
                                </TextBlock>

                                <Button Grid.Column="2" Command="{Binding KillSelectedNowCommand}"
                                        Background="#D97706" Foreground="#FFFFFF" BorderThickness="0"
                                        Padding="14,6" Height="28" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="Kill Selected Now" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Button>
                            </Grid>

                            <!-- Background Apps List Container -->
                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                <ScrollViewer MaxHeight="125" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RunningBackgroundApps}">
                                        <ItemsControl.GroupStyle>
                                            <!-- "Safe to close" above "Caution"; the rows arrive sorted from the view model -->
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Margin="0,4,0,2"
                                                                   Foreground="{DynamicResource MutedTextBrush}" Typography.Capitals="AllSmallCaps"/>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,3" ToolTip="{Binding CautionReason}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding ProcessName, StringFormat='Select {0}'}"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#F59E0B" Margin="0,0,6,0"
                                                                   VerticalAlignment="Center" Visibility="{Binding IsCaution, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding ProcessName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Status badge: red while running, grey once closed -->
                                                    <Border Grid.Column="2" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#3B1219"/>
                                                                <Setter Property="BorderBrush" Value="#881B24"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsKilled}" Value="True">
                                                                        <Setter Property="Background" Value="#1F2937"/>
                                                                        <Setter Property="BorderBrush" Value="#374151"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsKilled}" Value="True">
                                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- SUB-SECTION 2: System Services -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding AllServicesSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"
                                              ToolTip="Select all / unselect all. Caution services are never selected by this; tick them yourself."/>
                                    <TextBlock Text="System Services" Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding OptimizeSelectedServicesCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" Padding="12,4" Height="26" FontSize="11.5">
                                    <TextBlock Text="Optimize Services" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <!-- System Services List Container -->
                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" CornerRadius="8" Padding="14,10">
                                <ScrollViewer MaxHeight="125" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AvailableServices}">
                                        <ItemsControl.GroupStyle>
                                            <!-- "Safe to close" above "Caution"; the rows arrive sorted from the view model -->
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Margin="0,4,0,2"
                                                                   Foreground="{DynamicResource MutedTextBrush}" Typography.Capitals="AllSmallCaps"/>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,3" ToolTip="{Binding CautionReason}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding DisplayName, StringFormat='Select {0}'}"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#F59E0B" Margin="0,0,6,0"
                                                                   VerticalAlignment="Center" Visibility="{Binding IsCaution, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Status Badge (Paused vs Running) -->
                                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#0E3326"/>
                                                                <Setter Property="BorderBrush" Value="#136040"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                        <Setter Property="Background" Value="#3B1219"/>
                                                                        <Setter Property="BorderBrush" Value="#881B24"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding StatusText}"/>
                                                                    <Setter Property="Foreground" Value="#34D399"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                            <Setter Property="Foreground" Value="#F87171"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                        </StackPanel>
                    </Border>

                        <!-- Right: CPU & GPU Telemetry (40%) -->
                        <Border Grid.Column="1" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="10,0,0,0">
                            <StackPanel>
                                <!-- Header -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="CPU &amp; GPU TELEMETRY" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </Border>
                                </Grid>

                                <!-- 2x2 Telemetry Grid: CPU, GPU, RAM, NET -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- [CPU] Tile -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,4,8">
                                        <StackPanel>
                                            <StackPanel Margin="0,0,0,4">
                                                <TextBlock Text="CPU" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding CpuDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <!-- Sparkline Graph -->
                                            <Border Height="38" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                                                <Grid ClipToBounds="True">
                                                    <Grid Opacity="0.18">
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#38BDF8" BorderThickness="0,0,0,1"/>
                                                        <Border Grid.Column="0" Grid.RowSpan="2" BorderBrush="#38BDF8" BorderThickness="0,0,1,0"/>
                                                    </Grid>
                                                    <Viewbox Stretch="Fill">
                                                        <Canvas Width="100" Height="50">
                                                            <Path Data="{Binding CpuHistory, Converter={StaticResource SparklinePathConverter}, ConverterParameter='Fill;100;50'}">
                                                                <Path.Fill>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#5038BDF8" Offset="0.0"/>
                                                                        <GradientStop Color="#0038BDF8" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Path.Fill>
                                                            </Path>
                                                            <Path Data="{Binding CpuHistory, Converter={StaticResource SparklinePathConverter}, ConverterParameter='Line;100;50'}" Stroke="#38BDF8" StrokeThickness="1.5"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- [GPU] Tile -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4,0,0,8">
                                        <StackPanel>
                                            <StackPanel Margin="0,0,0,4">
                                                <TextBlock Text="{Binding GpuName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding GpuDisplay}" Foreground="#C084FC" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <!-- Sparkline Graph -->
                                            <Border Height="38" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                                                <Grid ClipToBounds="True">
                                                    <Grid Opacity="0.18">
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#C084FC" BorderThickness="0,0,0,1"/>
                                                        <Border Grid.Column="0" Grid.RowSpan="2" BorderBrush="#C084FC" BorderThickness="0,0,1,0"/>
                                                    </Grid>
                                                    <Viewbox Stretch="Fill">
                                                        <Canvas Width="100" Height="50">
                                                            <Path Data="{Binding GpuHistory, Converter={StaticResource SparklinePathConverter}, ConverterParameter='Fill;100;50'}">
                                                                <Path.Fill>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#50C084FC" Offset="0.0"/>
                                                                        <GradientStop Color="#00C084FC" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Path.Fill>
                                                            </Path>
                                                            <Path Data="{Binding GpuHistory, Converter={StaticResource SparklinePathConverter}, ConverterParameter='Line;100;50'}" Stroke="#C084FC" StrokeThickness="1.5"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- [RAM] Tile -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,4,0">
                                        <StackPanel>
                                            <StackPanel Margin="0,0,0,4">
                                                <TextBlock Text="RAM" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding MemoryDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <!-- Sparkline Graph -->
                                            <Border Height="38" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                                                <Grid ClipToBounds="True">
                                                    <Grid Opacity="0.18">
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#60A5FA" BorderThickness="0,0,0,1"/>
                                                        <Border Grid.Column="0" Grid.RowSpan="2" BorderBrush="#60A5FA" BorderThickness="0,0,1,0"/>
                                                    </Grid>
                                                    <Viewbox Stretch="Fill">
                                                        <Canvas Width="100" Height="50">
                                                            <Path Data="{Binding MemoryHistory, Converter={StaticResource SparklinePathConverter}, ConverterParameter='Fill;100;50'}">
                                                                <Path.Fill>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#5060A5FA" Offset="0.0"/>
                                                                        <GradientStop Color="#0060A5FA" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Path.Fill>
                                                            </Path>
                                                            <Path Data="{Binding MemoryHistory, Converter={StaticResource SparklinePathConverter}, ConverterParameter='Line;100;50'}" Stroke="#60A5FA" StrokeThickness="1.5"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- [NET] Tile -->
                                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4,0,0,0">
                                        <StackPanel>
                                            <StackPanel Margin="0,0,0,4">
                                                <TextBlock Text="{Binding NetworkName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding NetworkDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <!-- Sparkline Graph -->
                                            <Border Height="38" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                                                <Grid ClipToBounds="True">
                                                    <Grid Opacity="0.18">
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#F472B6" BorderThickness="0,0,0,1"/>
                                                        <Border Grid.Column="0" Grid.RowSpan="2" BorderBrush="#F472B6" BorderThickness="0,0,1,0"/>
                                                    </Grid>
                                                    <Viewbox Stretch="Fill">
                                                        <Canvas Width="100" Height="50">
                                                            <Path Data="{Binding NetworkHistory, Converter={StaticResource SparklinePathConverter}, ConverterParameter='Fill;100;50'}">
                                                                <Path.Fill>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#50F472B6" Offset="0.0"/>
                                                                        <GradientStop Color="#00F472B6" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Path.Fill>
                                                            </Path>
                                                            <Path Data="{Binding NetworkHistory, Converter={StaticResource SparklinePathConverter}, ConverterParameter='Line;100;50'}" Stroke="#F472B6" StrokeThickness="1.5"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Disks Storage List -->
                                <ItemsControl ItemsSource="{Binding Disks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding FreeSpaceDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9.5" Margin="16,1,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding UsageDisplay}" Foreground="{Binding StatusColorHex}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- Storage Bar Track -->
                                                    <Border Height="4.5" Background="{DynamicResource CardBorderBrush}" CornerRadius="2.25" ClipToBounds="True">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding UsedPercent, Converter={StaticResource PercentageToGridLengthConverter}}"/>
                                                                <ColumnDefinition Width="{Binding FreePercent, Converter={StaticResource PercentageToGridLengthConverter}}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{Binding StatusColorHex}" CornerRadius="2.25"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </Grid>

            </StackPanel>
        </Grid>
    </ScrollViewer>

</UserControl>
