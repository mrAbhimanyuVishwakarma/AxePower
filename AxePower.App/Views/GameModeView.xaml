<UserControl x:Class="AxePower.App.Views.GameModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="728" d:DesignWidth="1040">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,32,40,24">
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Main Area (Left) -->
            <StackPanel Grid.Column="0" Margin="0,0,32,0">
                <!-- Header -->
                <TextBlock Text="Game Mode &amp; Boost" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Optimize your system for gaming by closing background apps and managing system services." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="15" Margin="0,0,0,32"/>

                <StackPanel>
                    
                    <!-- Manual Game Mode Toggle -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Image Grid.Column="0" Source="/Resources/Gamemode.png" Width="72" Height="72" Margin="0,0,24,0" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Manual Game Mode" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,4"/>
                                <TextBlock Text="Instantly apply Beast mode, close background apps, and stop unnecessary services." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <Button Grid.Column="2" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ToggleManualGameModeCommand}" Padding="24,12" Height="48" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE7E8;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsManualGameModeActive}" Value="True">
                                                        <Setter Property="Text" Value="&#xE71A;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Turn On Game Mode"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsManualGameModeActive}" Value="True">
                                                        <Setter Property="Text" Value="Turn Off Game Mode"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Dynamic Mode Automation & Background Tuning -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                    <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Dynamic Mode Automation" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16"/>
                                        <Border Background="#1A06B6D4" BorderBrush="#3306B6D4" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="DYNAMIC TUNING" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Intelligently pause heavy background services in Beast mode and optimize RAM cache." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                                        Command="{Binding OptimizeRamNowCommand}"
                                        Padding="14,8" FontSize="12.5" VerticalAlignment="Center"
                                        ToolTip="Purge Windows standby RAM cache to free memory for games">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Purge RAM" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" CornerRadius="10" Padding="16,14">
                                <StackPanel>
                                    <!-- Option 1: Auto-Pause Services -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto-Pause Heavy Services in Beast / Game Mode" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Pauses SysMain, Windows Search Indexer, Telemetry, and Error Reporting while gaming." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding AutoPauseServicesInBeast}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Option 2: Auto-Flush RAM Cache -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto-Flush Standby RAM on High Performance Mode" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Frees standby memory cache pages into active physical RAM." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding AutoFlushRamOnGameLaunch}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Option 3: Auto-Restore on Eco -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto-Restore All Services on Eco / Balanced Mode" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Smoothly restarts previously paused background services when switching back to Eco." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding AutoRestoreOnEco}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Game Mode Rule -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                    <Ellipse Fill="{DynamicResource PrimaryBlueBrush}" Opacity="0.15"/>
                                    <Image Source="/Resources/icons/controller.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Game Mode &amp; App Switch" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="Automatically switch to Beast mode when these apps are running." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <CheckBox Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding AppRulesEnabled}" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" HorizontalAlignment="Right">
                                        <Button Style="{DynamicResource SidebarButtonStyle}" Command="{Binding ClearAllRulesCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Clear All" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource SidebarButtonStyle}" Command="{Binding ScanForGamesCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE10C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Scan for Games" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding AddRuleCommand}" Padding="16,8" Height="32">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Add App" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Added Items -->
                                    <ItemsControl ItemsSource="{Binding AppRules}">
                                        <ItemsControl.ItemTemplate>
                                             <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ExecutableName}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1" Style="{DynamicResource AppComboBoxStyle}" ItemsSource="{Binding DataContext.AvailableModes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding TargetMode}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{DynamicResource SidebarButtonStyle}" Width="32" Height="32" Padding="0">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Game Booster -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                    <Ellipse Fill="{DynamicResource WarningBrush}" Opacity="0.15"/>
                                    <Image Source="/Resources/icons/boost.png" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Game Booster (Background Apps)" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap">
                                        <Run Text="WARNING: " Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
                                        <Run Text="Automatically close selected background apps to free up RAM when Game Mode activates."/>
                                    </TextBlock>
                                </StackPanel>
                                
                                <CheckBox Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding GameBoosterEnabled}" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" HorizontalAlignment="Right">
                                        <Button Style="{DynamicResource SidebarButtonStyle}" Command="{Binding SelectAllAppsCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Select All" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource SidebarButtonStyle}" Command="{Binding DeselectAllAppsCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE739;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Deselect All" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource SidebarButtonStyle}" Command="{Binding KillSelectedNowCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE10B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Kill Selected Now" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource SidebarButtonStyle}" Command="{Binding RefreshBackgroundAppsCommand}" Padding="16,8" Height="32">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE149;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Refresh Active Apps" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    
                                    <TextBlock Text="Select apps to close during Game Mode:" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RunningBackgroundApps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- System Services Optimizer -->
                    <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0">
                                    <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="System Services Optimizer" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="Select heavy, non-essential Windows services to stop and set to Manual mode to free up system resources." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            
                            <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" HorizontalAlignment="Right">
                                        <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding OptimizeSelectedServicesCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Optimize Selected Services" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource SidebarButtonStyle}" Command="{Binding RefreshServicesCommand}" Padding="16,8" Height="32">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE149;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Refresh" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    
                                    <TextBlock Text="Select services to set to Manual:" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding AvailableServices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ServiceName}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                        
                                                        <Border Grid.Column="3" Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="6,2" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Running" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Right Rail (Controller Navigation & Game Tools) -->
            <StackPanel Grid.Column="1">
                <!-- Controller Navigation (Gopher360) -->
                <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Header with Help button and Switch -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Controller Navigation" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding OpenControllerHelpCommand}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4" Margin="0,0,8,0"
                                    ToolTip="Credit to - Gopher360&#x0a;Click for controller button mappings &amp; guide">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Button>

                            <CheckBox Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}"
                                      IsChecked="{Binding IsControllerNavigationEnabled, Mode=OneWay}"
                                      Command="{Binding ToggleControllerNavigationCommand}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Use gamepad or Xbox controller as Windows mouse &amp; keyboard navigation."
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,16"/>

                        <!-- Mapping Quick Reference -->
                        <Border Background="{DynamicResource WindowSecondaryBackgroundBrush}" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="QUICK CONTROLS" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Left Stick" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                    <TextBlock Text="Mouse Pointer" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="A Button" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                    <TextBlock Text="Left Click" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="X Button" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                    <TextBlock Text="Right Click" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="D-Pad" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                    <TextBlock Text="Arrow Keys" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Back + Start" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="Toggle On/Off" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Gaming Telemetry & Tips -->
                <Border Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Gaming Optimization" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="• Automatically switches to Beast mode when game processes are detected." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="16"/>
                        <TextBlock Text="• Suspends non-essential background processes to prevent micro-stuttering." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="16"/>
                        <TextBlock Text="• Throttles unnecessary Windows telemetry and services during gameplay." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </ScrollViewer>
        
        <!-- Bottom Status Region -->
        <Border Grid.Row="1" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="1" Style="{DynamicResource PrimaryButtonStyle}" 
                        Command="{Binding SaveSettingsCommand}" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,8" Background="#222" BorderBrush="#444" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Save Configuration" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="32" Height="32" Margin="0,0,16,0">
                        <Ellipse Fill="{DynamicResource ElevatedCardBackgroundBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1" />
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Game Mode Status" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock Text="Configure optimizations" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
