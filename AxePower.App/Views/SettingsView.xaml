<UserControl x:Class="AxePower.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:AxePower.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="728" d:DesignWidth="1040">

    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <!-- Declared locally as well as in App.xaml so the view can be constructed standalone -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="69"/>
        </Grid.RowDefinitions>
        
        <ScrollViewer Grid.Row="0" Margin="40,32,40,24" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" Margin="0,0,40,0" MaxWidth="920">
                <!-- Header -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="Settings" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Customize AxePower to fit your needs." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="15"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column -->
                    <StackPanel Grid.Column="0">
                        <!-- General -->
                        <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,16" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource PrimaryBlueBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <StackPanel>
                                        <TextBlock Text="General" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Text="Basic app preferences." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Temperature unit" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Style="{DynamicResource AppComboBoxStyle}" ItemsSource="{Binding AvailableTemperatureUnits}" SelectedItem="{Binding SelectedTemperatureUnit}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Display refresh rate" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Style="{DynamicResource AppComboBoxStyle}" ItemsSource="{Binding AvailableRefreshRates}" SelectedItem="{Binding SelectedRefreshRate}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Touchpad" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding IsTouchpadEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Notifications -->
                        <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,16" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource PrimaryBlueBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Notifications" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Text="Manage alerts and notifications." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Show notifications" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding ShowNotifications}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Notify on mode switch" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding NotifyOnModeSwitch}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Notify when battery below" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Style="{DynamicResource AppComboBoxStyle}">
                                        <ComboBoxItem Content="30%" IsSelected="True"/>
                                    </ComboBox>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Low battery alert sound" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding LowBatteryAlertSound}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Performance Defaults -->
                        <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,16" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource PrimaryBlueBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Performance Defaults" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Text="Set default preferences for power modes." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Default mode on battery" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Style="{DynamicResource AppComboBoxStyle}"
                                              ItemsSource="{Binding AvailablePowerModeItems}"
                                              SelectedValuePath="Mode"
                                              SelectedValue="{Binding SelectedUnpluggedMode}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding ColorHex}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Default mode when plugged in" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Style="{DynamicResource AppComboBoxStyle}"
                                              ItemsSource="{Binding AvailablePowerModeItems}"
                                              SelectedValuePath="Mode"
                                              SelectedValue="{Binding SelectedPluggedInMode}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding ColorHex}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fan mode on battery" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Style="{DynamicResource AppComboBoxStyle}"
                                              ItemsSource="{Binding AvailableFanModes}"
                                              SelectedItem="{Binding SelectedFanModeOnBattery}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SmartBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- Right Column -->
                    <StackPanel Grid.Column="2">
                        <!-- Startup -->
                        <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,16" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource PrimaryBlueBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Startup" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Text="Control how AxePower launches." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Launch AxePower on Windows startup" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding StartWithWindows}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Start minimized" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding StartMinimised}"/>
                                </Grid>

                                <Separator Background="{DynamicResource DividerBrush}" Margin="0,4,0,12"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Run as administrator" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding RunAsAdministrator, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>

                                <Button Content="Restart as administrator now" Command="{Binding RestartElevatedCommand}"
                                        Visibility="{Binding CanRestartElevated, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,4">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="elevBorder" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource PrimaryBlueBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="elevBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    <Setter TargetName="elevBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Theme -->
                        <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,16" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource PrimaryBlueBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Theme" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Text="Choose your preferred appearance." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Theme" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Style="{DynamicResource AppComboBoxStyle}" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Updates -->
                        <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,16" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource PrimaryBlueBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Updates" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Text="Keep AxePower up to date." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Check for updates automatically" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding AutoCheckUpdates}"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Download updates in the background" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding AutoDownloadUpdates}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Current version" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Last checked" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastCheckedDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Music (playback group; more groups arrive with later music features) -->
                        <Border Style="{DynamicResource CardElevatedStyle}" Margin="0,0,0,16" Padding="20"
                                DataContext="{Binding Music}" Visibility="{Binding Converter={StaticResource NotNullToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource PrimaryBlueBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Music" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,2"/>
                                        <TextBlock Text="Playback preferences for AxePower Music." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Allow volume boost up to 200%" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="A limiter keeps boosted audio from clipping. Windows' own volume is never changed." Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding AllowVolumeBoost}" VerticalAlignment="Center"
                                              AutomationProperties.Name="Allow volume boost up to 200%"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Resume playback on startup" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="When off, your last queue and position come back paused." Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding ResumePlaybackOnStartup}" VerticalAlignment="Center"
                                              AutomationProperties.Name="Resume playback on startup"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Bottom Status Region -->
        <Border Grid.Row="1" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0" VerticalAlignment="Center">
                <!-- Left: Check for Updates Button -->
                <Button HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding CheckForUpdatesCommand}" Cursor="Hand" IsEnabled="{Binding IsCheckingForUpdate, Converter={StaticResource InverseBool}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="chkBorder" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CheckButtonText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="chkBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                    <Setter TargetName="chkBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
