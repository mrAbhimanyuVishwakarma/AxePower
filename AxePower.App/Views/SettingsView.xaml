<UserControl x:Class="AxePower.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="728" d:DesignWidth="1040">
             
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>
        
        <ScrollViewer Grid.Row="0" Margin="40,32,40,24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left" Margin="0,0,40,0">
                <!-- Header -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="Settings" Foreground="{StaticResource PrimaryTextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Customize AxePower to match your preferences and workflow." Foreground="{StaticResource SecondaryTextBrush}" FontSize="15"/>
                </StackPanel>

                <!-- System Integration -->
                <TextBlock Text="System Integration" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,16"/>
                <Border Background="{StaticResource ElevatedCardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,32">
                    <StackPanel>
                        <!-- Start AxePower with Windows -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,16,0" Background="{StaticResource WindowSecondaryBackgroundBrush}">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,36,36" RadiusX="8" RadiusY="8"/>
                                </Grid.Clip>
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Start AxePower with Windows" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="Automatically launch AxePower in the background when you sign in." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CurrentSettings.StartWithWindows}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16"/>

                        <!-- Show notifications in action center -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,16,0" Background="{StaticResource WindowSecondaryBackgroundBrush}">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,36,36" RadiusX="8" RadiusY="8"/>
                                </Grid.Clip>
                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Show notifications in action center" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="Get notified when AxePower changes your power mode automatically." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CurrentSettings.ShowNotifications}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16"/>

                        <!-- Minimize to system tray -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,16,0" Background="{StaticResource WindowSecondaryBackgroundBrush}">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,36,36" RadiusX="8" RadiusY="8"/>
                                </Grid.Clip>
                                <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Minimize to system tray" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="Keep AxePower running in the system tray when closing the window." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CurrentSettings.StartMinimised}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Default Power Modes -->
                <TextBlock Text="Default Power Modes" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,16"/>
                <Border Background="{StaticResource ElevatedCardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,32">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="When plugged in" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="Set the default mode to apply when connected to AC power." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding CurrentSettings.PluggedInMode}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="When on battery" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="Set the default mode to apply when disconnected from power." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding CurrentSettings.UnpluggedMode}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- App Suspension -->
                <TextBlock Text="App Suspension" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,16"/>
                <Border Background="{StaticResource ElevatedCardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,32">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,16,0" Background="{StaticResource WindowSecondaryBackgroundBrush}">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,36,36" RadiusX="8" RadiusY="8"/>
                                </Grid.Clip>
                                <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Suspend background apps on battery" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="Automatically pause non-essential apps to maximize battery life." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CurrentSettings.SuspendBackgroundAppsOnBattery}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Apps to exclude" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="Selected apps will never be suspended by AxePower." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Edit List" Padding="16,8" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Personalization -->
                <TextBlock Text="Personalization" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,16"/>
                <Border Background="{StaticResource ElevatedCardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,32">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Theme" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="Choose the app's visual appearance." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding CurrentSettings.Theme}" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Accent Color" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" Margin="0,0,0,2"/>
                                <TextBlock Text="Customize the color of highlights and active elements." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Fake color swatches for UI mockup -->
                                <Ellipse Width="24" Height="24" Fill="#2979FF" Margin="0,0,8,0" Stroke="White" StrokeThickness="2"/>
                                <Ellipse Width="24" Height="24" Fill="#00C853" Margin="0,0,8,0"/>
                                <Ellipse Width="24" Height="24" Fill="#FF3D00" Margin="0,0,8,0"/>
                                <Ellipse Width="24" Height="24" Fill="#9C27B0" Margin="0,0,8,0"/>
                                <Ellipse Width="24" Height="24" Fill="#FFC107" Margin="0,0,8,0"/>
                                <Ellipse Width="24" Height="24" Fill="{StaticResource DividerBrush}" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1" StrokeDashArray="2,2"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Centered Save Button (Overflowing the bottom bar) -->
        <Button Grid.Row="1" Style="{StaticResource PrimaryButtonStyle}" 
                Command="{Binding SaveSettingsCommand}" 
                Margin="0,-38,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="48,16" Background="#222" BorderBrush="#444" BorderThickness="1" Panel.ZIndex="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="Save Changes" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        
        <!-- Bottom Status Region -->
        <Border Grid.Row="1" Background="{StaticResource WindowSecondaryBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="32" Height="32" Margin="0,0,16,0">
                        <Ellipse Fill="{StaticResource ElevatedCardBackgroundBrush}" Stroke="{StaticResource CardBorderBrush}" StrokeThickness="1" />
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Auto switch enabled" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock Text="AxePower is optimizing your system automatically." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding RestoreDefaultsCommand}" Padding="16,8" Height="32" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Restore Defaults" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Padding="16,8" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Help" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
