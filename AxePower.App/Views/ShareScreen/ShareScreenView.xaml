<UserControl x:Class="AxePower.App.Views.ShareScreen.ShareScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:AxePower.App.Converters"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels.ShareScreen"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShareScreenViewModel, IsDesignTimeCreatable=False}"
             Background="#090B10"
             AutomationProperties.Name="Friends">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#AEB7C7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#242934"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="#8D97A8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" Background="Transparent" CornerRadius="6" Margin="2"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Indicator" Height="2" Background="#EF3340" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#1B2029"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CallButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Foreground" Value="#F7F9FC"/>
            <Setter Property="Background" Value="#242A35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#343B49"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShareButton" TargetType="Button" BasedOn="{StaticResource CallButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Background" Value="#19C875"/>
                    <Setter Property="Foreground" Value="#07150E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LeaveButton" TargetType="Button" BasedOn="{StaticResource CallButton}">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Background" Value="#FF3345"/>
        </Style>

        <Style x:Key="FriendActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#171B22"/>
            <Setter Property="Foreground" Value="#F7F9FC"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Collapsible Friends roster. The app's permanent navigation remains in MainWindow. -->
        <Border Grid.Column="0" Width="268" Background="#0D1118" BorderBrush="#202631" BorderThickness="0,0,1,0"
                Visibility="{Binding IsFriendsPanelOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="16,15,10,12">
                    <TextBlock Text="Friends" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Command="{Binding OpenJoinModalCommand}" ToolTip="Add a friend or join a room">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFriendsPanelCommand}" ToolTip="Collapse friends list">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="14,0,14,10" Height="38" Background="#131923" BorderBrush="#293140" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#738094" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding FriendSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                 Foreground="#F4F7FB" BorderThickness="0" FontSize="12" VerticalContentAlignment="Center"
                                 CaretBrush="#FFFFFF" ToolTip="Search friends" AutomationProperties.Name="Search friends"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="12,0,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Online" Command="{Binding SetFriendsFilterCommand}" CommandParameter="Online">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FriendsFilterTab}" Value="Online"><Setter Property="Foreground" Value="#FFFFFF"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1" Content="All" Command="{Binding SetFriendsFilterCommand}" CommandParameter="All">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FriendsFilterTab}" Value="All"><Setter Property="Foreground" Value="#FFFFFF"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2" Content="Live" Command="{Binding SetFriendsFilterCommand}" CommandParameter="Streams">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FriendsFilterTab}" Value="Streams"><Setter Property="Foreground" Value="#FFFFFF"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,4,10,8">
                    <ItemsControl ItemsSource="{Binding FilteredFriends}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#121720" CornerRadius="8" Padding="9" Margin="0,0,0,6" BorderBrush="#202734" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Margin="0,0,9,0">
                                            <Border Width="38" Height="38" CornerRadius="19" Background="#242C39">
                                                <TextBlock Text="{Binding Initials}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Ellipse Width="10" Height="10" Fill="{Binding StatusBadgeColor}" Stroke="#121720" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="#F5F7FA" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="#8994A5" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource FriendActionButton}" ToolTip="Call or join"
                                                    Command="{Binding DataContext.CallFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets"/>
                                            </Button>
                                            <Button Style="{StaticResource FriendActionButton}" ToolTip="Watch screen"
                                                    Command="{Binding DataContext.WatchFriendStreamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"/>
                                            </Button>
                                            <Button Style="{StaticResource FriendActionButton}" ToolTip="Message"
                                                    Command="{Binding DataContext.MessageFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="4" Background="#0A0E14" BorderBrush="#202631" BorderThickness="0,1,0,0" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#273142" Margin="0,0,9,0">
                            <TextBlock Text="{Binding UserProfile.Initials}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserProfile.GamerTag}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#19C875" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Online" Foreground="#8E99AA" FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Friends settings">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Call and screen-share stage. -->
        <Grid Grid.Column="1" Background="#090B10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="16,12,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconButton}" Margin="0,0,8,0" Command="{Binding ToggleFriendsPanelCommand}"
                        Visibility="{Binding IsFriendsPanelOpen, Converter={StaticResource InverseBoolToVis}}" ToolTip="Show friends list">
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                </Button>
                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#222B39" Margin="0,0,10,0">
                    <TextBlock Text="{Binding FriendAvatarInitial}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CallTitle}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding PrivacyStatusColor}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PrivacyStatusText}" Foreground="{Binding PrivacyStatusColor}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding StartOrCopyInviteCommand}" Background="#1C2430" Foreground="#E9EEF5" BorderBrush="#303B4B" BorderThickness="1"
                            Padding="11,7" Margin="0,0,6,0" Cursor="Hand" ToolTip="Open a private room and copy its invite link">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding InviteButtonText}" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Border Background="#121821" BorderBrush="#252D3A" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"
                            Visibility="{Binding IsInCall, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="#B7C0CE" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ParticipantCountText}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleChatCommand}" ToolTip="Show chat and files">
                        <Grid>
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                            <Border Background="#FF3345" CornerRadius="7" MinWidth="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,-6,-8,0"
                                    Visibility="{Binding HasUnreadChat, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UnreadChatCount}" Foreground="#FFFFFF" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Participant tiles exist only after a room has actually been opened or joined. -->
            <Grid Grid.Row="1" Margin="16,0,16,10" Height="142"
                  Visibility="{Binding IsInCall, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#141A23" BorderBrush="#283141" BorderThickness="1" CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Grid.ColumnSpan" Value="1"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFriendJoined}" Value="False">
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="Margin" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="62" Height="62" CornerRadius="31" Background="#293448">
                                <TextBlock Text="{Binding SelfAvatarInitial}" Foreground="#FFFFFF" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding TileName}" Foreground="#F5F7FA" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#153D2D" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                            <TextBlock Text="{Binding MicGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="#19C875" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="#141A23" BorderBrush="#19C875" BorderThickness="2" CornerRadius="10" Margin="6,0,0,0"
                        Visibility="{Binding IsFriendJoined, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="62" Height="62" CornerRadius="31" Background="#293448">
                                <TextBlock Text="{Binding FriendAvatarInitial}" Foreground="#FFFFFF" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding FriendName}" Foreground="#F5F7FA" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#10161F" BorderBrush="#2B3544" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#B6C0CF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="Tile" Grid.Row="2" Background="#07090D" BorderBrush="#222A36" BorderThickness="1" CornerRadius="10"
                    Margin="16,0,16,10" ClipToBounds="True" MinHeight="260">
                <Grid>
                    <wv2:WebView2 x:Name="PreviewBrowser" Visibility="Collapsed"/>

                    <StackPanel x:Name="TilePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="30">
                        <Border Width="76" Height="76" CornerRadius="38" Background="#151C26" BorderBrush="#2C3747" BorderThickness="1">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#6F7D91" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TileHeadline" Text="Your screen isn't being shared" Foreground="#F7F9FC" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock x:Name="TileSubtext" Text="Start a private room, share a display, or call a saved friend." Foreground="#8793A5" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Button Command="{Binding ToggleSharingCommand}" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="16,9" Margin="0,0,8,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="Share screen" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenJoinModalCommand}" Background="#1C232E" Foreground="#FFFFFF" BorderBrush="#303A49" BorderThickness="1" Padding="16,9" Cursor="Hand" Content="Join room"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#DD0B0F15" BorderBrush="#26303D" BorderThickness="1" CornerRadius="8" Padding="11,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12"
                            Visibility="{Binding IsStageActive, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#19C875" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding FriendName, StringFormat={}{0} is sharing their screen}" Foreground="#E7ECF3" FontSize="11.5"/>
                            <TextBlock Text="  -  " Foreground="#69768A"/>
                            <TextBlock Text="{Binding StatsLine}" Foreground="#B4BECC" FontSize="11.5"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#E54B1F27" BorderBrush="#FF5967" BorderThickness="1" CornerRadius="8" Padding="12,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12"
                            Visibility="{Binding IsControlOffered, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ControlBannerText}" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center"/>
                            <Button Content="Stop control" Command="{Binding ToggleRemoteControlCommand}" Margin="12,0,0,0" Padding="9,4" Background="#FF3345" Foreground="#FFFFFF" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="12,0,12,14"
                  Visibility="{Binding IsInCall, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel>
                        <Button Style="{StaticResource CallButton}" Command="{Binding ToggleMicCommand}" ToolTip="Mute or unmute microphone">
                            <TextBlock Text="{Binding MicGlyph}" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <TextBlock Text="Mic" Foreground="#D6DCE5" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Style="{StaticResource CallButton}" Command="{Binding ToggleAudioCommand}" ToolTip="{Binding AudioTooltip}">
                            <TextBlock Text="{Binding AudioGlyph}" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <TextBlock Text="Audio" Foreground="#D6DCE5" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Style="{StaticResource ShareButton}" Command="{Binding ToggleSharingCommand}" ToolTip="{Binding ShareButtonTooltip}">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <TextBlock Text="Share Screen" Foreground="#D6DCE5" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Style="{StaticResource CallButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Call and sharing settings">
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <TextBlock Text="More" Foreground="#D6DCE5" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Width="1" Height="44" Background="#354050" Margin="10,4"/>
                    <StackPanel>
                        <Button Style="{StaticResource LeaveButton}" Command="{Binding DisconnectAllCommand}" ToolTip="Leave call">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <TextBlock Text="Leave" Foreground="#D6DCE5" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Button x:Name="FullscreenButton" Style="{StaticResource CallButton}" Click="OnToggleFullscreen" ToolTip="Fullscreen stage">
                            <TextBlock x:Name="FullscreenGlyph" Text="&#xE740;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <TextBlock Text="Expand" Foreground="#D6DCE5" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Collapsible Chat and Files dock. -->
        <Border Grid.Column="2" Width="350" Background="#0D1118" BorderBrush="#202631" BorderThickness="1,0,0,0"
                Visibility="{Binding IsChatOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Height="58" Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Chat" Command="{Binding SetConversationPanelTabCommand}" CommandParameter="Chat">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding ConversationPanelTab}" Value="Chat"><Setter Property="Foreground" Value="#FFFFFF"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1" Content="Files" Command="{Binding SetConversationPanelTabCommand}" CommandParameter="Files">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding ConversationPanelTab}" Value="Files"><Setter Property="Foreground" Value="#FFFFFF"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding CloseChatCommand}" ToolTip="Collapse panel">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding ConversationPanelTab}" Value="Chat"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="#253146" Margin="0,1,9,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SenderInitial}" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Sender}" Foreground="#F5F7FA" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding FormattedTime}" Foreground="#68758A" FontSize="10" Margin="7,1,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text}" Foreground="#D5DBE5" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>
                                            <Border Background="#141B25" BorderBrush="#2A3545" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,7,0,0"
                                                    Visibility="{Binding IsAttachment, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="7" Background="#172943" Margin="0,0,9,0">
                                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#5CA8FF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AttachmentName}" Foreground="#F4F7FA" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AttachmentSizeText}" Foreground="#778397" FontSize="10"/>
                                                        <TextBlock Text="{Binding AttachmentStatusText}" Foreground="#19C875" FontSize="9.5"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Save attachment"
                                                            Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding ConversationPanelTab}" Value="Files"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <TextBlock Text="Shared files" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Files are integrity checked, encrypted on this PC, and never opened automatically." Foreground="#7F8B9E" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding SharedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#141B25" BorderBrush="#2A3545" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#5CA8FF" FontSize="18" Margin="2,0,10,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding AttachmentName}" Foreground="#F4F7FA" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding AttachmentSizeText}" Foreground="#778397" FontSize="10"/>
                                                    <TextBlock Text="{Binding AttachmentStatusText}" Foreground="#19C875" FontSize="9.5"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Save attachment"
                                                        Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" Background="#0A0E14" BorderBrush="#202631" BorderThickness="0,1,0,0" Padding="11">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource IconButton}" Command="{Binding AttachFileCommand}" ToolTip="Attach a file (8 MB maximum)">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        </Button>
                        <Border Grid.Column="1" Background="#141A23" BorderBrush="#293240" BorderThickness="1" CornerRadius="8" Margin="5,0">
                            <TextBox Text="{Binding ChatInputText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#F4F7FA" BorderThickness="0"
                                     Padding="10,7" FontSize="12" CaretBrush="#FFFFFF" ToolTip="{Binding ChannelPlaceholderText}">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/></TextBox.InputBindings>
                            </TextBox>
                        </Border>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding SendMessageCommand}" ToolTip="Send message">
                            <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#5CA8FF"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Join/add dialog. Kept inside the page so the call remains visible behind it. -->
        <Grid Grid.ColumnSpan="3" Background="#B0000000" Panel.ZIndex="50" Visibility="{Binding IsJoinModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="430" Background="#111721" BorderBrush="#303A49" BorderThickness="1" CornerRadius="12" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Call or add a friend" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Command="{Binding CloseJoinModalCommand}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="Friend name" Foreground="#AAB4C4" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding FriendNameInput, UpdateSourceTrigger=PropertyChanged}" Background="#0C1118" Foreground="#FFFFFF" BorderBrush="#2D3746" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"/>
                    <TextBlock Text="Private room link or trusted LAN/VPN address" Foreground="#AAB4C4" FontSize="11" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding JoinAddressInput, UpdateSourceTrigger=PropertyChanged}" Background="#0C1118" Foreground="#FFFFFF" BorderBrush="#2D3746" BorderThickness="1" Padding="10,8"/>
                        <Button Grid.Column="1" Content="Paste" Command="{Binding PasteJoinAddressCommand}" Background="#202938" Foreground="#FFFFFF" BorderThickness="0" Padding="12,7" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding JoinStatusMessage}" Foreground="#FF7A86" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <CheckBox IsChecked="{Binding RememberFriend}" Content="Remember in my Friends list" Foreground="#C9D1DC" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Cancel" Command="{Binding CloseJoinModalCommand}" Background="Transparent" Foreground="#B4BECC" BorderBrush="#354050" BorderThickness="1" Padding="15,8" Margin="0,0,8,0"/>
                        <Button Content="Connect" Command="{Binding ConnectToRoomCommand}" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="18,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
