<UserControl x:Class="AxePower.App.Views.ShareScreen.ShareScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:AxePower.App.Converters"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels.ShareScreen"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShareScreenViewModel, IsDesignTimeCreatable=False}"
             Background="Transparent"
             AutomationProperties.Name="Friends">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" Background="Transparent" CornerRadius="6" Margin="2"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Indicator" Height="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CallButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ElevatedCardBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShareButton" TargetType="Button" BasedOn="{StaticResource CallButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ShareLiveBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LeaveButton" TargetType="Button" BasedOn="{StaticResource CallButton}">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Background" Value="{DynamicResource ShareDangerBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="FriendActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="RosterSectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,4,0,6"/>
        </Style>

        <!-- A friend's round avatar: their provider picture, otherwise their initial -->
        <DataTemplate x:Key="FriendAvatar">
            <Grid Width="38" Height="38">
                <Ellipse Fill="{DynamicResource HoverBackgroundBrush}"/>
                <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Collapsible Friends roster. The app's permanent navigation remains in MainWindow.
             Who you are is shown once, by the sidebar's profile item, so the roster has no footer. -->
        <Border Grid.Column="0" Width="268" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsFriendsPanelOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="16,15,10,12">
                    <TextBlock Text="Friends" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Friends settings" AutomationProperties.Name="Friends settings">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding OpenJoinModalCommand}" ToolTip="Add a friend or join a room" AutomationProperties.Name="Add a friend or join a room">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFriendsPanelCommand}" ToolTip="Collapse friends list">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="14,0,14,10" Height="38" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding FriendSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                 Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="12" VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource PrimaryTextBrush}" ToolTip="Search friends" AutomationProperties.Name="Search friends"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="12,0,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Online" Command="{Binding SetFriendsFilterCommand}" CommandParameter="Online">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FriendsFilterTab}" Value="Online"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1" Content="All" Command="{Binding SetFriendsFilterCommand}" CommandParameter="All">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FriendsFilterTab}" Value="All"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2" Content="Live" Command="{Binding SetFriendsFilterCommand}" CommandParameter="Streams">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FriendsFilterTab}" Value="Streams"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,4,10,8">
                    <StackPanel>

                        <!-- Signed out: rooms by link still work; friends need an account -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,2,0,10"
                                Visibility="{Binding AccountFriends.IsSignedOut, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock Text="Add friends by @username" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Sign in to see when friends are online and send them invites. Room links work without an account."
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,10" LineHeight="16"/>
                                <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding AccountFriends.Account.OpenSignInCommand}" Padding="0,8" FontSize="12.5">
                                    <TextBlock Text="Sign in"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Requests -->
                        <StackPanel Visibility="{Binding AccountFriends.HasRequests, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" Margin="0,0,0,6">
                            <TextBlock Text="{Binding AccountFriends.RequestsHeader}" Style="{StaticResource RosterSectionHeader}"/>
                            <ItemsControl ItemsSource="{Binding AccountFriends.Incoming}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="9" Margin="0,0,0,6" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FriendAvatar}" Margin="0,0,9,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="wants to be friends" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource FriendActionButton}" ToolTip="Accept" AutomationProperties.Name="Accept"
                                                            Command="{Binding DataContext.AccountFriends.AcceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource FriendActionButton}" ToolTip="Decline" AutomationProperties.Name="Decline"
                                                            Command="{Binding DataContext.AccountFriends.DeclineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding AccountFriends.Outgoing}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="9" Margin="0,0,0,6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FriendAvatar}" Margin="0,0,9,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="Request sent" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource FriendActionButton}" ToolTip="Cancel request" AutomationProperties.Name="Cancel request"
                                                        Command="{Binding DataContext.AccountFriends.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Friends on the account -->
                        <TextBlock Text="FRIENDS" Style="{StaticResource RosterSectionHeader}"
                                   Visibility="{Binding AccountFriends.IsSignedIn, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                        <TextBlock Text="No friends yet. Use + to add someone by @username." Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="4,2,4,10"
                                   Visibility="{Binding AccountFriends.ShowsNoFriendsHint, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                        <TextBlock Text="{Binding AccountFriends.NoneInFilterText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="4,2,4,10"
                                   Visibility="{Binding AccountFriends.ShowsNoneInFilterHint, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                        <ItemsControl ItemsSource="{Binding AccountFriends.FilteredFriends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="9" Margin="0,0,0,6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,9,0">
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FriendAvatar}"/>
                                                <Ellipse Width="11" Height="11" Fill="{Binding StatusColor}" Stroke="{DynamicResource CardBackgroundBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Handle}"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource FriendActionButton}" ToolTip="Invite to a call" AutomationProperties.Name="Invite to a call"
                                                        Command="{Binding DataContext.AccountFriends.InviteToCallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets"/>
                                                </Button>
                                                <Button Style="{StaticResource FriendActionButton}" ToolTip="Invite to watch your screen" AutomationProperties.Name="Invite to watch your screen"
                                                        Command="{Binding DataContext.AccountFriends.InviteToWatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"/>
                                                </Button>
                                                <Button Style="{StaticResource FriendActionButton}" ToolTip="More" AutomationProperties.Name="More"
                                                        Tag="{Binding DataContext.AccountFriends, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="OpenFriendMenu_Click">
                                                    <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"/>
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Remove friend"
                                                                      Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Block"
                                                                      Command="{Binding PlacementTarget.Tag.BlockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Saved rooms: the older local contacts (a name and a room link), kept so nothing breaks -->
                        <TextBlock Text="SAVED ROOMS" Style="{StaticResource RosterSectionHeader}" Margin="4,10,0,6"
                                   Visibility="{Binding HasSavedRooms, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding FilteredFriends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="9" Margin="0,0,0,6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,9,0">
                                                <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource HoverBackgroundBrush}">
                                                    <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Ellipse Width="10" Height="10" Fill="{Binding StatusBadgeColor}" Stroke="{DynamicResource CardBackgroundBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatusDisplay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource FriendActionButton}" ToolTip="Call or join"
                                                        Command="{Binding DataContext.CallFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets"/>
                                                </Button>
                                                <Button Style="{StaticResource FriendActionButton}" ToolTip="Watch screen"
                                                        Command="{Binding DataContext.WatchFriendStreamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"/>
                                                </Button>
                                                <Button Style="{StaticResource FriendActionButton}" ToolTip="Message"
                                                        Command="{Binding DataContext.MessageFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Call and screen-share stage. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
            <Grid Margin="16,12,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconButton}" Margin="0,0,8,0" Command="{Binding ToggleFriendsPanelCommand}"
                        Visibility="{Binding IsFriendsPanelOpen, Converter={StaticResource InverseBoolToVis}}" ToolTip="Show friends list">
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                </Button>
                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource HoverBackgroundBrush}" Margin="0,0,10,0">
                    <TextBlock Text="{Binding FriendAvatarInitial}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CallTitle}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="17"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding PrivacyStatusColor}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PrivacyStatusText}" Foreground="{Binding PrivacyStatusColor}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding StartOrCopyInviteCommand}" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="11,7" Margin="0,0,6,0" Cursor="Hand" ToolTip="Open a private room and copy its invite link">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding InviteButtonText}" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"
                            Visibility="{Binding IsInCall, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ParticipantCountText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleChatCommand}" ToolTip="Show chat and files">
                        <Grid>
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                            <Border Background="{DynamicResource ShareDangerBrush}" CornerRadius="7" MinWidth="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,-6,-8,0"
                                    Visibility="{Binding HasUnreadChat, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UnreadChatCount}" Foreground="#FFFFFF" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Untrusted network: the room was not opened. One click allows it for this session only. -->
            <Border Margin="16,0,16,10" Padding="12,10" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource ShareDangerBrush}" Background="{DynamicResource CardBackgroundBrush}"
                    Visibility="{Binding IsUntrustedNetworkRefused, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource ShareDangerBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Room not opened on an untrusted network" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource ShareDangerBrush}"/>
                        <TextBlock Text="{Binding UntrustedNetworkWarning}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="Control, chat and voice are encrypted, but on a plain network the viewer page itself is not. Share only where you trust the other devices, or use Tailscale for HTTPS."
                                   FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ShareAnywayOnThisNetworkCommand}"
                            Padding="11,7" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                            ToolTip="Open the room on this network until the session ends">
                        <TextBlock Text="Share anyway for this session" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ShareDangerBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- A viewer with the right code asking for control: the code alone never lets them in. -->
            <Border Margin="16,0,16,10" Padding="12,10" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource ShareDangerBrush}" Background="{DynamicResource CardBackgroundBrush}"
                    Visibility="{Binding HasPendingControlApproval, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE962;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource ShareDangerBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Allow remote control?" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource ShareDangerBrush}"/>
                        <TextBlock Text="{Binding PendingControlApprovalText}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DenyControlRequestCommand}" Padding="11,7" Margin="0,0,6,0" Cursor="Hand">
                            <TextBlock Text="Deny" FontSize="11.5" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AllowControlRequestCommand}" Padding="11,7" Cursor="Hand"
                                ToolTip="They can move your mouse and type until they disconnect or you turn control off">
                            <TextBlock Text="Allow" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ShareDangerBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Everyone connected to this PC's room, so nothing watches, listens or controls unseen. -->
            <Border Margin="16,0,16,10" Padding="10,8" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardBackgroundBrush}"
                    Visibility="{Binding HasParticipants, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="In your room" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ParticipantsSummary}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Participants}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,4" Margin="0,0,6,6" BorderThickness="1" Background="{DynamicResource HoverBackgroundBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="Controller">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ShareDangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Role}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding Endpoint}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding ConnectedAt, StringFormat=' since {0:HH:mm}'}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Participant tiles exist only after a room has actually been opened or joined. -->
            <Grid Grid.Row="1" Margin="16,0,16,10" Height="142"
                  Visibility="{Binding IsInCall, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Grid.ColumnSpan" Value="1"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFriendJoined}" Value="False">
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="Margin" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="62" Height="62" CornerRadius="31" Background="{DynamicResource HoverBackgroundBrush}">
                                <TextBlock Text="{Binding SelfAvatarInitial}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding TileName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#2619C875" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                            <TextBlock Text="{Binding MicGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="2" CornerRadius="10" Margin="6,0,0,0"
                        Visibility="{Binding IsFriendJoined, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="62" Height="62" CornerRadius="31" Background="{DynamicResource HoverBackgroundBrush}">
                                <TextBlock Text="{Binding FriendAvatarInitial}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding FriendName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="Tile" Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10"
                    Margin="16,0,16,10" ClipToBounds="True" MinHeight="260">
                <Grid>
                    <wv2:WebView2 x:Name="PreviewBrowser" Visibility="Collapsed"/>

                    <StackPanel x:Name="TilePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="30">
                        <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource ElevatedCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TileHeadline" Text="Your screen isn't being shared" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock x:Name="TileSubtext" Text="Start a private room, share a display, or call a saved friend." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Button Command="{Binding ToggleSharingCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,9" Margin="0,0,8,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="Share screen" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenJoinModalCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="16,9" FontSize="12" Cursor="Hand" Content="Join room"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#DD0B0F15" BorderBrush="#26303D" BorderThickness="1" CornerRadius="8" Padding="11,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12"
                            Visibility="{Binding IsStageActive, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#19C875" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding FriendName, StringFormat={}{0} is sharing their screen}" Foreground="#E7ECF3" FontSize="11.5"/>
                            <TextBlock Text="  -  " Foreground="#69768A"/>
                            <TextBlock Text="{Binding StatsLine}" Foreground="#B4BECC" FontSize="11.5"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#E54B1F27" BorderBrush="#FF5967" BorderThickness="1" CornerRadius="8" Padding="12,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12"
                            Visibility="{Binding IsControlOffered, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ControlBannerText}" Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center"/>
                            <Button Content="Stop control" Command="{Binding ToggleRemoteControlCommand}" Margin="12,0,0,0" Padding="9,4" Background="{DynamicResource ShareDangerBrush}" Foreground="#FFFFFF" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="12,0,12,14"
                  Visibility="{Binding IsInCall, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel>
                        <Button Style="{StaticResource CallButton}" Command="{Binding ToggleMicCommand}" ToolTip="Mute or unmute microphone">
                            <TextBlock Text="{Binding MicGlyph}" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <TextBlock Text="Mic" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Style="{StaticResource CallButton}" Command="{Binding ToggleAudioCommand}" ToolTip="{Binding AudioTooltip}">
                            <TextBlock Text="{Binding AudioGlyph}" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <TextBlock Text="Audio" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Style="{StaticResource ShareButton}" Command="{Binding ToggleSharingCommand}" ToolTip="{Binding ShareButtonTooltip}">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <TextBlock Text="Share Screen" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Button Style="{StaticResource CallButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Call and sharing settings">
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <TextBlock Text="More" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Width="1" Height="44" Background="{DynamicResource DividerBrush}" Margin="10,4"/>
                    <StackPanel>
                        <Button Style="{StaticResource LeaveButton}" Command="{Binding DisconnectAllCommand}" ToolTip="Leave call">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <TextBlock Text="Leave" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Button x:Name="FullscreenButton" Style="{StaticResource CallButton}" Click="OnToggleFullscreen" ToolTip="Fullscreen stage">
                            <TextBlock x:Name="FullscreenGlyph" Text="&#xE740;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                        <TextBlock Text="Expand" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Collapsible Chat and Files dock. -->
        <Border Grid.Column="2" Width="350" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsChatOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Height="58" Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Chat" Command="{Binding SetConversationPanelTabCommand}" CommandParameter="Chat">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding ConversationPanelTab}" Value="Chat"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="1" Content="Files" Command="{Binding SetConversationPanelTabCommand}" CommandParameter="Files">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding ConversationPanelTab}" Value="Files"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding CloseChatCommand}" ToolTip="Collapse panel">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding ConversationPanelTab}" Value="Chat"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource HoverBackgroundBrush}" Margin="0,1,9,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SenderInitial}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Sender}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding FormattedTime}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="7,1,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>
                                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,7,0,0"
                                                    Visibility="{Binding IsAttachment, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="7" Background="#263B82F6" Margin="0,0,9,0">
                                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AttachmentName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AttachmentSizeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                                                        <TextBlock Text="{Binding AttachmentStatusText}" Foreground="{DynamicResource SuccessBrush}" FontSize="9.5"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Save attachment"
                                                            Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding ConversationPanelTab}" Value="Files"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <TextBlock Text="Shared files" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Files are integrity checked, encrypted on this PC, and never opened automatically." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding SharedFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="18" Margin="2,0,10,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding AttachmentName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding AttachmentSizeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                                                    <TextBlock Text="{Binding AttachmentStatusText}" Foreground="{DynamicResource SuccessBrush}" FontSize="9.5"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Save attachment"
                                                        Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource WindowSecondaryBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="11">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource IconButton}" Command="{Binding AttachFileCommand}" ToolTip="Attach a file (8 MB maximum)">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        </Button>
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="5,0">
                            <TextBox Text="{Binding ChatInputText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0"
                                     Padding="10,7" FontSize="12" CaretBrush="{DynamicResource PrimaryTextBrush}" ToolTip="{Binding ChannelPlaceholderText}">
                                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/></TextBox.InputBindings>
                            </TextBox>
                        </Border>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding SendMessageCommand}" ToolTip="Send message">
                            <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Join/add dialog. Kept inside the page so the call remains visible behind it. -->
        <Grid Grid.ColumnSpan="3" Background="#B0000000" Panel.ZIndex="50" Visibility="{Binding IsJoinModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="430" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Add a friend or join a room" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Command="{Binding CloseJoinModalCommand}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </Grid>
                    <!-- Add by @username (account friends) -->
                    <StackPanel Visibility="{Binding AccountFriends.IsSignedIn, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="Add a friend: type a name or @username" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding AccountFriends.AddUsername, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,8" AutomationProperties.Name="Friend's username">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AccountFriends.SendRequestCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Command="{Binding AccountFriends.SendRequestCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" FontSize="12" Margin="8,0,0,0"
                                    IsEnabled="{Binding AccountFriends.IsBusy, Converter={StaticResource InverseBool}}">
                                <TextBlock Text="Send request"/>
                            </Button>
                        </Grid>
                        <!-- Suggestions while typing -->
                        <Border Margin="0,6,0,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4"
                                Visibility="{Binding AccountFriends.HasSuggestions, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <ItemsControl ItemsSource="{Binding AccountFriends.Suggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FriendAvatar}" Margin="0,0,10,0">
                                                <ContentControl.LayoutTransform>
                                                    <ScaleTransform ScaleX="0.84" ScaleY="0.84"/>
                                                </ContentControl.LayoutTransform>
                                            </ContentControl>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Handle}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Padding="14,5" FontSize="11.5" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.AccountFriends.ActOnSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanAct, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{Binding ActionText}">
                                                <TextBlock Text="{Binding ActionText}"/>
                                            </Button>
                                            <TextBlock Grid.Column="2" Text="{Binding ActionText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Visibility="{Binding CanAct, Converter={StaticResource InverseBoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Text="No one found by that name. You can still send a request to an exact @username." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                   Visibility="{Binding AccountFriends.ShowsNoMatches, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                        <TextBlock Text="{Binding AccountFriends.AddStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AccountFriends.AddStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid Margin="0,14,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="or join a room with its link" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="10,0"/>
                            <Border Grid.Column="2" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Friend name" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding FriendNameInput, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"/>
                    <TextBlock Text="Private room link or trusted LAN/VPN address" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding JoinAddressInput, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,8"/>
                        <Button Grid.Column="1" Content="Paste" Command="{Binding PasteJoinAddressCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" FontSize="12" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding JoinStatusMessage}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <CheckBox IsChecked="{Binding RememberFriend}" Content="Remember in Saved rooms" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Cancel" Command="{Binding CloseJoinModalCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="15,8" FontSize="12" Margin="0,0,8,0"/>
                        <Button Content="Connect" Command="{Binding ConnectToRoomCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="18,8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
