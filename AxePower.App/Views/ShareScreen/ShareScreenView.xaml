<UserControl x:Class="AxePower.App.Views.ShareScreen.ShareScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:AxePower.App.Converters"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:vm="clr-namespace:AxePower.App.ViewModels.ShareScreen"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShareScreenViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource ShareStageBackgroundBrush}"
             AutomationProperties.Name="Share Screen">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Dark tooltip that reads on top of moving picture, like the reference. -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource ShareControlForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource ShareControlBarBrush}" CornerRadius="8" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round control-bar button. -->
        <Style x:Key="ShareCircleButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareControlForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ShareControlButtonBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="23">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShareControlButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The red stop button: wider, so it reads as the one destructive control. -->
        <Style x:Key="ShareStopButton" TargetType="Button" BasedOn="{StaticResource ShareCircleButton}">
            <Setter Property="Width" Value="68"/>
            <Setter Property="Background" Value="{DynamicResource ShareDangerBrush}"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="23">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ShareDangerHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Corner icons: no chrome until hovered. -->
        <Style x:Key="ShareGhostButton" TargetType="Button" BasedOn="{StaticResource ShareCircleButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ShareControlMutedBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- channel header -->
            <RowDefinition Height="*"/>      <!-- stage -->
            <RowDefinition Height="Auto"/>   <!-- control bar -->
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="22,16,22,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Foreground="{DynamicResource ShareControlMutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Text="Share Screen" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource ShareControlForegroundBrush}" VerticalAlignment="Center"/>

                <!-- Live chip -->
                <Border Background="{DynamicResource ShareControlButtonBrush}" CornerRadius="10" Padding="9,3" Margin="14,0,0,0"
                        Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ShareLiveBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="LIVE" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ShareControlForegroundBrush}"/>
                        <TextBlock Text="{Binding ElapsedText}" FontSize="11.5" Margin="9,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ShareControlMutedBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding RoomCode, StringFormat=Room {0}}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource ShareControlMutedBrush}"
                           Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding ViewerCountText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource ShareControlMutedBrush}"
                           Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatsLine}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource ShareControlMutedBrush}"
                           Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <!-- ═══ Stage ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="22,0,22,0">

            <!-- The tile. The video letterboxes itself inside, so the tile need not be 16:9. -->
            <Border x:Name="Tile" CornerRadius="10" Background="{DynamicResource ShareTileBackgroundBrush}"
                    BorderBrush="{DynamicResource ShareTileBorderBrush}" BorderThickness="1"
                    MaxWidth="1180" MaxHeight="720" Margin="0,4,0,14">
                <Grid>
                    <!-- The player. It is an HwndHost, so nothing WPF draws can sit on top of it:
                         the viewer name is injected into the page instead. -->
                    <wv2:WebView2 x:Name="PreviewBrowser" Visibility="Collapsed" Margin="1"/>

                    <!-- Idle / preview-off / connecting face of the tile -->
                    <StackPanel x:Name="TilePlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                        <Border Width="74" Height="74" CornerRadius="37" HorizontalAlignment="Center"
                                Background="{DynamicResource ShareControlButtonBrush}">
                            <TextBlock x:Name="TileGlyph" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                       Foreground="{DynamicResource ShareControlForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="TileHeadline" Text="Your screen isn't being shared" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ShareControlForegroundBrush}"
                                   HorizontalAlignment="Center" Margin="0,18,0,0"/>

                        <TextBlock x:Name="TileSubtext" Text="{Binding Settings.SourceSummary}" FontSize="12.5"
                                   Foreground="{DynamicResource ShareControlMutedBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" MaxWidth="520" Margin="0,7,0,0"/>

                        <TextBlock Text="{Binding Settings.ToolStatus}" FontSize="11.5"
                                   Foreground="{DynamicResource ShareControlMutedBrush}" Opacity="0.75"
                                   TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                                   MaxWidth="520" Margin="0,14,0,0"
                                   Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Starting up -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ShareControlMutedBrush}" Margin="0,0,0,8"/>
                        <ProgressBar Width="220" Height="3" IsIndeterminate="True" BorderThickness="0"
                                     Background="Transparent" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Remote control is on. Deliberately loud and always visible: the host must never
                 be able to forget that someone else has their keyboard. -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                    Background="{DynamicResource ShareDangerBrush}" CornerRadius="9" Padding="14,10"
                    Visibility="{Binding IsControlOffered, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ControlBannerText}" Foreground="#FFFFFF"
                               FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>

                    <Button Grid.Column="2" Content="Copy code" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CopyControlCodeCommand}" Margin="12,0,8,0" Padding="12,5" Height="28"
                            Visibility="{Binding IsControlActive, Converter={StaticResource InverseBoolToVis}}"/>

                    <Button Grid.Column="3" Content="Stop control" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleRemoteControlCommand}" Padding="12,5" Height="28"/>
                </Grid>
            </Border>

            <!-- Something went wrong -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0"
                    Background="#26DA373C" BorderBrush="{DynamicResource ShareDangerBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="14,10" MaxWidth="640"
                    Visibility="{Binding HasFault, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Sharing stopped" FontWeight="SemiBold" FontSize="12.5"
                               Foreground="{DynamicResource ShareControlForegroundBrush}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{DynamicResource ShareControlMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Encoder falling behind -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0"
                    Background="#26D9A441" BorderBrush="#66D9A441" BorderThickness="1"
                    CornerRadius="9" Padding="14,9" MaxWidth="640"
                    Visibility="{Binding ShowEncoderWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="The encoder is falling behind. If this keeps up, the quality drops a rung to protect smoothness."
                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ShareControlForegroundBrush}"/>
            </Border>
        </Grid>

        <!-- ═══ Control bar ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="16,0,16,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Invite, bottom-left -->
            <Button Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{StaticResource ShareGhostButton}" Content="&#xE8FA;"
                    Command="{Binding CopyViewerLinkCommand}"
                    ToolTip="Copy the invite link" AutomationProperties.Name="Copy the invite link"/>

            <!-- Centre pill -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource ShareControlBarBrush}" CornerRadius="26" Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ShareCircleButton}"
                                Content="{Binding AudioGlyph}"
                                Command="{Binding ToggleAudioCommand}"
                                ToolTip="{Binding AudioTooltip}" AutomationProperties.Name="Shared audio"/>

                        <Button Content="&#xE7F4;"
                                Command="{Binding ToggleSharingCommand}"
                                ToolTip="{Binding ShareButtonTooltip}" AutomationProperties.Name="Share your screen">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShareCircleButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ShareLiveBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Style="{StaticResource ShareCircleButton}" Content="&#xE890;"
                                Command="{Binding TogglePreviewCommand}"
                                ToolTip="Show or hide the preview" AutomationProperties.Name="Show or hide the preview"/>

                        <Button Content="{Binding ControlGlyph}"
                                Command="{Binding ToggleRemoteControlCommand}"
                                Visibility="{Binding ShowControlButton, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding ControlTooltip}" AutomationProperties.Name="Remote control">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShareCircleButton}">
                                    <Style.Triggers>
                                        <!-- Red the moment control is live, so it is never a quiet state. -->
                                        <DataTrigger Binding="{Binding IsControlOffered}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ShareDangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Style="{StaticResource ShareCircleButton}" Content="&#xE713;"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="Share Screen settings" AutomationProperties.Name="Share Screen settings"/>
                    </StackPanel>
                </Border>

                <!-- Stop, set apart from the pill -->
                <Button Style="{StaticResource ShareStopButton}" Content="&#xE71A;"
                        Command="{Binding StopSharingCommand}"
                        Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"
                        ToolTip="Stop sharing" AutomationProperties.Name="Stop sharing"/>
            </StackPanel>

            <!-- Open / fullscreen, bottom-right -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource ShareGhostButton}" Content="&#xE8A7;"
                        Command="{Binding OpenViewerLinkCommand}"
                        ToolTip="Open the stream in your browser" AutomationProperties.Name="Open the stream in your browser"/>
                <Button x:Name="FullscreenButton" Style="{StaticResource ShareGhostButton}" Content="&#xE740;"
                        Click="OnToggleFullscreen"
                        ToolTip="Fill the window with the preview" AutomationProperties.Name="Fill the window with the preview"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
