<UserControl x:Class="AxePower.App.Views.Shell.PatchNotesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:AxePower.App.ViewModels"
             xmlns:views="clr-namespace:AxePower.App.Views"
             xmlns:converters="clr-namespace:AxePower.App.Converters"
             xmlns:musicviews="clr-namespace:AxePower.App.Views.Music"
             mc:Ignorable="d">
    <!-- The Steam-style patch notes dialog: every release post with its reaction bar. Moved out of MainWindow.xaml unchanged (Prompt 20); its DataContext is the MainViewModel. -->
    <Grid Background="#C80A0E17"
          Visibility="{Binding AboutVm.IsSteamPatchNotesModalOpen, Converter={StaticResource BoolToVis}}">
        <Border Background="#202A36" BorderBrush="#354556" BorderThickness="1" CornerRadius="8"
                Width="780" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="10" Opacity="0.8"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Scrollable Feed of Patch Note Posts -->
                <ScrollViewer x:Name="PatchNotesScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,16,28">
                    <StackPanel>
                        <!-- ═══ POST: V2.1.0 (SEPTEMBER 30, 2026 - LATEST) ═══ -->
                        <StackPanel Margin="0,0,0,32">
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                    <TextBlock Text="UPDATE / PATCH NOTES" Foreground="#66C0F4" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                    <TextBlock Text="POSTED Wed, September 30, 2026" Foreground="#8F98A0" FontSize="11" Margin="10,0,0,0" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                </StackPanel>
                                <TextBlock Text="AxePower v2.1.0 - System Care, Update Controls &amp; Responsive Tools" Foreground="#FFFFFF" FontSize="22" FontWeight="Normal" TextWrapping="Wrap" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                            </StackPanel>

                            <TextBlock Text="A focused maintenance release that makes system care, updates, app removal, and software installs clearer and more reliable at every window size." Foreground="#C6D4DF" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Highlights" Foreground="#E1E7EE" FontSize="13.5" FontWeight="Bold" Margin="0,4,0,8"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="&#x2022; System Care: Optimizer and Doctor now share a collapsible workspace for recommended tweaks, repairs, cleanup, DNS tools, restore points, and terminal output." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="&#x2022; Windows Update: security-only update policy, signed-in reboot protection, update cache and service repair, and restore-point creation now perform their real Windows actions." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="&#x2022; Uninstaller: full-width Win32 and Windows Apps tables, visible app types, alphabetical sorting in both directions, batch selection, and Select All for leftovers." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="&#x2022; Software Hub: a collapsible category rail and responsive install controls keep every app row readable without clipping." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="&#x2022; Notifications and Game Mode: alert settings now drive runtime behavior, while mode cards distinguish a pending selection from the currently applied mode." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="&#x2022; Updater: background and manual updates share one verified download, handle slow connections, show progress and failures, and launch only a complete Windows installer." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="#2A3848" Margin="0,0,0,32"/>

                        <!-- ═══ POST: V2.0.9 (SEPTEMBER 27, 2026) ═══ -->
                        <StackPanel Margin="0,0,0,32">
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                    <TextBlock Text="UPDATE / PATCH NOTES" Foreground="#66C0F4" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                    <TextBlock Text="POSTED Sun, September 27, 2026" Foreground="#8F98A0" FontSize="11" Margin="10,0,0,0" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                </StackPanel>
                                <TextBlock Text="AxePower v2.0.9 - Routines &amp; Expanded Tools" Foreground="#FFFFFF" FontSize="22" FontWeight="Normal" TextWrapping="Wrap" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                            </StackPanel>

                            <TextBlock Text="Automate everyday PC tasks with If-Then routines, and reach more trusted maintenance tools from one place." Foreground="#C6D4DF" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Highlights" Foreground="#E1E7EE" FontSize="13.5" FontWeight="Bold" Margin="0,4,0,8"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="&#x2022; Routines: combine time, app, power, and battery conditions, then change power mode, manage apps, start a power timer, or show a notification." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="&#x2022; Undo: a routine can restore what it changed when its conditions stop; the newest routine wins when rules overlap." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="&#x2022; Timer &amp; Routines: live status and the complete routine editor are available from Tools." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="&#x2022; Tools: Revo Uninstaller and WizTree join the existing utilities, and every card uses the app's real icon." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="&#x2022; Polish: cleaner tray menus and more consistent controls and status areas across every skin." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="#2A3848" Margin="0,0,0,32"/>

                        <!-- ═══ POST: V2.0.8 (SEPTEMBER 26, 2026) ═══ -->
                        <StackPanel Margin="0,0,0,32">
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                    <TextBlock Text="UPDATE / PATCH NOTES" Foreground="#66C0F4" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                    <TextBlock Text="POSTED Sat, September 26, 2026" Foreground="#8F98A0" FontSize="11" Margin="10,0,0,0" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                </StackPanel>
                                <TextBlock Text="AxePower v2.0.8 - Accounts, Friends &amp; a Profile Page" Foreground="#FFFFFF" FontSize="22" FontWeight="Normal" TextWrapping="Wrap" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                            </StackPanel>

                            <TextBlock Text="An optional AxePower account, and Friends built on it: see who is online and what they are playing, and invite them to a call or to watch your screen." Foreground="#C6D4DF" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Highlights" Foreground="#E1E7EE" FontSize="13.5" FontWeight="Bold" Margin="0,4,0,8"/>
                            <StackPanel Margin="12,0,0,16">
                                <TextBlock Text="• AxePower Account: optional sign-in with Google, GitHub, Discord, Steam or email. Your name and picture sit at the bottom of the sidebar." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Profile: About is now Profile, with your account plus version, updates, release notes and support in one place." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Friends: add people by @username with suggestions as you type, accept requests, and see who is online and what they are playing." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Invites: invite a friend to a call or to watch your screen. They get a pop-up with Join on any page." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Privacy: hide what you are doing, appear offline, choose whether people can find you by name, and manage blocked people in Settings, Friends." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Fixes: the Game Mode card keeps its name in small windows, a muted microphone shows a crossed-out mic, and buttons are readable in the Light skin." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>

                            <!-- Reaction Bar -->
                            <Border Background="#161F29" BorderBrush="#263442" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding AboutVm.RateUpPatchNotesCommand}" Background="#2B3948" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="rb1_v208" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="👍" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AboutVm.FormattedLikesCount}" Foreground="#66C0F4" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding AboutVm.HasLikes, Converter={StaticResource BoolToVis}}"/>
                                                            <TextBlock Text="Rate Up" Foreground="#C6D4DF" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="rb1_v208" Property="Background" Value="#384A5E"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Background="#2B3948" BorderThickness="0" Padding="10,6" Margin="6,0,0,0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="db1_v208" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="👎" FontSize="12" Foreground="#8F98A0" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="db1_v208" Property="Background" Value="#384A5E"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Command="{Binding AboutVm.DiscussPatchNotesCommand}" Background="#2B3948" BorderThickness="0" Padding="12,6" Margin="10,0,0,0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="cb1_v208" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="💬" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AboutVm.FormattedCommentsCount}" Foreground="#66C0F4" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding AboutVm.HasComments, Converter={StaticResource BoolToVis}}"/>
                                                            <TextBlock Text="Discuss" Foreground="#C6D4DF" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb1_v208" Property="Background" Value="#384A5E"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding AboutVm.SharePatchNotesCommand}" Background="#2B3948" BorderThickness="0" Padding="14,6" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="sb1_v208" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#C6D4DF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Share" Foreground="#C6D4DF" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="sb1_v208" Property="Background" Value="#384A5E"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Height="1" Background="#2A3848" Margin="0,0,0,32"/>

                        <!-- ═══ POST: V2.0.7 (SEPTEMBER 25, 2026) ═══ -->
                        <StackPanel Margin="0,0,0,32">
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                    <TextBlock Text="UPDATE / PATCH NOTES" Foreground="#66C0F4" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                    <TextBlock Text="POSTED Fri, September 25, 2026" Foreground="#8F98A0" FontSize="11" Margin="10,0,0,0" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                </StackPanel>
                                <TextBlock Text="AxePower v2.0.7 - Tools, 30 New Skins &amp; a New Settings Page" Foreground="#FFFFFF" FontSize="22" FontWeight="Normal" TextWrapping="Wrap" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                            </StackPanel>

                            <TextBlock Text="A Tools page for the apps gamers actually use, thirty new skins, a Settings page you can find things in, and battery details that match what your battery reports." Foreground="#C6D4DF" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Highlights" Foreground="#E1E7EE" FontSize="13.5" FontWeight="Bold" Margin="0,4,0,8"/>
                            <StackPanel Margin="12,0,0,16">
                                <TextBlock Text="• Tools: MSI Afterburner, CPU-Z, GPU-Z and CrystalDiskInfo on one page in the sidebar. Open what you have, install the rest from each publisher, and see what is running." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• 30 new skins, including Midnight Sakura, Synthwave Sunset, Deep Ocean, Matrix Terminal, Paper &amp; Ink, High Contrast and Frosted Rose Glass, the first light glass skin." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Settings: a category list you can fold into icons, one category per page, a little more compact, and Taskbar preferences to choose what the tray menu shows." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Battery: the real charge state (plugged in but not charging now says so), the battery's own temperature in °C or °F, its real serial number and manufacture date." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Touchpad: the switch in Settings now really turns the touchpad off and on, and follows Windows&#x27; own setting." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Friends: the whole page follows your skin, including glass skins. Its settings are now called Friends." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Fixes: skin names in the Theme list, the mouse wheel no longer flicks through themes, About icons and Check for updates follow every skin, and tray menu modes keep their colours." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>

                            <!-- Reaction Bar -->
                            <Border Background="#161F29" BorderBrush="#263442" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding AboutVm.RateUpPatchNotesCommand}" Background="#2B3948" BorderThickness="0" Padding="12,6" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="rb1_v207" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="👍" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AboutVm.FormattedLikesCount}" Foreground="#66C0F4" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding AboutVm.HasLikes, Converter={StaticResource BoolToVis}}"/>
                                                            <TextBlock Text="Rate Up" Foreground="#C6D4DF" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="rb1_v207" Property="Background" Value="#384A5E"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Background="#2B3948" BorderThickness="0" Padding="10,6" Margin="6,0,0,0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="db1_v207" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="👎" FontSize="12" Foreground="#8F98A0" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="db1_v207" Property="Background" Value="#384A5E"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Command="{Binding AboutVm.DiscussPatchNotesCommand}" Background="#2B3948" BorderThickness="0" Padding="12,6" Margin="10,0,0,0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="cb1_v207" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="💬" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AboutVm.FormattedCommentsCount}" Foreground="#66C0F4" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding AboutVm.HasComments, Converter={StaticResource BoolToVis}}"/>
                                                            <TextBlock Text="Discuss" Foreground="#C6D4DF" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb1_v207" Property="Background" Value="#384A5E"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding AboutVm.SharePatchNotesCommand}" Background="#2B3948" BorderThickness="0" Padding="14,6" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="sb1_v207" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#C6D4DF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Share" Foreground="#C6D4DF" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="sb1_v207" Property="Background" Value="#384A5E"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Height="1" Background="#2A3848" Margin="0,0,0,32"/>

                        <!-- ═══ POST: V2.0.6 (SEPTEMBER 25, 2026) ═══ -->
                        <StackPanel Margin="0,0,0,32">
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                    <TextBlock Text="UPDATE / PATCH NOTES" Foreground="#66C0F4" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                    <TextBlock Text="POSTED Fri, September 25, 2026" Foreground="#8F98A0" FontSize="11" Margin="10,0,0,0" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                                </StackPanel>
                                <TextBlock Text="AxePower v2.0.6 - Power Timer, Ambient Mode &amp; Real Battery Health" Foreground="#FFFFFF" FontSize="22" FontWeight="Normal" TextWrapping="Wrap" FontFamily="Segoe UI, Segoe UI Variable, Arial"/>
                            </StackPanel>

                            <TextBlock Text="A timer to shut down, restart or sleep your PC, full-screen Ambient Mode with lyrics that actually show up, an honest battery health reading, and a lot of tidying." Foreground="#C6D4DF" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Highlights" Foreground="#E1E7EE" FontSize="13.5" FontWeight="Bold" Margin="0,4,0,8"/>
                            <StackPanel Margin="12,0,0,16">
                                <TextBlock Text="• Power timer: shut down, restart or sleep after the time you type, from the button in the bottom-right corner of every page. The countdown turns red two minutes before, with an on-screen warning you can click to add time." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Ambient Mode: album art and synced lyrics fill the whole screen, and it can open by itself like a screensaver after 1, 2, 5 or 10 idle minutes while music plays. New headset icon, matched to every skin." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Lyrics: found for far more songs (the catalogue lookup had been failing on most YouTube titles), and lines now change within about 40 ms of being sung." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Music: a compact player, YT Music and Local Music switches in the header, Last played lists for each, the last 7 YouTube searches with their songs, and your YouTube queue restored after a restart." Foreground="#C6D4DF" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,6"/>
