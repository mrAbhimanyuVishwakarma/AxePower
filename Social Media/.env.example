# ========================================================
# AxePower Social Media Automation - Environment Variables
# ========================================================

# Publora (Unified Multi-Platform API for LinkedIn, X, Threads, Instagram, YouTube, TikTok)
PUBLORA_API_KEY=

# Google Gemini API (Used for automated copywriting)
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------
# 1. DISCORD
# --------------------------------------------------------
# Bot Token for review command center & interactive approval buttons
DISCORD_BOT_TOKEN=MTU0NDU5NzEyNjk0Njc1ODc1Nw.GrDSYt.FPnfDCEK0dZG8pPUCQKsEB9MZT5BuTf8_6Cgu4
# Discord Channel ID where preview drafts should be posted for review
DISCORD_REVIEW_CHANNEL_ID=1502505103456997467
# Discord Webhook URL for public announcements (optional, for direct webhook posting)
DISCORD_ANNOUNCEMENTS_WEBHOOK_URL=https://discord.com/api/webhooks/1552280167697616957/0SJue76HbUOsjfAiRrd4Dh0NIv1m_Ztb2FhhVVkXqHpo4hI4DAak-XMsVYvDmSX-2Jeo

# --------------------------------------------------------
# 2. X (TWITTER)
# --------------------------------------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# --------------------------------------------------------
# 3. LINKEDIN
# --------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
# Format: urn:li:person:XXXXXXX or urn:li:organization:XXXXXXX
LINKEDIN_AUTHOR_URN=

# --------------------------------------------------------
# 4. REDDIT
# --------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=windows:axepower.social:v1.0 (by /u/YOUR_REDDIT_USERNAME)
# Default target subreddit for posts (e.g. "windows", "pcmasterrace", or "u_YOUR_USERNAME" for your profile)
REDDIT_DEFAULT_SUBREDDIT=u_YOUR_REDDIT_USERNAME

# --------------------------------------------------------
# General Settings
# --------------------------------------------------------
AXEPOWER_WEBSITE_URL=https://axepower.app
AXEPOWER_DOWNLOAD_URL=https://axepower.app/download.html
AXEPOWER_GITHUB_URL=https://github.com/mrAbhimanyuVishwakarma/AxePower
