<Project>
  <PropertyGroup>
    <_RepoRootDir>$(MSBuildThisFileDirectory)</_RepoRootDir>
    <_InstallerRootDir>$(_RepoRootDir)Installer\</_InstallerRootDir>
    <_AppVersionIssPath>$(_InstallerRootDir)AppVersion.iss</_AppVersionIssPath>
    <_AxePowerIssPath>$(_InstallerRootDir)AxePower.iss</_AxePowerIssPath>
    <_AxePowerSetupIssPath>$(_InstallerRootDir)AxePowerSetup.iss</_AxePowerSetupIssPath>
  </PropertyGroup>

  <!--
    SyncInstallerVersion:
    Ensures Installer/AppVersion.iss reflects the authoritative ProductVersion defined in Directory.Build.props.
    Skipped if SkipVersionSync=true.
  -->
  <Target Name="SyncInstallerVersion"
          BeforeTargets="BeforeBuild"
          Condition="'$(MSBuildProjectName)' == 'AxePower' or '$(MSBuildProjectName)' == 'AxePower.App'">
    <PropertyGroup>
      <_ExpectedIssLine>#define AppVersion "$(ProductVersion)"</_ExpectedIssLine>
      <_CurrentIssText Condition="Exists('$(_AppVersionIssPath)')">$([System.IO.File]::ReadAllText('$(_AppVersionIssPath)'))</_CurrentIssText>
      <_NeedsSync Condition="'$(_CurrentIssText)' == '' or !$(_CurrentIssText.Contains('$(_ExpectedIssLine)'))">true</_NeedsSync>
    </PropertyGroup>

    <ItemGroup Condition="'$(_NeedsSync)' == 'true' and '$(SkipVersionSync)' != 'true'">
      <_IssLines Include="; Auto-generated by MSBuild from Directory.Build.props - DO NOT EDIT MANUALLY" />
      <_IssLines Include="#define AppVersion &quot;$(ProductVersion)&quot;" />
    </ItemGroup>

    <WriteLinesToFile File="$(_AppVersionIssPath)"
                      Lines="@(_IssLines)"
                      Overwrite="true"
                      Encoding="UTF-8"
                      Condition="'$(_NeedsSync)' == 'true' and '$(SkipVersionSync)' != 'true'" />
  </Target>

  <!--
    ValidateVersionPolicy:
    Build-time validation that halts the build if installer definitions or passed build arguments
    disagree with the authoritative ProductVersion in Directory.Build.props.
  -->
  <Target Name="ValidateVersionPolicy"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'AxePower' or '$(MSBuildProjectName)' == 'AxePower.App'">
    <PropertyGroup>
      <!-- Effective installer version from CLI property override, or read from AppVersion.iss -->
      <_EffectiveInstallerVersion Condition="'$(InstallerVersion)' != ''">$(InstallerVersion)</_EffectiveInstallerVersion>
      <_EffectiveInstallerVersion Condition="'$(InstallerVersion)' == '' and Exists('$(_AppVersionIssPath)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_AppVersionIssPath)')), '#define\s+AppVersion\s+"([^"]+)"').Groups[1].Value)</_EffectiveInstallerVersion>

      <!-- Check for hardcoded conflicting definitions in AxePower.iss -->
      <_AxePowerIssText Condition="Exists('$(_AxePowerIssPath)')">$([System.IO.File]::ReadAllText('$(_AxePowerIssPath)'))</_AxePowerIssText>
      <_AxePowerIssHardcodedVersion Condition="'$(_AxePowerIssText)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_AxePowerIssText), '^\s*#define\s+AppVersion\s+"([^"]+)"', System.Text.RegularExpressions.RegexOptions.Multiline).Groups[1].Value)</_AxePowerIssHardcodedVersion>

      <!-- Check for hardcoded conflicting definitions in AxePowerSetup.iss -->
      <_AxePowerSetupIssText Condition="Exists('$(_AxePowerSetupIssPath)')">$([System.IO.File]::ReadAllText('$(_AxePowerSetupIssPath)'))</_AxePowerSetupIssText>
      <_AxePowerSetupIssHardcodedVersion Condition="'$(_AxePowerSetupIssText)' != '' and !$(_AxePowerSetupIssText.Contains('AppVersion={#AppVersion}'))">$([System.Text.RegularExpressions.Regex]::Match($(_AxePowerSetupIssText), '^\s*AppVersion=([^\r\n]+)', System.Text.RegularExpressions.RegexOptions.Multiline).Groups[1].Value)</_AxePowerSetupIssHardcodedVersion>
    </PropertyGroup>

    <Error Condition="'$(_EffectiveInstallerVersion)' != '' and '$(_EffectiveInstallerVersion)' != '$(ProductVersion)'"
           Text="Version mismatch detected! Directory.Build.props specifies ProductVersion '$(ProductVersion)', but Installer version is '$(_EffectiveInstallerVersion)'." />

    <Error Condition="'$(_AxePowerIssHardcodedVersion)' != '' and '$(_AxePowerIssHardcodedVersion)' != '$(ProductVersion)'"
           Text="Version mismatch detected! AxePower.iss specifies hardcoded AppVersion '$(_AxePowerIssHardcodedVersion)', but Directory.Build.props specifies ProductVersion '$(ProductVersion)'." />

    <Error Condition="'$(_AxePowerSetupIssHardcodedVersion)' != '' and '$(_AxePowerSetupIssHardcodedVersion)' != '$(ProductVersion)'"
           Text="Version mismatch detected! AxePowerSetup.iss specifies hardcoded AppVersion '$(_AxePowerSetupIssHardcodedVersion)', but Directory.Build.props specifies ProductVersion '$(ProductVersion)'." />
  </Target>

  <!--
    SetSourceRevisionId:
    Records the commit a build was made from. The SDK appends it to InformationalVersion
    ("2.1.0+0123abcd4567"), which Trust & Permissions shows as the build commit. A build outside a
    git checkout (or without git) simply has no commit. CI may pass SourceRevisionId itself.
  -->
  <Target Name="SetSourceRevisionId" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;InitializeSourceControlInformation"
          Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short=12 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AxePowerGitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_AxePowerGitExit" />
    </Exec>
    <PropertyGroup Condition="'$(_AxePowerGitExit)' == '0' and '$(_AxePowerGitCommit)' != ''">
      <SourceRevisionId>$(_AxePowerGitCommit)</SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>
