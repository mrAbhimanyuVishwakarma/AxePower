  .help-search-input {
    font-size: 16px !important;
    padding: 13px 16px 13px 44px;
  }

  .help-search-icon {
    left: 16px;
  }

  .help-nav-pills {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 8px;
    justify-content: flex-start;
    padding: 12px 4px 6px;
    width: 100%;
  }

  .help-nav-pills::-webkit-scrollbar {
    display: none;
  }

  .help-pill {
    flex-shrink: 0;
    padding: 7px 13px;
    font-size: 12.5px;
  }

  .guide-header-card {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  /* Responsive Tables */
  .table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 12px 0;
    border-radius: var(--radius-sm);
  }

  .bindings-table {
    min-width: 280px;
    font-size: 12.5px;
  }

  .bindings-table th,
  .bindings-table td {
    padding: 8px 10px;
  }

  /* Footer */
  .site-footer {
    padding-top: 40px;
    padding-bottom: 30px;
  }

  .footer-container {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .footer-links {
    justify-content: center;
    gap: 16px;
  }

  .footer-link {
    font-size: 13.5px;
  }

  /* Modals */
  .legal-modal-backdrop {
    padding: 12px;
  }

  .legal-modal-card {
    max-height: 92vh;
    border-radius: var(--radius-lg);
    width: 100%;
  }

  .legal-modal-header {
    padding: 16px 18px;
  }

  .legal-modal-body {
    padding: 16px 18px;
    font-size: 13.5px;
  }

  .legal-modal-footer {
    padding: 12px 18px;
  }

  .contact-channel-card {
    padding: 12px 16px;
    gap: 12px;
  }
}

/* Small Smartphone Viewports (<= 480px) */
@media (max-width: 480px) {
  .container {
    padding-left: 16px;
    padding-right: 16px;
  }

  .brand-name {
    font-size: 18px;
  }

  .btn-donate {
    padding: 6px 12px;
    font-size: 13px;
    gap: 6px;
  }

  .theme-toggle-btn {
    width: 34px;
    height: 34px;
  }

  .mobile-toggle {
    width: 34px;
    height: 34px;
  }

  .btn-lg {
    padding: 12px 20px;
    font-size: 15px;
  }

  .btn-xl {
    padding: 14px 24px;
    font-size: 16px;
  }

  .sub-badge {
    font-size: 11px;
    padding: 3px 10px;
  }

  .job-card {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .job-card .btn {
    width: 100%;
  }

  .upi-box {
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    text-align: center;
  }

  .upi-code {
    font-size: 12px;
  }

  .copy-btn {
    width: 100%;
    padding: 8px 12px;
  }
}

/* ==========================================================================
   LEGAL / CONTACT MODAL DIALOGS
   ========================================================================== */
.legal-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: var(--modal-backdrop);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: fadeInModal var(--transition-fast) ease-out forwards;
}

.legal-modal-backdrop[hidden] {
  display: none !important;
}

.legal-modal-card {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-lg);
  max-width: 620px;
  width: 100%;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  box-shadow: var(--device-shadow);
  animation: slideUpModal var(--transition-base) cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeInModal {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUpModal {
  from { opacity: 0; transform: translateY(20px) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.legal-modal-header {
  padding: 22px 24px;
  border-bottom: 1px solid var(--border-divider);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.modal-subtitle {
  font-size: 12px;
  font-family: var(--font-mono);
  color: var(--accent-cyan);
}

.legal-modal-footer {
  padding: 16px 24px;
  border-top: 1px solid var(--border-divider);
  display: flex;
  justify-content: flex-end;
  background: var(--bg-elevated);
  border-bottom-left-radius: var(--radius-lg);
  border-bottom-right-radius: var(--radius-lg);
}

.credits-box {
  background: var(--bg-elevated);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 14px 18px;
  margin: 12px 0 16px;
}

.credits-box ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 8px;
}

.credits-box li {
  font-size: 13px;
  color: var(--text-secondary);
}

.credits-box strong {
  color: var(--text-primary);
}

.modal-close-btn {
  font-size: 26px;
  line-height: 1;
  color: var(--text-muted);
  padding: 4px;
  border-radius: 6px;
  transition: all var(--transition-fast);
}

.modal-close-btn:hover {
  color: var(--text-primary);
  background: var(--bg-elevated);
}

.legal-modal-body {
  padding: 24px;
  overflow-y: auto;
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.65;
}

.legal-modal-body h4 {
  font-size: 15px;
  color: var(--text-primary);
  margin-top: 16px;
  margin-bottom: 6px;
}

.legal-modal-body h4:first-of-type {
  margin-top: 0;
}

.legal-modal-body p {
  margin-bottom: 12px;
}

.legal-modal-body code {
  font-family: var(--font-mono);
  font-size: 12.5px;
  background: var(--bg-elevated);
  padding: 2px 6px;
  border-radius: 4px;
  color: var(--accent-cyan);
}

/* Contact Modal */
.contact-channel-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 16px;
}

.contact-channel-card {
  display: flex;
  align-items: center;
  gap: 16px;
  background: var(--bg-elevated);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-md);
  padding: 16px 20px;
  transition: all var(--transition-fast);
}

.contact-channel-card:hover {
  border-color: var(--border-hover);
  transform: translateX(4px);
}

.contact-icon {
  font-size: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.contact-meta strong {
  font-size: 14.5px;
  color: var(--text-primary);
}

.contact-meta span {
  font-size: 12.5px;
  color: var(--text-muted);
}

.discord-card {
  border-left: 3px solid #5865f2;
}

/* Accessibility: Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ─── Cookie consent banner (consent.js) ─────────────────────────────── */
.consent-banner {
  position: fixed;
  left: 50%;
  bottom: 20px;
  transform: translateX(-50%);
  width: min(720px, calc(100% - 32px));
  z-index: 2000;
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 16px 20px;
  background: var(--bg-elevated);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-md);
  box-shadow: 0 18px 50px -12px rgba(0, 0, 0, 0.55);
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 1.55;
}
.consent-banner[hidden] { display: none; }
.consent-text { margin: 0; flex: 1; }
.consent-text a { color: var(--accent-cyan); text-decoration: underline; }
.consent-actions { display: flex; gap: 10px; flex-shrink: 0; }
.consent-btn { padding: 9px 20px; font-size: 14px; }
@media (max-width: 600px) {
  .consent-banner { flex-direction: column; align-items: stretch; bottom: 12px; }
  .consent-actions .consent-btn { flex: 1; }
}

/* ========================================================================== 
   2026 VISUAL SYSTEM — CINEMATIC WINDOWS CONTROL CENTER
   Shared across every AppWebsite surface. Inspired by the supplied design.md:
   immersive dark entry points, clean functional surfaces, blue action energy,
   and decisive diagonal compositions.
   ========================================================================== */
:root, [data-theme="dark"] {
  --bg-black: #101318;
  --bg-main: #171b22;
  --bg-card: #222730;
  --bg-card-hover: #292f3a;
  --bg-elevated: #2d3440;
  --bg-subtle: #1c2028;
  --header-bg: rgba(16, 19, 24, .82);
  --body-gradient: linear-gradient(180deg, #101318 0%, #171b22 42%, #f3f5f7 42%, #f3f5f7 100%);
  --accent-cyan: #60a5fa;
  --accent-blue: #4a90e2;
  --border-subtle: rgba(255, 255, 255, .1);
  --border-card: rgba(255, 255, 255, .14);
  --border-hover: rgba(96, 165, 250, .6);
  --text-primary: #f8fafc;
  --text-secondary: #b7bec8;
  --text-muted: #8a9199;
  --container-max: 1280px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-xl: 18px;
}

[data-theme="light"] {
  --bg-black: #fff;
  --bg-main: #f3f5f7;
  --bg-card: #fff;
  --bg-card-hover: #e9edf2;
  --bg-elevated: #eef1f5;
  --bg-subtle: #e4e8ed;
  --header-bg: rgba(255, 255, 255, .88);
  --body-gradient: linear-gradient(180deg, #eef2f7 0%, #fff 100%);
  --accent-cyan: #3a7bc8;
  --accent-blue: #2869b5;
  --text-primary: #171b22;
  --text-secondary: #4e5866;
  --text-muted: #6f7884;
}

body { background: var(--body-gradient); }
.site-header { box-shadow: 0 1px 0 rgba(0,0,0,.18); }
.header-container { height: 64px; }
.brand-name { letter-spacing: -.045em; }
.nav-links { gap: clamp(12px, 1.6vw, 26px); }
.nav-link { font-size: 13px; letter-spacing: .01em; }
.nav-link.active::after { background: var(--accent-blue); }
.btn, .btn-donate { border-radius: 5px; }
.btn-primary {
  background: #4a90e2;
  border-color: rgba(255,255,255,.22);
  box-shadow: 0 8px 28px rgba(74,144,226,.28);
}
.btn-primary:hover { background: #3a7bc8; box-shadow: 0 12px 34px rgba(74,144,226,.38); }
.btn-donate { background: #4a90e2; box-shadow: none; }
.theme-toggle-btn { border-radius: 5px; }

.hero-section {
  min-height: calc(100vh - 64px);
  padding: clamp(84px, 10vw, 148px) 0 0;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 76% 28%, rgba(74,144,226,.25), transparent 29%),
    radial-gradient(circle at 12% 82%, rgba(139,92,246,.15), transparent 28%),
    linear-gradient(145deg, #101318 0%, #171c25 55%, #0d1015 100%);
}
.hero-section::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .24;
  background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
  background-size: 64px 64px;
  mask-image: linear-gradient(to bottom, black, transparent 72%);
}
.hero-container { position: relative; z-index: 1; }
.hero-badge { border-radius: 4px; background: rgba(255,255,255,.06); backdrop-filter: blur(10px); }
.hero-title { max-width: 970px; margin-inline: auto; font-size: clamp(3rem, 6.8vw, 6.4rem); line-height: .98; letter-spacing: -.065em; }
.hero-title span { color: #75adf0; }
.hero-subtitle { max-width: 720px; font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.7; color: #c8ced7; }
.hero-buttons { margin-top: 30px; }
.hero-specs-tag { color: #8e98a6; }
.hero-visual-wrapper { margin-top: clamp(54px, 7vw, 94px); perspective: 1200px; }
.hero-device-frame { border-radius: 12px 12px 0 0; transform: rotateX(1.5deg); border: 1px solid rgba(255,255,255,.14); box-shadow: 0 40px 90px rgba(0,0,0,.55), 0 0 90px rgba(74,144,226,.12); }

.section { padding-block: clamp(80px, 9vw, 130px); }
.section:not(.section-download) { background: #f3f5f7; color: #171b22; }
.section:not(.section-download) .section-title,
.section:not(.section-download) h2,
.section:not(.section-download) h3 { color: #171b22; }
.section:not(.section-download) p { color: #596371; }
.section-header { max-width: 760px; margin-inline: auto; }
.section-title { font-size: clamp(2.2rem, 4.2vw, 4rem); line-height: 1.05; letter-spacing: -.05em; }
.section-description { font-size: 1.08rem; }
.sub-badge { border-radius: 3px; background: rgba(74,144,226,.1); color: #2869b5; border-color: rgba(74,144,226,.25); }

.feature-card, .tool-card, .info-card, .faq-item, .support-card, .legal-content-card, .job-card, .store-card, .donation-card {
  border-radius: 8px;
  box-shadow: 0 14px 36px rgba(26,31,38,.08);
}
.feature-card, .tool-card { background: #fff; border: 1px solid #e0e5eb; }
.feature-card:hover, .tool-card:hover { transform: translateY(-5px); border-color: rgba(74,144,226,.48); box-shadow: 0 22px 48px rgba(26,31,38,.13); }

.section-download {
  position: relative;
  overflow: hidden;
  background: linear-gradient(115deg, #6d4bd3 0%, #4a90e2 72%, #65b8e8 100%);
}
.section-download::before { content: ""; position: absolute; inset: 0; background: linear-gradient(115deg, rgba(16,19,24,.42), transparent 55%); }
.download-card { position: relative; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.download-heading, .download-desc, .download-meta-info { color: #fff !important; }
.section-download .btn-primary { background: #fff; color: #1e5b9f; border-color: #fff; }
.section-download .btn-secondary { background: rgba(17,24,39,.22); color: #fff; border-color: rgba(255,255,255,.4); }

.site-footer { background: #171b22; border-top: 0; }
.footer-container { padding-block: 64px 42px; }
.footer-bottom { border-color: rgba(255,255,255,.09); }

:focus-visible { outline: 3px solid #75adf0; outline-offset: 3px; }

@media (max-width: 768px) {
  html, body { overflow-x: clip; }
  .hero-section { padding-top: 72px; min-height: auto; }
  .hero-container { min-width: 0; }
  .hero-title { font-size: clamp(2.65rem, 12.5vw, 4.5rem); overflow-wrap: anywhere; }
  .hero-title span { display: block; }
  .hero-subtitle { font-size: 1rem; }
  .hero-buttons { width: 100%; max-width: 100%; }
  .hero-buttons .btn { width: 100%; max-width: 100%; white-space: normal; }
  .hero-badge { max-width: 100%; text-align: left; }
  .hero-device-frame { transform: none; }
  .section { padding-block: 72px; }
  .section-title { font-size: 2.35rem; }
  .nav-links.mobile-active { background: #171b22; border-bottom: 1px solid rgba(255,255,255,.1); }
  [data-theme="light"] .nav-links.mobile-active { background: #fff; border-color: rgba(0,0,0,.1); }
}

@media (max-width: 480px) {
  .container { padding-inline: 18px; }
  .header-container { gap: 10px; }
  .nav-actions { gap: 8px; }
  .btn-donate { width: 38px; height: 38px; padding: 0; justify-content: center; }
  .btn-donate span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .hero-badge { font-size: 10px; padding-inline: 9px; }
  .hero-title { font-size: clamp(2.5rem, 12.7vw, 3.75rem); letter-spacing: -.07em; }
  .consent-actions { min-width: 0; }
  .consent-actions .consent-btn { min-width: 0; padding-inline: 12px; }
}
