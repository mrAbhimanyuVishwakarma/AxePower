<Project>
  <PropertyGroup>
    <!-- Authoritative product version across all .NET projects and installer scripts -->
    <ProductVersion>2.1.3</ProductVersion>
    <Version>$(ProductVersion)</Version>
    <AssemblyVersion>$(ProductVersion).0</AssemblyVersion>
    <FileVersion>$(ProductVersion).0</FileVersion>
    <InformationalVersion>$(ProductVersion)</InformationalVersion>

    <!-- Shared product metadata -->
    <Authors>Abhimanyu Vishwakarma</Authors>
    <Company>AxePower</Company>
    <Product>AxePower</Product>
    <Copyright>Copyright © 2026 Abhimanyu Vishwakarma</Copyright>

    <!-- Language, runtime, and build determinism -->
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <!-- Code analysis policy (staged in Prompt 7) -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- Warnings as errors in CI to prevent regression -->
    <TreatWarningsAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true' or '$(CI)' == 'true'">true</TreatWarningsAsErrors>

    <!-- Deterministic dependency locking policy -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true' or '$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
